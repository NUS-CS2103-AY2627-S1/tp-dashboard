08ab1e4","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into update-Aboutus-page","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"38bed92d8078532957d6cc23f172256b33448150","isMergeCommit":true,"messageTitle":"Merge pull request #27 from nsriram18/update-Aboutus-page","messageBody":"Update AboutUs.md (Sriram)","fileTypesAndContributionMap":{}},{"hash":"17d18ffe839986472b22f96d9d9b37c2af76b2c2","isMergeCommit":true,"messageTitle":"Merge pull request #20 from RightHandSide/update-user-guide","messageBody":"Update User Guide for TutorTrack","fileTypesAndContributionMap":{}},{"hash":"51b789a0ace23548f051e0740db5df55113040a0","isMergeCommit":true,"messageTitle":"Merge pull request #21 from RightHandSide/update-developer-guide","messageBody":"Add TutorTrack product requirements","fileTypesAndContributionMap":{}},{"hash":"2e0eb662933d00a7653bcc1a68ab58fad1848ba7","isMergeCommit":true,"messageTitle":"Merge pull request #19 from RightHandSide/update-readme","messageBody":"Update README for TutorTrack","fileTypesAndContributionMap":{}}]},{"date":"2026-10-03T00:00:00","commitResults":[{"hash":"d64f3aed562d06bb6808b4b78c19347bdebc2069","isMergeCommit":false,"messageTitle":"Update TutorTrack project requirements","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":113,"deletions":37}}},{"hash":"ef609d764106c477b2f615d472adfde9712f1608","isMergeCommit":true,"messageTitle":"Merge pull request #31 from nsriram18/branch-DG-update","messageBody":"Update TutorTrack project requirements","fileTypesAndContributionMap":{}}]},{"date":"2026-10-09T00:00:00","commitResults":[{"hash":"7a5635408132d869038f6d994d3fb3ac42155464","isMergeCommit":false,"messageTitle":"Add student notes command","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":188,"deletions":7},"docs":{"insertions":12,"deletions":0},"test-code":{"insertions":208,"deletions":2}}}]},{"date":"2026-10-14T00:00:00","commitResults":[{"hash":"a7e1e8e6ad8a687c87e937e9f6920fa93e73c79a","isMergeCommit":false,"messageTitle":"Reject duplicate note prefixes and verify note persistence","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":0},"docs":{"insertions":3,"deletions":0},"test-code":{"insertions":36,"deletions":0}}}]},{"date":"2026-10-21T00:00:00","commitResults":[{"hash":"ac7c5fd9f6ce174ff2ad401c8b8916e99a71ac1f","isMergeCommit":true,"messageTitle":"Merge pull request #62 from RightHandSide/feature/lesson-duration","messageBody":"Add lesson duration support","fileTypesAndContributionMap":{}}]},{"date":"2026-10-22T00:00:00","commitResults":[{"hash":"885caaee2df43fe1470c850494061b1123941fa6","isMergeCommit":false,"messageTitle":"Detect clashes between students\u0027 next lessons","messageBody":"Next lessons can overlap without warning, allowing the tutor to book\nconflicting sessions across different student records.\n\nReject overlapping next lessons before changing the model. Compare each\nlesson\u0027s actual duration across all students, including filtered-out\nrecords, while allowing adjacent lessons and replacing a student\u0027s own\nlesson. Handle intervals that cross midnight and identify the conflicting\nstudent in the error message.\n\nAdd logging, regression tests, and User Guide examples. Correct existing\nCheckstyle violations so the style checks pass.\n\nFocused tests and the documentation build pass. The full suite passes\n399 of 400 tests; the existing JavaFX image-loading test fails locally.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":68,"deletions":1},"docs":{"insertions":13,"deletions":6},"test-code":{"insertions":146,"deletions":24}}},{"hash":"07b16f6ac5bf7954de2158a720d54f7035e99ad9","isMergeCommit":false,"messageTitle":"Detect clashes involving recurring lessons","messageBody":"Recurring schedules can overlap next lessons and other weekly schedules\nwithout warning, allowing conflicting bookings in the tutor\u0027s timetable.\n\nCheck both scheduling commands against all student records before saving.\nUse actual lesson durations and handle midnight and week boundaries while\nallowing adjacent lessons. Treat a student\u0027s next lesson at the exact\nweekday and start time of their own recurring rule as the same occurrence.\nExclude the old schedule when replacing a recurring lesson.\n\nIdentify the conflicting student and schedule in rejection messages. Add\nlogging, regression tests, and User Guide documentation for these rules.\n\nScheduling tests, Checkstyle, and the documentation build pass. The full\nsuite passes 412 of 413 tests; the existing JavaFX image test fails locally.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":126,"deletions":1},"docs":{"insertions":6,"deletions":2},"test-code":{"insertions":228,"deletions":0}}}]},{"date":"2026-10-23T00:00:00","commitResults":[{"hash":"f57e7739335effa9f8164668f0f564509612d89f","isMergeCommit":false,"messageTitle":"Document timetable-clash detection flow","messageBody":"The Developer Guide lacks a diagram showing how both scheduling commands\nvalidate input and reject conflicts before updating student records.\n\nAdd an activity diagram covering parse and index errors, next-lesson and\nrecurring-schedule comparisons, conflict rejection, and model updates.\nExplain replacement exclusions and the same-student occurrence exception.\nReuse the shared PlantUML style and reference the diagram from the guide.\n\nBuild all documentation pages and inspect the generated diagram to verify\nthat it renders correctly and reflects the implemented command flow.\n","fileTypesAndContributionMap":{"docs":{"insertions":76,"deletions":0}}}]}]},"authorFileTypeContributionMap":{"RightHandSide":{"docs":337,"functional-code":953,"test-code":896},"weijun72":{"docs":149,"functional-code":493,"test-code":608,"other":8},"spadewiz":{"docs":44,"functional-code":565,"test-code":707,"other":1},"nsriram18":{"docs":212,"functional-code":368,"test-code":604}},"authorContributionVariance":{"RightHandSide":55510.133,"weijun72":11522.506,"spadewiz":13062.355,"nsriram18":15010.8955},"authorDisplayNameMap":{"RightHandSide":"CS2103T-F14a-3 LEE ..HENG","weijun72":"CS2103T-F14a-3 TOH .. JUN","spadewiz":"CS2103T-F14a-3 PANN..CKAM","nsriram18":"CS2103T-F14a-3 NARA..IRAM"}}
