AndContributionMap":{"test-code":{"insertions":196,"deletions":0}}},{"hash":"b8c847b4035be7ad208d5d8495e4443569dbfd04","isMergeCommit":false,"messageTitle":"Fix JavaFX tests on headless Ubuntu CI","messageBody":"","fileTypesAndContributionMap":{"other":{"insertions":5,"deletions":0},"test-code":{"insertions":19,"deletions":7}}},{"hash":"bcf706c96a47066ae2c07fb82d9846bffe61c8fb","isMergeCommit":false,"messageTitle":"Fix platform-dependent JavaFX test shutdown","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":2,"deletions":11}}}]},{"date":"2026-10-17T00:00:00","commitResults":[{"hash":"9565a9b798a3696e66df7bcf4955f7863e932a02","isMergeCommit":false,"messageTitle":"Implement ride editing by ID","messageBody":"Allow organisers to update existing ride details while preserving\nthe ride ID, cyclist roster, and unspecified fields.\n\nSupport clearing optional notes using an empty notes/ value while\npreserving existing notes when the field is omitted.\n\nValidate all supplied fields and the resulting ride period before\nreplacement so invalid edits leave existing data unchanged.\n\nReuse the existing model and storage mechanisms to persist edits\nand update the rides panel.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":425,"deletions":1},"test-code":{"insertions":5,"deletions":0}}},{"hash":"7c89c00b228b213c30dddd17055a9354352249d3","isMergeCommit":false,"messageTitle":"Add ride edit regression tests","messageBody":"Cover individual and combined ride field updates, notes clearing,\ndate validation, and preservation of unspecified fields.\n\nVerify parser behaviour, model replacement invariants, and JSON\npersistence to prevent regressions in ride editing.\n\nEnsure failed edits leave existing rides and cyclist data unchanged.\n","fileTypesAndContributionMap":{"test-code":{"insertions":629,"deletions":1}}}]},{"date":"2026-10-18T00:00:00","commitResults":[{"hash":"d8b7c5e75256c691d1e9c2137cfc1d5ef14dc2f7","isMergeCommit":false,"messageTitle":"Document ride editing","messageBody":"Add Ride Edit to the Help dropdown and Help window so organisers\ncan discover its syntax and use valid command examples.\n\nDocument field preservation, date validation and notes clearing\nin the User Guide and Developer Guide.\n\nAdd focused regression tests to protect the Help entries.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":20,"deletions":0},"docs":{"insertions":92,"deletions":3},"test-code":{"insertions":66,"deletions":5}}},{"hash":"51436ded7cf4950b04a9be93f668cb1bd12b362f","isMergeCommit":false,"messageTitle":"Implement ride deletion by ID","messageBody":"Allow organisers to delete a group ride using its persistent ID\nwithout affecting cyclists, other rides or their rosters.\n\nPreserve the next ride ID counter so deleted IDs are never reused.\n\nIntegrate ride deletion with existing command parsing, persistence\nand observable ride updates.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":125,"deletions":1},"test-code":{"insertions":5,"deletions":0}}},{"hash":"1e6ea5c6686e30721166250d81acd985926c4bfa","isMergeCommit":false,"messageTitle":"Add ride deletion regression tests","messageBody":"Cover ride deletion by persistent ID across command parsing, model\nupdates, observable-list notifications and JSON persistence.\n\nVerify that invalid deletions preserve ride and cyclist data, and\nthat deleted ride IDs are not reused.\n\nEnsure ride deletion safely cancels pending cyclist deletion.\n","fileTypesAndContributionMap":{"test-code":{"insertions":97,"deletions":0}}},{"hash":"99f63720c26c729ce73e0f2f550d041d54e18c31","isMergeCommit":false,"messageTitle":"Document ride deletion","messageBody":"Add Ride Delete to the Help dropdown and Help window so organisers\ncan discover the command and its expected behaviour.\n\nDocument persistent ride IDs, roster removal and cyclist preservation\nin the User Guide and Developer Guide.\n\nExplain how deletion preserves remaining ride IDs and saved data.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":11,"deletions":0},"docs":{"insertions":51,"deletions":4},"test-code":{"insertions":39,"deletions":7}}},{"hash":"0ebc383eb455473a5cf25a48bb2c73310acfeef6","isMergeCommit":true,"messageTitle":"Merge remote-tracking branch \u0027origin/master\u0027 into 90-ride-editing","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"04427aa4b7cfc9dd7e0e8ac73f8a1e113b383c24","isMergeCommit":true,"messageTitle":"Merge remote-tracking branch \u0027origin/master\u0027 into 92-ride-deletion","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"0cb34403f580bb916c048d421f954e54b663d91c","isMergeCommit":false,"messageTitle":"Restore ride delete command tests","messageBody":"Add direct coverage for successful and rejected ride deletions.\n\nProtect persistent ID lookup and preservation of other rides,\nrosters, cyclists and future ID allocation against regressions.\n","fileTypesAndContributionMap":{"test-code":{"insertions":85,"deletions":0}}},{"hash":"cc545be3e39a30dcf7210842eb43dd281e900dda","isMergeCommit":false,"messageTitle":"Validate ride edits against rosters","messageBody":"Reject minimum FTP and maximum group size edits that violate\nexisting roster membership constraints.\n\nValidate the proposed ride before replacement so rejected edits\nleave existing data unchanged.\n\nExplain the new restrictions in Ride Edit help and documentation.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":35,"deletions":1},"docs":{"insertions":21,"deletions":4},"test-code":{"insertions":4,"deletions":0}}},{"hash":"6a725f97ba132ed76493f1eda01ff7415fc49d9d","isMergeCommit":false,"messageTitle":"Refine ride edit roster tests","messageBody":"Cover roster eligibility boundaries, validation precedence and\natomic rejection of invalid ride edits.\n\nConsolidate repeated field and period tests while preserving\nexisting regression coverage.\n","fileTypesAndContributionMap":{"test-code":{"inse