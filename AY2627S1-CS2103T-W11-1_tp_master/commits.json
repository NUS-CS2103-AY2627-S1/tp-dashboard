,{"hash":"b184b48d99d93d127915d8c17aeff2cb0c95eb2d","isMergeCommit":false,"messageTitle":"Clarify v1.3 release notes after review","messageBody":"The release notes leave required fields, matching rules and saved-file\ncompatibility unclear, and their filename does not identify the version.\n\nMove the notes into a versioned release-notes folder and clarify add\nrequirements, search logic, phone formatting and storage defaults.\nUpdate screenshot links so they resolve from the new location.\n","fileTypesAndContributionMap":{"docs":{"insertions":26,"deletions":18}}}]},{"date":"2026-10-14T00:00:00","commitResults":[{"hash":"e1b87c3777958ea5edd634ec8a2ff6860c54b746","isMergeCommit":false,"messageTitle":"Refresh Cyclique screenshots and diagrams","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":34,"deletions":17}}},{"hash":"d763929e82d60c53da93a168ee721747192b1546","isMergeCommit":false,"messageTitle":"Update MainApp version number","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":1}}},{"hash":"711ee4a075b685fc1d28e666a65375fbb1f962dd","isMergeCommit":false,"messageTitle":"Limit image updates to application screenshots","messageBody":"The image update also changes diagrams, guide text and badges, and removes template assets. These changes exceed the requested screenshot scope.\n\nRestore those files while retaining the three actual UI screenshots. Keep the application version change intact.\n","fileTypesAndContributionMap":{"docs":{"insertions":17,"deletions":34}}},{"hash":"17396d06a4bbdc5e1bbd1eb99932b0c6197344d1","isMergeCommit":false,"messageTitle":"Update build.gradle and jar name","messageBody":"","fileTypesAndContributionMap":{"other":{"insertions":1,"deletions":1},"docs":{"insertions":3,"deletions":3}}}]},{"date":"2026-10-16T00:00:00","commitResults":[{"hash":"69fb9a6901690cd33394f234bf8865168c3ca571","isMergeCommit":true,"messageTitle":"Merge pull request #101 from jaydenleungky/89-rideadd-command","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"280242e96121cac82d9513efb16fd71c6d237ffd","isMergeCommit":true,"messageTitle":"Merge pull request #104 from jaydenleungky/102-ride-ui","messageBody":"Show rides as cards in the rides panel","fileTypesAndContributionMap":{}},{"hash":"aa4e8e0fd0416660c88b09293fa490fdc0d93ace","isMergeCommit":true,"messageTitle":"Merge pull request #105 from jaydenleungky/103-help-dropdown-rideadd","messageBody":"Add rideadd to the Help dropdown and window","fileTypesAndContributionMap":{}},{"hash":"87e24a39a11c3a2b3eaeba8b7138514b2cda58af","isMergeCommit":false,"messageTitle":"Add cyclist management for ride rosters","messageBody":"Group rides store rosters but provide no commands to manage membership.\nOrganisers need to add and remove cyclists while keeping saved rosters\nconsistent with contact records.\n\nAdd rideaddcyclist and ridedeletecyclist with rac and rdc aliases.\nValidate membership, capacity and minimum power before updating a ride.\nDisplay roster numbers and preserve references across phone edits and\nconfirmed contact deletion.\n\nUpdate Help, regression tests and the user and developer guides. Defer\nUML changes to a later increment. Record the outstanding manual UI checks.\n\nCloses AY2627S1-CS2103T-W11-1/tp#93\n","fileTypesAndContributionMap":{"functional-code":{"insertions":163,"deletions":1},"docs":{"insertions":99,"deletions":1},"test-code":{"insertions":220,"deletions":2}}},{"hash":"a1809f8acea0343e272d055478f251181b9f282f","isMergeCommit":false,"messageTitle":"Add roster commands to the Help dropdown","messageBody":"The Help dropdown lacks starter templates for adding and removing\ncyclists from rides.\n\nAdd both roster command formats and their aliases to the dropdown.\nInsert the full command name and a trailing space when selected, so\norganisers can enter the ride ID and phone number directly.\n\nKeep the templates independent of command implementation to allow\nseparate review. Add regression tests and update the guides and manual\ntesting results. Leave UML diagrams for a later increment.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":4,"deletions":1},"docs":{"insertions":54,"deletions":0},"test-code":{"insertions":15,"deletions":2}}}]},{"date":"2026-10-17T00:00:00","commitResults":[{"hash":"8ceae8143074e39405debf965a2d4f3634133fe1","isMergeCommit":false,"messageTitle":"Remove short-form roster aliases","messageBody":"Roster Help labels and guides advertise short-form aliases that the\nparser does not support. The PR reviews defer aliases to a later\niteration to keep the alpha release simple.\n\nRemove the aliases from dropdown labels and documentation, update the\ntemplate assertions, and record the automated and manual UI checks.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":2,"deletions":2},"docs":{"insertions":27,"deletions":7},"test-code":{"insertions":3,"deletions":3}}}]},{"date":"2026-10-18T00:00:00","commitResults":[{"hash":"119b4a40ad535b03b5875e2252319dedeed3521f","isMergeCommit":false,"messageTitle":"Remove short-form roster command aliases","messageBody":"Roster commands support short forms that the PR review defers to a\nlater iteration of the application.\n\nRemove alias parsing and Help references, use full names in the guides\nand tests, and verify rejected aliases preserve data and pending\ndeletion requests.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":7,"deletions":7},"docs":{"insertions":33,"deletions":17},"test-code":{"insertions":49,"deletions":27}}}]}]},"authorFileTypeContributionMap":{"jaydenleungky":{"docs":143,"functional-code":1965,"test-code":2322},"elsxyss":{"docs":935,"functional-code":416,"test-code":1466,"other":6},"Sia-Pathania":{"docs":0,"functional-code":227,"test-code":180},"jixiang-t":{"docs":239,"functional-code":807,"test-code":2151,"other":7},"juinron":{"docs":247,"functional-code":171,"test-code":244,"other":1}},"authorContributionVariance":{"jaydenleungk