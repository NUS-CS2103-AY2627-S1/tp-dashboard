[{"hash":"a5750936ffc5a66b61850c8139bf94814b3caacb","isMergeCommit":false,"messageTitle":"Add applicant ID, interview notes, years of experience and source","messageBody":"Extend Applicant with the details a recruiter needs to assess candidates:\n- ApplicantId: a UUID generated on creation and kept across edits. It is\n  an internal identifier, so it is excluded from equals and hashCode.\n- InterviewNotes (i/), Source (s/): optional free text.\n- YearsOfExperience (y/): optional whole number from 0 to 60.\nSkills reuse the existing tags (t/).\n\nadd and edit accept the new prefixes; an empty value is allowed and\nclears the field on edit. JSON storage reads and writes the new fields,\nand files written before they existed still load. The applicant card and\nsample data show the new fields.\n\nCo-Authored-By: Claude Sonnet 5.5 \u003cnoreply@anthropic.com\u003e\n","fileTypesAndContributionMap":{"functional-code":{"insertions":517,"deletions":42},"test-code":{"insertions":1046,"deletions":16}}},{"hash":"3575d20baa2d839fcf81f44b04d4b4ce4d3642a2","isMergeCommit":false,"messageTitle":"Restyle main window to the comparison layout with tabs","messageBody":"Match the A1 mockup: applicants A and B are shown side by side with\ntheir details, next to a numbered ranking panel. A second tab keeps the\nfull applicant list with index numbers for edit and delete.\n\nA and B are the first two applicants in the displayed list and the\nranking is the list order for now, until the comparison and ranking\nfeatures exist. The window is titled RecruitDex and the tab focus ring\nis removed.\n\nCo-Authored-By: Claude Sonnet 5.5 \u003cnoreply@anthropic.com\u003e\n","fileTypesAndContributionMap":{"functional-code":{"insertions":475,"deletions":7}}},{"hash":"7a7e3c4ea2deaa9921b0411805b080da411917cd","isMergeCommit":false,"messageTitle":"Add tests for the sample data","messageBody":"Check that every sample applicant builds with valid fields, names and ids\nare unique, the sample address book contains them all, and the sample data\nshows the optional fields. A bad sample value, such as a tag with a symbol,\nnow fails a test instead of crashing the app at startup.\n\nCo-Authored-By: Claude Sonnet 5.5 \u003cnoreply@anthropic.com\u003e\n","fileTypesAndContributionMap":{"test-code":{"insertions":97,"deletions":0}}},{"hash":"a6ba8b9a1970772060b180443d2e52f0dbde12d4","isMergeCommit":false,"messageTitle":"Document the new applicant fields in the user guide","messageBody":"Describe the interview notes (i/), years of experience (y/) and source (s/)\noptions of add and edit, how to clear them, and that skills use t/ and\ncontain only letters and numbers.\n\nCo-Authored-By: Claude Sonnet 5.5 \u003cnoreply@anthropic.com\u003e\n","fileTypesAndContributionMap":{"docs":{"insertions":14,"deletions":9}}}]}],"Cha0yue":[{"date":"2026-09-18T00:00:00","commitResults":[{"hash":"0413a0e4e42236437db235079f389734c3af19fa","isMergeCommit":false,"messageTitle":"Rebrand MarkBind docs site for RecruitDex.","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":9,"deletions":8}}},{"hash":"d7c2ed721828de6cc5503e9421f71318f1747373","isMergeCommit":true,"messageTitle":"Merge pull request #1 from AY2627S1-CS2103T-W12-4/switch-docs-to-markbind","messageBody":"Switch docs to markbind","fileTypesAndContributionMap":{}}]},{"date":"2026-10-03T00:00:00","commitResults":[{"hash":"1621518eb1f92d87afc908297c610d30f1b77bac","isMergeCommit":false,"messageTitle":"Update AboutUs page with Cha0yue details","messageBody":"The James Doe profile is still a template entry.\n\nEach member needs their own profile so the AboutUs page can be\nused for course admin.\n\nLet\u0027s replace that entry with Cha0yue\u0027s photo, GitHub link, and\nrole.\n","fileTypesAndContributionMap":{"docs":{"insertions":4,"deletions":5}}},{"hash":"ac18e447162e75ba1d9b99be0f34ca66717dd531","isMergeCommit":true,"messageTitle":"Merge pull request #9 from soy046/branch-Update-AboutUs-Page","messageBody":"Update AboutUs p