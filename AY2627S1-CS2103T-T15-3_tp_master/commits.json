6fa54b00306d56f449b51f","isMergeCommit":false,"messageTitle":"Add predicate for filtering student","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":54,"deletions":0},"test-code":{"insertions":152,"deletions":0}}},{"hash":"8d8e52a3143aec431f4cefef1a5a4abb35736417","isMergeCommit":false,"messageTitle":"Add FilterCommand for filtering students","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":68,"deletions":0},"test-code":{"insertions":302,"deletions":0}}},{"hash":"3a06e96688dee1287c5466259ea67aaad79d8e7b","isMergeCommit":true,"messageTitle":"Merge pull request #62 from tchgf/Add-filter-students-(filter)-with-basic-functionality","messageBody":"Add filter command logic for student","fileTypesAndContributionMap":{}}]},{"date":"2026-10-14T00:00:00","commitResults":[{"hash":"e73c52b78720c71fe68e159bf7de7974f1bbf89a","isMergeCommit":false,"messageTitle":"Add FilterCommandParser for filter command","messageBody":"FilterCommand can only be constructed in code, as there is no parser\nthat turns user input into a StudentMatchesFilterPredicate.\n\nLet\u0027s add FilterCommandParser, which accepts an optional level (l/)\nand any number of subjects (s/), and requires at least one of them.\nA repeated level is rejected, as a student has exactly one level.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":48,"deletions":0}}},{"hash":"a7742382a41433ef34b3ed8ef98d68746d0959d9","isMergeCommit":false,"messageTitle":"Add tests for FilterCommandParser","messageBody":"Cover valid level and subject combinations, case and whitespace\nvariations, and the invalid format, repeated level and invalid value\nerror paths.\n","fileTypesAndContributionMap":{"test-code":{"insertions":136,"deletions":0}}},{"hash":"56621db47b270c878b7de64197aa09f6df24a9c5","isMergeCommit":false,"messageTitle":"Register filter command in AddressBookParser","messageBody":"AddressBookParser does not recognise the filter command word, so users\nget an unknown command error when they try to filter students.\n\nLet\u0027s route the filter command word to FilterCommandParser.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":2,"deletions":0},"test-code":{"insertions":14,"deletions":0}}},{"hash":"a6c5c2331c8cdba37aea121c565528f32e0cbcbd","isMergeCommit":false,"messageTitle":"Add end-to-end test for filter command","messageBody":"The filter command is only tested per component, against a model stub,\nso nothing checks that user input reaches the real student list.\n\nLet\u0027s add a LogicManager test that filters students added through\nadd-s, covering matching, re-filtering and no-match results.\n","fileTypesAndContributionMap":{"test-code":{"insertions":24,"deletions":0}}}]}],"pratixksha":[{"date":"2026-09-18T00:00:00","commitResults":[{"hash":"dd408ad064d367cc7454b4499771b4ad3e265bc8","isMergeCommit":false,"messageTitle":"Update Codecov badge","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":1,"deletions":1}}},{"hash":"3b05cdbf9ea8e5c37e852cbe628602eb387f087e","isMergeCommit":false,"messageTitle":"Configure MarkBind site for TutorTrack","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":1,"deletions":1}}}]},{"date":"2026-09-29T00:00:00","commitResults":[{"hash":"ef8866e6cf540a69b2e3267896880005b74c5918","isMergeCommit":false,"messageTitle":"Update Pratiksha\u0027s links","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":3,"deletions":4}}},{"hash":"efc0e36bd11c4656c44c30455b49507ef6d073b8","isMergeCommit":false,"messageTitle":"Update Pratiksha\u0027s AboutUs details","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":1,"deletions":1}}}]},{"date":"2026-09-30T00:00:00","commitResults":[{"hash":"26ba2b4059382e5905ba7d2a60fb55d43eb21088","isMergeCommit":true,"messageTitle":"Merge pull request #8 from pratixksha/add-pratiksha-photo","messageBody":"Add pratiksha photo","fileTypesAndContributionMap":{}},{"hash":"2b834848d57064