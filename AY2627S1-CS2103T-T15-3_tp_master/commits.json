73823d1a9478d27c726855d2ba","isMergeCommit":false,"messageTitle":"Update acknowledgements","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":1,"deletions":3}}},{"hash":"78c6e8d5126830f3f96417f59ac6603fe932ef0c","isMergeCommit":true,"messageTitle":"Merge pull request #42 from pratixksha/update-readme","messageBody":"Update acknowledgements","fileTypesAndContributionMap":{}}]},{"date":"2026-10-03T00:00:00","commitResults":[{"hash":"2b8c310b943c37ed96b68ec6183bf0d30b51fcf6","isMergeCommit":true,"messageTitle":"Merge pull request #38 from LucasNgui/add-user-stories","messageBody":"Add user stories to DG","fileTypesAndContributionMap":{}},{"hash":"620dd408ae807b42f78889b0bf2f5e4eba31863a","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into add-crud-use-cases","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"661fe4c983cbd679b075294d13ffaaa9151c231c","isMergeCommit":true,"messageTitle":"Merge pull request #40 from LucasNgui/add-crud-use-cases","messageBody":"Add CRUD-related use cases to DG","fileTypesAndContributionMap":{}}]},{"date":"2026-10-06T00:00:00","commitResults":[{"hash":"244aac0206524b54029450b20ecb853a65004f0b","isMergeCommit":false,"messageTitle":"Guardian model: Add identity comparison","messageBody":"TutorTrack needs a domain model for guardians before the add-g command can be implemented. The existing Person model does not define guardian identity.\n\nAdd an immutable Guardian model with validated contact fields and normalized name-plus-phone comparison. Add tests for construction, normalization, duplicate detection, equality, and formatting.\n\nKeep the legacy Person model and add command unchanged so this increment can be merged independently.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":130,"deletions":0},"test-code":{"insertions":109,"deletions":0}}},{"hash":"59a7baa3ac0722b49e87b2979fc99df7fdf24650","isMergeCommit":false,"messageTitle":"GuardianTest: Cover missing branches","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":17,"deletions":2}}},{"hash":"d166217f02c90895e9b71ecd67419272d466cfa7","isMergeCommit":false,"messageTitle":"Student model: Add level and subjects","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":339,"deletions":0},"test-code":{"insertions":291,"deletions":0}}}]},{"date":"2026-10-13T00:00:00","commitResults":[{"hash":"f51a29406c04a90212d1eadf1b85148eb2650a00","isMergeCommit":false,"messageTitle":"Add add-s command","messageBody":"TutorTrack lacks support for creating student records through the command interface.\\n\\nLet\u0027s,\\n* parse and validate student details and subjects\\n* reject malformed and duplicate student entries\\n* persist student records and display them in the UI\\n\\nKeep student-specific validation separate so existing person commands remain unchanged.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":715,"deletions":11},"test-code":{"insertions":203,"deletions":0}}},{"hash":"8bab88e94d922e346a6f65c5f505b8dcabc4e887","isMergeCommit":false,"messageTitle":"Fix Checkstyle violations","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":114,"deletions":21},"test-code":{"insertions":2,"deletions":3}}},{"hash":"7dd41b9abdbf8e45964ae235b843fb4cef479f6b","isMergeCommit":false,"messageTitle":"Add tests for student features","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":292,"deletions":0}}},{"hash":"0932ffd9276300c242cf2ff5f1132340ee8230bb","isMergeCommit":false,"messageTitle":"Document add-s and add-g commands","messageBody":"Users need command-specific guidance to add student and guardian\nrecords.\n\nLet\u0027s,\n* document required fields and supported prefixes\n* explain validation and duplicate-entry behaviour\n* add valid and invalid examples with expected errors\n* update the command summary\n","fileTypesAndContributionMap":{"docs":{"insertions":110,"deletions":0}}},{"hash":"7ea50ba0f748826d0337218e087f8a9ef82a4e58","isMergeCommit":false,"messageTitle":"Refine add student and guardian use cases","messageBody":"The add student and add guardian use cases do not accurately describe\ntheir main flows and error handling.\n\nLet\u0027s,\n* keep the use cases independent of UI details\n* correct the MSS and extension numbering\n* document invalid input and duplicate-record flows\n* clarify that guardian linking is handled separately\n","fileTypesAndContributionMap":{"docs":{"insertions":28,"deletions":19}}},{"hash":"83887ab711da9f4318665a91f8815cdbdc86af8c","isMergeCommit":false,"messageTitle":"Add add-g command","messageBody":"TutorTrack cannot create guardian records through the command\ninterface. Guardians must be stored before they can be linked to\nstudents.\n\nLet\u0027s,\n* parse and validate guardian details\n* reject duplicate guardian entries\n* store and display newly added guardians\n* add tests for command, parsing, validation, and storage\n","fileTypesAndContributionMap":{"functional-code":{"insertions":551,"deletions":10},"test-code":{"insertions":419,"deletions":0}}},{"hash":"bc9d08c2a0b89d8721e80c6dd61fbcc213bea07e","isMergeCommit":false,"messageTitle":"Improve student and guardian list layout","messageBody":"Students and guardians are difficult to compare when their lists are\nstacked vertically. Student cards also omit a label for their subjects.\n\nLet\u0027s,\n* display student and guardian lists side by side\n* add section labels and a resizable divider\n* prefix displayed subjects with `Subjects:`\n\nThis keeps the existing AB3 theme while making the two record types\neasier to distinguish.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":14,"deletions":3}}},{"hash":"398a2efe056132043180fbe369f5a70785427c34","isMergeCommit":true,"messageTitle":"Merge pull request #73 from Amritaa66/edit-student","messageBody":"Update edit student (edit-s) with full implementation","fileTypesAndContributionMap":{}}]},{"da