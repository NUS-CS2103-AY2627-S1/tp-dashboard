[{"path":"README.md","fileType":"docs","lines":[{"lineNumber":1,"author":{"gitId":"Cywez"},"content":"# Byline","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":2,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-09-17T16:33:05","isFullCredit":false},{"lineNumber":3,"author":{"gitId":"Cywez"},"content":"**Byline** is a desktop contact manager for journalists. It helps journalists identify relevant contacts and keep track of interviewees for their reporting work.","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":4,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-09-17T16:33:05","isFullCredit":false},{"lineNumber":5,"author":{"gitId":"RyanNZZ2205"},"content":"[![CI Status](https://github.com/AY2627S1-CS2103-F13-1/tp/workflows/Java%20CI/badge.svg)](https://github.com/AY2627S1-CS2103-F13-1/tp/actions)","lastModifiedDate":"2026-10-01T23:51:51","isFullCredit":false},{"lineNumber":6,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2020-05-23T01:10:16","isFullCredit":false},{"lineNumber":7,"author":{"gitId":"-"},"content":"![Ui](docs/images/Ui.png)","lastModifiedDate":"2020-05-23T01:10:16","isFullCredit":false},{"lineNumber":8,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2020-05-23T01:10:16","isFullCredit":false},{"lineNumber":9,"author":{"gitId":"Cywez"},"content":"## About Byline","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":10,"author":{"gitId":"Cywez"},"content":"","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":11,"author":{"gitId":"Cywez"},"content":"Journalists work with a large and constantly growing network of sources, experts and interviewees, often across several stories at once. These contacts usually end up scattered across notebooks, message threads and phone records, making it hard to find the right person when a story breaks.","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":12,"author":{"gitId":"Cywez"},"content":"","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":13,"author":{"gitId":"Cywez"},"content":"Byline brings all of these contacts into one place. Journalists can record each contact\u0027s details, categorise them with tags (for example by expertise), and quickly search through their contact list to find people they might need. Byline is optimised for users who type fast and prefer typing over other means of input.","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":14,"author":{"gitId":"Cywez"},"content":"","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":15,"author":{"gitId":"Cywez"},"content":"## Target Users","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":16,"author":{"gitId":"Cywez"},"content":"","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":17,"author":{"gitId":"Cywez"},"content":"Byline is designed for **journalists who manage numerous professional contacts** with varying relationship strengths and areas of expertise, and who:","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":18,"author":{"gitId":"Cywez"},"content":"","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":19,"author":{"gitId":"Cywez"},"content":"* juggle multiple stories at the same time","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":20,"author":{"gitId":"Cywez"},"content":"* need to quickly find the right source or interviewee for a story","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":21,"author":{"gitId":"Cywez"},"content":"* prefer typing commands over clicking through menus","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":22,"author":{"gitId":"Cywez"},"content":"","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":23,"author":{"gitId":"Cywez"},"content":"**Example user:** Kimberly is an experienced journalist working on several stories at once. Her contacts are spread across scattered notes, messages and phone records, and she needs a single place to organise them and find the right person quickly.","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":24,"author":{"gitId":"Cywez"},"content":"","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":25,"author":{"gitId":"Cywez"},"content":"## Main Features","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":26,"author":{"gitId":"Cywez"},"content":"","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":27,"author":{"gitId":"Cywez"},"content":"* **Add a contact**: Record a contact\u0027s name, phone number, email and address, with optional tags.\u003cbr\u003e","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":28,"author":{"gitId":"Cywez"},"content":"  e.g. `add n/Jane Tan p/91234567 e/jane@example.com a/12 Kent Ridge Road t/economist`","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":29,"author":{"gitId":"Cywez"},"content":"* **List contacts**: View all the contacts stored in Byline.\u003cbr\u003e","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":30,"author":{"gitId":"Cywez"},"content":"  e.g. `list`","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":31,"author":{"gitId":"Cywez"},"content":"* **Delete a contact**: Remove a contact using its index in the displayed list.\u003cbr\u003e","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":32,"author":{"gitId":"Cywez"},"content":"  e.g. `delete 2`","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":33,"author":{"gitId":"Cywez"},"content":"* **Tag contacts**: Categorise contacts with tags such as their area of expertise, so related contacts are easy to group.\u003cbr\u003e","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":34,"author":{"gitId":"Cywez"},"content":"  e.g. `edit 1 t/politics t/source`","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":35,"author":{"gitId":"Cywez"},"content":"* **Search contacts**: Find contacts by name, phone, email, address or tag. Name, phone, email and address can match on part of the text, while tags must match exactly. When you give several conditions, only contacts that match all of them are shown.\u003cbr\u003e","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false},{"lineNumber":36,"author":{"gitId":"Cywez"},"content":"  e.g. `find n/Tan t/economist`","lastModifiedDate":"2026-09-30T22:24:58","isFullCredit":false}],"authorContributionMap":{"RyanNZZ2205":1,"Cywez":30,"-":5}},{"path":"docs/AboutUs.md","fileType":"docs","lines":[{"lineNumber":1,"author":{"gitId":"-"},"content":"---","lastModifiedDate":"2020-05-23T01:10:16","isFullCredit":false},{"lineNumber":2,"author":{"gitId":"-"},"content":"layout: page","lastModifiedDate":"2020-05-23T01:10:16","isFullCredit":false},{"lineNumber":3,"author":{"gitId":"-"},"content":"title: About Us","lastModifiedDate":"2020-05-23T01:10:16","isFullCredit":false},{"lineNumber":4,"author":{"gitId":"-"},"content":"---","lastModifiedDate":"2020-05-23T01:10:16","isFullCredit":false},{"lineNumber":5,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2020-05-23T01:10:16","isFullCredit":false},{"lineNumber":6,"author":{"gitId":"-"},"content":"We are a team based in the [School of Computing, National University of Singapore](https://www.comp.nus.edu.sg).","lastModifiedDate":"2024-07-20T12:38:40","isFullCredit":false},{"lineNumber":7,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2020-05-23T01:10:16","isFullCredit":false},{"lineNumber":8,"author":{"gitId":"-"},"content":"You can reach us at the email `seer[at]comp.nus.edu.sg`","lastModifiedDate":"2020-06-17T23:33:00","isFullCredit":false},{"l