tions":114,"deletions":164},"docs":{"insertions":9,"deletions":8},"test-code":{"insertions":68,"deletions":523}}},{"hash":"bf739ed72268b71e547104e616c6619a74f8873c","isMergeCommit":false,"messageTitle":"Relax phone number validation","messageBody":"Phone fields currently reject useful formatting and labels, while their error message does not identify the reason for rejection.\n\nAccept phone-like eight-digit sequences with ordinary separators and labels. Report specific validation errors and update affected test data.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":44,"deletions":9},"test-code":{"insertions":29,"deletions":17}}},{"hash":"8e1b0d4774b71c7b60a7e617e2fff969219dd6e8","isMergeCommit":false,"messageTitle":"Refine name validation rules","messageBody":"Name validation currently permits digits but excludes customary punctuation and relationship markers.\n\nAllow letters, spaces, hyphens, apostrophes, and recognized relationship markers. Enforce the required trimmed length and reject arbitrary slash usage.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":13,"deletions":7},"test-code":{"insertions":13,"deletions":6}}},{"hash":"04b3c9f5df880170a7b3e4a01a65a2d9ce6488cb","isMergeCommit":false,"messageTitle":"Refine email validation rules","messageBody":"Email validation currently reports a generic format error, which makes correction difficult.\n\nValidate practical email formats with common local-part characters and provide specific errors for invalid email parts.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":80,"deletions":27},"test-code":{"insertions":28,"deletions":14}}},{"hash":"5631f7321d0de7f2a9e337b3223d2d75116cc267","isMergeCommit":false,"messageTitle":"Improve add input validation feedback","messageBody":"The add command currently returns generic errors for missing fields, and the guide does not describe the refined input rules.\n\nReport actionable add errors, distinguish overlong names, and document the name and email formats.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":77,"deletions":21},"docs":{"insertions":6,"deletions":1},"test-code":{"insertions":31,"deletions":7}}},{"hash":"9601fd54ad2790d4a851ce437a4f0af33fcc4a0b","isMergeCommit":false,"messageTitle":"Detect duplicate contacts by email or phone","messageBody":"Contacts currently use names as their identity, even though names can be incomplete or shared.\n\nTreat matching email addresses or phone numbers as duplicate contacts and report the matching field when adding.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":21,"deletions":4},"test-code":{"insertions":39,"deletions":14}}},{"hash":"b29624a90eaf356819ba51989fc9a966587676aa","isMergeCommit":false,"messageTitle":"Clarify name and phone validation errors","messageBody":"Validation errors currently show more detail than users need for invalid names and incomplete phone numbers.\n\nReport concise messages for invalid name characters and incomplete phone numbers while retaining separate blank and length errors.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":8,"deletions":7},"test-code":{"insertions":4,"deletions":3}}},{"hash":"c3d779cda9df291fabc4e6f9fad85e5ba2f38558","isMergeCommit":false,"messageTitle":"Fix Checkstyle issues","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":2,"deletions":1},"test-code":{"insertions":4,"deletions":4}}}]},{"date":"2026-10-05T00:00:00","commitResults":[{"hash":"dd2859cfda667fba4a24ab270613ea902820b459","isMergeCommit":true,"messageTitle":"Merge pull request #49 from KoeyXianHan123/48-add-client-financial-information","messageBody":"Add client financial information value types","fileTypesAndContributionMap":{}}]},{"date":"2026-10-13T00:00:00","commitResults":[{"hash":"c9825b073e23c904969efce10955a76fbdccae4b","isMergeCommit":false,"messageTitle":"Require dotted email domains","messageBody":"Email addresses without a dotted domain are accepted even though ClientBook targets public-facing contact records.\n\nRequire a dot in the domain and document the rule.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":5,"deletions":0},"docs":{"insertions":3,"deletions":2},"test-code":{"insertions":4,"deletions":3}}},{"hash":"c604ad21409aa67fd58c0d9031dbab630e33297a","isMergeCommit":false,"messageTitle":"Standardize Developer Guide requirements","messageBody":"The use cases contain inconsistent formatting and the requirements omit relevant project constraints.\n\nStandardize the use-case layout and add the missing requirements.\n","fileTypesAndContributionMap":{"docs":{"insertions":86,"deletions":52}}},{"hash":"4dc58c3a5c3e0f6f967dff30b14b85700d2f5cda","isMergeCommit":false,"messageTitle":"Update email validation tests","messageBody":"The minimum length still permits addresses that cannot contain a dotted domain after public-domain validation was introduced.\n\nRaise the minimum length and align the tests with current rules.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":2,"deletions":2},"test-code":{"insertions":7,"deletions":5}}},{"hash":"6d217beb0a38d4af3627ed5d0a8f743419936068","isMergeCommit":true,"messageTitle":"Merge pull request #61 from KoeyXianHan123/60-wrap-long-client-financial-information","messageBody":"Wrap long client financial information","fileTypesAndContributionMap":{}}]},{"date":"2026-10-14T00:00:00","commitResults":[{"hash":"63909d1d90ea6a94bff017f0d414b41d44415c08","isMergeCommit":true,"messageTitle":"Merge pull request #71 from ZachL1113/branch-delete-v1.3-regression","messageBody":"Complete delete regressions and v1.3 guide corrections","fileTypesAndContributionMap":{}}]},{"date":"2026-10-15T00:00:00","commitResults":[{"hash":"b7a6297898728bd2b4ae78facc89f1171a09eb21","isMergeCommit":true,"messageTitle":"Merge pull request #73 from ZachL1113/branch-release-v1.3-version","messageBody":"Set application version to v1.3","tags":["v1.3"],"fileTypesAndContributionMap":{}}]},{"date":"2026-10-18T00:00:00","commitResults":[{"hash":"1132584fadf9d3020b193f078177f9bdcd6bbc2b","isMergeCommit":false,"messageTitle":"Add persistent data user story","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":1,"deletions":0}}},{"hash":"402c68cd26ec8b3a3daaa6975ab6d7c5673f131c","isMergeCommit":false,"messageTitle":"Enable relationship status editing","messageBody":"The edit command cannot change a contact\u0027s relationship status, even though it is required when adding a contact.\n\nAllow optional relationship-status edits with the same validation as add, and document and test the expanded command.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":26,"deletions":4},"docs":{"insertions":4,"deletions":2},"test-code":{"insertions":46,"deletions":4}}},{"hash":"328f8f206dd24d7611afd43fcd05f9ed7d0326ff","isMergeCommit":false,"messageTitle":"Start with an empty address book","messageBody":"The application currently populates a missing data file with sample records, which prevents users from beginning with their own data.\n\nStart without sample records and update the user and developer documentation to reflect that behavior.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":4,"deletions":6},"docs":{"insertions":1,"deletions":3}}},{"hash":"6e0303d533e032083828ac1e5ce2f23406639c15","isMergeCommit":false,"messageTitle":"Update validation for duplicate fields in add","messageBody":"The add command reports only the first duplicated prefix, making users correct one error at a time.\n\nUse the shared duplicate-prefix validation to report every duplicate single-valued field together.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":21},"test-code":{"insertions":7,"deletions":4}}},{"hash":"cc7a95036ddc2ddc6f400b3539f5d575c87d5ddb","isMergeCommit":false,"messageTitle":"Remove tag editing support","messageBody":"The edit command still accepts tag fields even though tag changes are no longer part of the supported workflow.\n\nReject tag fields, preserve existing tags during other edits, and update the documentation and tests.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":7,"deletions":59},"docs":{"insertions":3,"deletions":5},"test-code":{"insertions":18,"deletions":55}}},{"hash":"95af7eb19a366643690114f6b0cdf21cc2bb638f","isMergeCommit":true,"messageTitle":"Merge pull request #74 from KoeyXianHan123/enable-gradle-assertions","messageBody":"Enable assertions for Gradle run task","fileTypesAndContributionMap":{}}]}],"JokThreee":[{"date":"2026-09-22T00:00:00","commitResults":[{"hash":"af3ec9dee6a051cd318f139828a53641404ebd91","isMergeCommit":false,"messageTitle":"Update Wei Jie\u0027s profile","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":4,"deletions":5}}},{"hash":"e47c993390a06365ec7decbe25f3078607a0bf01","isMergeCommit":false,"messageTitle":"Update README for ClientBook","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":4,"deletions":10}}},{"hash":"488a620c2b6c124553a4d0c3933e93c5c3df55e9","isMergeCommit":false,"messageTitle":"Update Wei Jie\u0027s profile","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":2,"deletions":2}}},{"hash":"53b5c3f0abcae090d27d4c137a770ed5c497997c","isMergeCommit":true,"messageTitle":"Merge pull request #11 from JokThreee/add-weijie-photo","messageBody":"Add Wei Jie\u0027s photo","fileTypesAndContributionMap":{}},{"hash":"5f597a150752c700bc61256a15a8dac90526a543","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into update-readme","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"dec09d2f49ceb5d5414904e90cd72e4c2caea165","isMergeCommit":true,"messageTitle":"Merge pull request #22 from JokThreee/update-readme","messageBody":"Update README for ClientBook","fileTypesAndContributionMap":{}},{"hash":"af9bd997926cef2d680d4fe927b7f3233824b335","isMergeCommit":true,"messageTitle":"Merge pull request #38 fro