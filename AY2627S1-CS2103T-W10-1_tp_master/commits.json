":"","fileTypesAndContributionMap":{"functional-code":{"insertions":6,"deletions":15},"docs":{"insertions":3,"deletions":3},"test-code":{"insertions":11,"deletions":0}}}]},{"date":"2026-10-12T00:00:00","commitResults":[{"hash":"b6124f1943f0984b31fa19a3f8af719344cff863","isMergeCommit":true,"messageTitle":"Merge pull request #80 from JackChuaYC/branch-sort-command","messageBody":"Branch sort command","fileTypesAndContributionMap":{}},{"hash":"820632c7b89c46e5aba8e6d52e6bde0e08f8df60","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into feature-help-command","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"14f1617151ce99434a85a79201397f99ac0ca02b","isMergeCommit":false,"messageTitle":"Distinguish missing sort field from missing option","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":2,"deletions":1},"docs":{"insertions":2,"deletions":1},"test-code":{"insertions":9,"deletions":2}}},{"hash":"59647e672bedf89cb125855505170bfe9002206e","isMergeCommit":false,"messageTitle":"Add sorting field to SortCommand string representation","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":8,"deletions":0},"test-code":{"insertions":9,"deletions":0}}}]},{"date":"2026-10-13T00:00:00","commitResults":[{"hash":"155c3c417d760488bd156c3350de3076fe597dad","isMergeCommit":false,"messageTitle":"Summarize sort feedback with displayed contact count","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":3,"deletions":24},"docs":{"insertions":21,"deletions":15},"test-code":{"insertions":9,"deletions":16}}},{"hash":"423ecf162cf81479ddc9cb9ca0df28d12282a784","isMergeCommit":false,"messageTitle":"Allow sorting current contacts after startup load failure","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":2,"deletions":50},"docs":{"insertions":20,"deletions":15},"test-code":{"insertions":47,"deletions":27}}},{"hash":"8a48b84b73e0bc37ba1abcc1df33431b061e0dd6","isMergeCommit":false,"messageTitle":"Document sorting command behavior and model contracts","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":22,"deletions":3}}},{"hash":"930ab34b108d1d8be89edd7a13104b7f9e14e602","isMergeCommit":false,"messageTitle":"Specify case-sensitive list and ls commands","messageBody":"The list feature specification requires case-insensitive command words.\nThe agreed behavior accepts only lowercase list and ls instead.\n\nRecord the revised command spellings, whitespace handling, parameter\nerror, and restoration of stored order in the developer guide.\n","fileTypesAndContributionMap":{"docs":{"insertions":11,"deletions":0}}},{"hash":"d2ec8cb723d88bd6713eb5fbce02ba6a736a408e","isMergeCommit":false,"messageTitle":"Define ls alias for the list command","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":0}}},{"hash":"d2d373946675838373741fee243615ad4af47ad3","isMergeCommit":false,"messageTitle":"Reject parameters in the list command parser","messageBody":"The list command silently ignores extra input, which can suggest that\nunsupported filtering or sorting options have been applied.\n\nAdd a parser that accepts blank arguments and rejects other input with\nthe exact error required by the specification. Keep the error in\nListCommand so both spellings share the same usage message.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":28,"deletions":0}}},{"hash":"17b4675c9777293a9aea9cdd6750eca2a2bc6498","isMergeCommit":false,"messageTitle":"Route list and ls through argument validation","messageBody":"The main parser recognizes only list and bypasses argument validation.\n\nRoute both lowercase spellings through ListCommandParser to share\nvalidation and execution without changing other commands\u0027 case rules.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":1}}},{"hash":"0c89bcca244b13a1355622c05b2b6ba4cff6feb4","isMergeCommit":false,"messageTitle":"Test list alias validation and filter restoration","messageBody":"The existing parser test expects list with extra parameters to succeed.\nThere is no coverage for the ls alias or its case-sensitive behavior.\n\nReplace that expectation and cover both spellings, surrounding spaces,\ncase rejection, and exact parameter errors. Verify that valid commands\nrestore all contacts and invalid commands preserve filters and data.\n","fileTypesAndContributionMap":{"test-code":{"insertions":79,"deletions":2}}},{"hash":"9fbad17e0eac196a627785f9b5a83acbf7bf6ae2","isMergeCommit":false,"messageTitle":"Document ls alias and list parameter restrictions","messageBody":"The user guide says list ignores extra parameters, and the in-app help\nshows only the list spelling.\n\nUpdate the guides and command help to describe both spellings and the\nrevised validation rules so users can discover the alias and errors.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":1},"docs":{"insertions":22,"deletions":7}}},{"hash":"ad1a03c6ef7ff7d54a4255fb2034e64a164a368b","isMergeCommit":false,"messageTitle":"Fix Checkstyle formatting in list regression test","messageBody":"The parameter-error assertion violates Checkstyle\u0027s wrapping rule.\n\nName the expected message and keep the lambda on the assertion line to\nmake the test readable and satisfy the project\u0027s formatting checks.\n\nValidation: All 336 tests and Checkstyle checks pass. Generate the\ncoverage report as part of the final checks.\n","fileTypesAndContributionMap":{"test-code":{"insertions":2,"deletions":2}}},{"hash":"b33c06c9e44f92003297b0aaf76a34f2a07eb105","isMergeCommit":false,"messageTitle":"Synchronise use case syntax","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":17,"deletions":37}}},{"hash":"1f1458fda49370f7ab94887ee46a890d2df76008","isMergeCommit":true,"messageTitle":"Merge pull request #90 from JackChuaYC/branch-list-alias","messageBody":"Add ls alias and reject parameters for list commands","fileTypesAndContributionMap":{}},{"hash":"84cbb485f55058220079ca4623913f70cd2046b4","isMergeCommit":true,"messageTitle":"Merge pull request #88 from JackChuaYC/branch-amend-sort","messageBody":"Branch amend sort","fileTypesAndContributionMap":{}},{"hash":"8553b36c68dd0624aa5a4819eb27868a96e92422","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-sync-use-case","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"06f4e3aed3b76cfc6b50c79da5e1203c74f99f8d","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-sync-use-case","messageBody":"","fileTypesAndContributionMap":{}}]}]},"authorFileTypeContributionMap":{"He-Qianyi":{"docs":386,"functional-code":584,"test-code":1395,"other":6},"snowlyr":{"docs":59,"functional-code":511,"test-code":879,"other":3},"Liu-Yuqi-617":{"docs":234,"functional-code":260,"test-code":361},"L-TM":{"docs":121,"functional-code":282,"test-code":501},"JackChuaYC":{"docs":258,"functional-code":318,"test-code":673}},"authorContributionVariance":{"He-Qianyi":263269.47,"snowlyr":86144.55,"Liu-Yuqi-617":9598.062,"L-TM":21814.025,"JackChuaYC":50159.656},"authorDisplayNameMap":{"He-Qianyi":"CS2103T-W10-1 HE Q..ANYI","snowlyr":"CS2103T-W10-1 JOVA..HENG","Liu-Yuqi-617":"CS2103T-W10-1 LIU ..YUQI","L-TM":"CS2103T-W10-1 LIM .. MIN","JackChuaYC":"CS2103T-W10-1 JACK..CHEN"}}
