0efc6a2598d4e2378e516893e21fbc0a0f","isMergeCommit":true,"messageTitle":"Merge pull request #44 from L-TM/update-readme","messageBody":"Update README to acknowledge the original AB3 source","fileTypesAndContributionMap":{}},{"hash":"a5fee33d7e11d977673e1c74485d1f226a9be354","isMergeCommit":true,"messageTitle":"Merge remote-tracking branch \u0027upstream/master\u0027 into update-developer-guide","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"3ee2e273b4b9ef21438cb2f7e5b67473df6770ad","isMergeCommit":false,"messageTitle":"Developer guide: Acknowledge the original AB3 source","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":2,"deletions":1}}},{"hash":"001c8a6b2f1355f99c6ecedd30984603eb48dfe0","isMergeCommit":false,"messageTitle":"Developer guide: Refine UC3 for contact deletion","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":18,"deletions":12}}},{"hash":"4c05fa7b96f7b512457a0fc19c6ce4606727cd50","isMergeCommit":false,"messageTitle":"Developer guide: Add UC4 for undoing a deletion","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":37,"deletions":0}}},{"hash":"3d9c42d37309434c6cfc667ea0f888616a139d3a","isMergeCommit":true,"messageTitle":"Merge pull request #45 from L-TM/update-developer-guide","messageBody":"Update use cases in developer guide","fileTypesAndContributionMap":{}}]},{"date":"2026-10-07T00:00:00","commitResults":[{"hash":"1a9512280953586aeba5156b1d1e0c9acf661866","isMergeCommit":false,"messageTitle":"Add undo command to restore deleted persons","messageBody":"A deleted person cannot be recovered, as the address book is saved to\ndisk after every command.\n\nLet\u0027s add an `undo` command that restores the most recently deleted\nperson, as described in UC4 of the Developer Guide. Keep the deletion\nhistory of the current session in ModelManager.\n\nReject arguments, as `undo 2` is ambiguous. Refuse to restore a person\nwho already exists, leaving them on top of the deletion history so undo\ncan retry once the clash is resolved. Also mention undo in the delete\nsuccess message.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":119,"deletions":3},"test-code":{"insertions":15,"deletions":0}}},{"hash":"18501f59c4b226a011a3a2b18f914163382282d0","isMergeCommit":false,"messageTitle":"Add tests for undo command","messageBody":"The undo command and the deletion history in ModelManager have no tests.\n\nLet\u0027s add tests for restoring deletions most recent first, including\nfrom a filtered list, and for the failure cases: nothing to undo, a\nperson who already exists, and arguments given to undo. Also test that\nModelManager records, restores and compares deletion history.\n","fileTypesAndContributionMap":{"test-code":{"insertions":175,"deletions":0}}},{"hash":"70a5a32f060df94cc07da4320c091f806cb20e22","isMergeCommit":false,"messageTitle":"UserGuide: Document undo command","messageBody":"The User Guide does not mention undo, so users cannot find out that a\ndeletion can be reversed.\n\nLet\u0027s document what undo restores and its limits: it reverts only\ndelete, lasts for the current session, adds the person to the end of the\nlist, fails if the same person exists, and takes no parameters.\n","fileTypesAndContributionMap":{"docs":{"insertions":20,"deletions":0}}},{"hash":"5389429c0ff85012859fff9c8220860731ebcf5e","isMergeCommit":false,"messageTitle":"Add Codecov badge","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":1,"deletions":0}}}]},{"date":"2026-10-08T00:00:00","commitResults":[{"hash":"36767ce8370e7a3bf60dce32fff673b2929b1555","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into add-undo-delete","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"c05fd866992f469a78f0268d85ad4a69f9682948","isMergeCommit":true,"messageTitle":"Merge pull request #75 from L-TM/add-codecov-badge","messageBody":"Add Codecov badge","fileTypesAndContributionMap":{}},{"hash":"1b0569d2b88a4e65954ae08793bc5275a9b37c96","isMergeCommit":false,"messageTitle":"Align duplicate contact definition with code","messageBody":"The guides disagree on what a duplicate contact is, while the code\ncompares name only.\n\nLet\u0027s define it in the glossary as a case-sensitive name match, and\nrefer to it from the user cases and the User Guide.\n","fileTypesAndContributionMap":{"docs":{"insertions":5,"deletions":6}}},{"hash":"33642c5fc79175b713ee96f9a4615f9008f4588a","isMergeCommit":true,"messageTitle":"Merge pull request #73 from L-TM/add-undo-delete","messageBody":"Add undo command to restore deleted persons","fileTypesAndContributionMap":{}}]},{"date":"2026-10-13T00:00:00","commitResults":[{"hash":"2e194e58db6a5404d7228996234fd99cf0f1dd27","isMergeCommit":false,"messageTitle":"Make command words case-insensitive","messageBody":"Command words must currently match exactly, so `LIST` gives\n\"Unknown command\". Lowercase the command word before matching it\nagainst each COMMAND_WORD. Arguments are unchanged.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":1}}},{"hash":"f74e8740538cac5659324e4d8690f88e5bb4e039","isMergeCommit":false,"messageTitle":"Add tests for case-insensitive command words","messageBody":"Cover uppercase and mixed-case command words, check that arguments\nkeep their case, and check that a near-miss like `LISTS` is still\nan unknown command.\n","fileTypesAndContributionMap":{"test-code":{"insertions":21,"deletions":0}}},{"hash":"d48213cc329145b899a6f4d981b6a5f0ce8ea601","isMergeCommit":false,"messageTitle":"Document case-insensitive command words in User Guide","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":3,"deletions":0}}},{"hash":"6caa216a43d41abc9c8a2d3c7b9133866dac88f5","isMergeCommit":false,"messageTitle":"Switch field prefixes to Unix-style flags","messageBody":"The add and edit commands use AB3-style prefixes (n/, p/, ...), while\nnewer commands such as sort and depart already use Unix-style options.\n\nReplace the prefixes with short and long flags: -n/--name, -p/--phone,\n-e/--email, -a/--address and -t/--tag.\n\nPrefix now holds aliases, and equality uses the primary form only. Both\nforms therefore share one ArgumentMultimap key, and `-e a --email b` is\nreported as a repeated field.\n\nArgumentTokenizer matches every form of a prefix, and only when it is\na separate word. A value such as `Blk 5 -apt 3` is not split, and\n`-nJohn` is not read as a flag.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":97,"deletions":52}}},{"hash":"81c271025498b95b207a20c8ab65dc9a2558c2da","isMergeCommit":false,"messageTitle":"Update tests for Unix-style flags","messageBody":"Test helpers glued values to prefixes (n/Amy), which the tokenizer no\nlonger accepts once prefixes must be separate words.\n\nInsert a space after each flag in CommandTestUtil and PersonUtil.\n\nAdd tests for long-form aliases, mixing short and long forms, repeated\nflags in either form, values glued to a flag, and clearing tags with\n--tag.\n","fileTypesAndContributionMap":{"test-code":{"insertions":152,"deletions":28}}},{"hash":"859da6211b8ddc39a7598bdeb442c0f147c544de","isMergeCommit":false,"messageTitle":"Update docs for Unix-style flags","messageBody":"The user guide and developer guide still show the old n/-style\nprefixes.\n\nReplace every example with the new flags, list the short and long\nforms, and explain that a flag must be a separate word.\n","fileTypesAndContributionMap":{"docs":{"insertions":28,"deletions":17}}}]},{"date":"2026-10-14T00:00:00","commitResults":[{"hash":"a46f377bdff5154597a7c15b40d40d7b083cbb0c","isMergeCommit":true,"messageTitle":"Merge pull request #91 from JackChuaYC/branch-sync-use-case","messageBody":"Synchronise use case syntax","fileTypesAndContributionMap":{}},{"hash":"5a5cb803a0b893890c43d3c1998dcceab4761ce2","isMergeCommit":true,"messageTitle":"Merge remote-tracking branch \u0027upstream/master\u0027 into unix-style-flags","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"c6b6cf2edc4db186376b3a3854e643dbb066ffc5","isMergeCommit":false,"messageTitle":"Unify add and edit flag parsing in one tokenizer","messageBody":"add used AddArgumentTokenizer for long options and ArgumentTokenizer\nfor short flags, so add and edit followed different rules for mixing\nflags, quotes and tags.\n\nMove add\u0027s features into ArgumentTokenizer and use it for add, edit\nand depart:\n- Short and long flags can be mixed in one command.\n- A quoted word is literal text, so a value can contain a flag, e.g.\n  -a \"Blk 5 -t 3\". Quotes inside a word are ordinary characters.\n- Each word after -t/--tag is a separate tag.\n- Unknown -- options and unmatched quotes are rejected.\n\nDuplicate-field errors now name both forms of a flag, e.g. -e/--email.\n\nRemove AddArgumentTokenizer, which is no longer used.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":140,"deletions":252},"docs":{"insertions":22,"deletions":13},"test-code":{"insertions":131,"deletions":41}}},{"hash":"05683965821a4dd2cc6391f97e10b204d5d4c31f","isMergeCommit":false,"messageTitle":"Replace AB-3 branding and badges on website landing page","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":6,"deletions":6}}},{"hash":"fa708335d51ccc4f6ecacece77baaa8b4f9eb081","isMergeCommit":true,"messageTitle":"Merge pull request #94 from L-TM/case-insensitive-command-words","messageBody":"Case insensitive command words","fileTypesAndContributionMap":{}},{"hash":"371312f9d9fb69eea27fe1b4277c73e423ad44b3","isMergeCommit":false,"messageTitle":"Test depart parser errors from the tokenizer","messageBody":"Codecov reported the catch block in DepartCommandParser as uncovered:\nno test passed depart an unknown option or an unmatched quote.\n\nAdd tests for both errors, and for a quoted department name.\n","fileTypesAndContributionMap":{"test-code":{"insertions":14,"deletions":0}}},{"hash":"8a489760547977fc56cf01f1a4ea948253a55576","isMergeCommit":true,"messageTitle":"Merge pull request #97 from L-TM/update-landing-page","messageBody":"Replace AB-3 branding and badges on website landing page","fileTypesAndContributionMap":{}}]}],"JackChuaYC":[{"date":"2026-09-30T00:00:00","commitResults":[{"hash":"7928174c1912bbd422b55cac2e93188a4bbc850f","isMergeCommit":false,"messageTitle":"Update AboutUs.md with Jack\u0027s profile","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":4,"deletions":4}}},{"hash":"384fc392f4512854bd812d0a246ed4cd60875220","isMergeCommit":false,"messageTitle":"Update DeveloperGuide with user information","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":21,"deletions":9}}},{"hash":"0327eb7c1b0e45a81c14652569cbdf98e79b15f4","isMergeCommit":false,"messageTitle":"Update AboutUs.md with Jack info","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":0,"deletions":1}}},{"hash":"ddbbe5d31100c63d38be20e6d06f5f39c29258e2","isMergeCommit":true,"messageTitle":"Merge branch \u0027branch-about-jack\u0027","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"2a8626158f2e49887a9d2ad452e3a42bf4f4b0af","isMergeCommit":true,"messageTitle":"Merge pull request #32 from Liu-Yuqi-617/add-yuqi-profile","messageBody":"Rename the image file","fileTypesAndContributionMap":{}}]},{"date":"2026-10-01T00:00:00","commitResults":[{"hash":"6709fc04cfb6e9a4edcace1158f3bfd2df5419f1","isMergeCommit":false,"messageTitle":"Add JavaCI badge to README.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":1,"deletions":1}}},{"hash":"9c5e1483521e546e06cfea37d0459a3dbac87889","isMergeCommit":false,"messageTitle":"Add list_all_contacts Usecase","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":25,"deletions":8}}},{"hash":"fb541f2826dc11b0c92c34f466deda9259310e53","isMergeCommit":false,"messageTitle":"Add user sorts Usercase","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":13,"deletions":3}}}]},{"date":"2026-10-02T00:00:00",