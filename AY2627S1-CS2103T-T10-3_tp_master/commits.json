utionMap":{}},{"hash":"cd13cc22221b29a8cfc8b13fef9b262a6deba437","isMergeCommit":true,"messageTitle":"Merge pull request #34 from L0pch/update-fredrick-about-us","messageBody":"Add Fredrick\u0027s details to About Us","fileTypesAndContributionMap":{}}]},{"date":"2026-09-29T00:00:00","commitResults":[{"hash":"1e16438c4f22773f7da4f3bc56ded7cc9b7d72f9","isMergeCommit":false,"messageTitle":"Update DG product scope and glossary for HiveMind","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":25,"deletions":6}}}]},{"date":"2026-10-01T00:00:00","commitResults":[{"hash":"46dfb7fabadfb7072d3f1dd72458825dd7671519","isMergeCommit":true,"messageTitle":"Merge pull request #37 from irtan-cell/update-readme","messageBody":"Update README","fileTypesAndContributionMap":{}},{"hash":"ff33904ce04cbd51bda229fa16dbc027f3a3907d","isMergeCommit":true,"messageTitle":"Merge pull request #40 from liownahum/branch-DGUserStories","messageBody":"Update DG User Stories","fileTypesAndContributionMap":{}},{"hash":"7f1a8ef35399cb14d50ab465e7b5538ab7a5656e","isMergeCommit":true,"messageTitle":"Merge pull request #42 from irtan-cell/update-site-home","messageBody":"Update HiveMind website home page","fileTypesAndContributionMap":{}},{"hash":"da8607e75832119127d7ad13182308291984508a","isMergeCommit":false,"messageTitle":"Clean up HiveMind website branding and documentation","messageBody":"","fileTypesAndContributionMap":{"other":{"insertions":2,"deletions":2},"docs":{"insertions":15,"deletions":20}}}]},{"date":"2026-10-08T00:00:00","commitResults":[{"hash":"223795cb85454710056ced0c97750e8a5a6590d4","isMergeCommit":false,"messageTitle":"Add Instrument value class and JSON adapter","messageBody":"Members need to record each instrument they play together with the\nnumber of years played, so that coordinators can later filter by\ninstrument and experience.\n\nInstrument stores a trimmed name and a whole number of years (0-99).\nNames are compared ignoring case and extra whitespace, so \u0027French Horn\u0027\nand \u0027french  horn\u0027 refer to the same instrument.\n\nJsonAdaptedInstrument stores an instrument as {\"name\", \"years\"} so\nthe data file stays easy to edit by hand.\n\nNeither class is used by Person yet; that follows in v1.3.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":165,"deletions":0},"test-code":{"insertions":166,"deletions":0}}},{"hash":"c2d7930148442a6c81cba5c105a8c6129d41f3b9","isMergeCommit":false,"messageTitle":"Reject decimal years when loading instruments from JSON","messageBody":"Jackson truncated decimal years before validation, so a hand-edited\n\"years\": 3.9 loaded as 3 and -0.5 loaded as 0. Values too large for an\nint also wrapped around into the valid range.\n\nRead years as a Number and accept only whole numbers that fit in an int.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":18,"deletions":4},"test-code":{"insertions":29,"deletions":0}}},{"hash":"4dc44f8cc6618bd185813d3cacb5764f78252d8c","isMergeCommit":true,"messageTitle":"Merge pull request #62 from liownahum/branch/61-partial-name-matching","messageBody":"Branch/61 partial name matching","fileTypesAndContributionMap":{}}]}],"cs28118":[{"date":"2026-09-24T00:00:00","commitResults":[{"hash":"577c646f3076831aec04d865a3774e218990ba8b","isMergeCommit":false,"messageTitle":"Update AboutUs with Chun Sheng\u0027s details","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":4,"deletions":5}}}]},{"date":"2026-10-02T00:00:00","commitResults":[{"hash":"da3489f0eda99dd37abd6bc8ca46a7ebfd7fbb0b","isMergeCommit":false,"messageTitle":"Add use cases in DG","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":106,"deletions":29}}},{"hash":"666abea040149bab93a8aae950e63988866c219e","isMergeCommit":false,"messageTitle":"Update non-functional requirements in DG","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":4,"deletions":0}}}]},{"date":"2026-10-08T00:00:00","commitResults":[{"hash":