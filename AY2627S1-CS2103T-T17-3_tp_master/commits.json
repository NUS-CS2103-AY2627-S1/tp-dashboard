e\nentire tag set. This causes inconsistent labels and accidental loss\nof unrelated tags.\n\nNormalize tag names to lowercase across creation and loading.\nPreserve existing tags during edits and reject tag arguments with\nguidance to use the planned tagadd and tagremove commands.\n\nUpdate tests and documentation. Gradle check passes with 251 tests\nand no Checkstyle violations.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":18,"deletions":59},"docs":{"insertions":42,"deletions":5},"test-code":{"insertions":196,"deletions":70}}},{"hash":"b6632901a4fc60f3b19738f07cd09b3a279165a7","isMergeCommit":false,"messageTitle":"Clarify edit examples in the user guide","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":2,"deletions":1}}},{"hash":"eb6950ec175108784799f5950ccd67f9f2cfbefb","isMergeCommit":true,"messageTitle":"Merge pull request #58 from Eddrick-23/feat/54-find-by-name-phone-email","messageBody":"Feat/54 find by name phone email","fileTypesAndContributionMap":{}}]}],"Unknownflow":[{"date":"2026-09-30T00:00:00","commitResults":[{"hash":"a510aba1d0636f8dc53c31603f10691bb7f7ab02","isMergeCommit":false,"messageTitle":"Update Clarence AboutUs info","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":3,"deletions":4}}},{"hash":"20c950d51361ef749c177dd6976261fe380951b6","isMergeCommit":true,"messageTitle":"Merge pull request #26 from bany-nguyen/add-bany-aboutUs","messageBody":"Add information about Bany in AboutUs page","fileTypesAndContributionMap":{}},{"hash":"f8e8bf877eb09f4a52097189f32a0516730cd9c3","isMergeCommit":false,"messageTitle":"Update link of Github actions build status badge","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":1,"deletions":1}}},{"hash":"799bb0a83d8de487a5f7bb9f67447e81a9b98733","isMergeCommit":false,"messageTitle":"Add target user and value proposition to DG","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":7,"deletions":5}}},{"hash":"919c835fbc181