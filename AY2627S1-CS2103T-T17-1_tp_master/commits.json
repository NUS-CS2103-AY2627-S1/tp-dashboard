{"authorDailyContributionsMap":{"jingyucodes":[{"date":"2026-10-01T00:00:00","commitResults":[{"hash":"fd68f4e61cc8fd6f6d8919f98c85814b33dc84c5","isMergeCommit":false,"messageTitle":"Update AboutUs page with Jingyu\u0027s photo and links","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":2,"deletions":3}}},{"hash":"5ad840089d1a80f19f7adb3e4954a0d0abc6ab3e","isMergeCommit":true,"messageTitle":"Merge pull request #29 from zao05/22-Update-Qi-Zao\u0027s-About-Us","messageBody":"Update Lim Qi Zao AboutUs","fileTypesAndContributionMap":{}}]},{"date":"2026-10-09T00:00:00","commitResults":[{"hash":"8e3200dd2d860dee8072b6d59604a1fcafdedca2","isMergeCommit":false,"messageTitle":"Replace AB3 placeholders in AboutUs and DG","messageBody":"The AboutUs page and the DG still contain placeholders copied from\nAB3: a lecturer\u0027s homepage link, johndoe portfolio links, AB3\u0027s\ncontact email, and an empty DG Acknowledgements section. These make\nthe TutorContacts documentation look unfinished and point readers\nto pages unrelated to the team.\n\nLet\u0027s remove the placeholder links and email, and acknowledge AB3,\nSE-EDU, and the third-party libraries in the DG. Portfolio links are\nleft out until a member opts into the optional Project Portfolio\nPage.\n\nAlso use https for all GitHub profile links for consistency.\n\nCo-Authored-By: Claude Opus 5.5 \u003cnoreply@anthropic.com\u003e\n","fileTypesAndContributionMap":{"docs":{"insertions":7,"deletions":8}}},{"hash":"d9d31171bea82d04d35c616d6b9dc4137bc1ac8d","isMergeCommit":false,"messageTitle":"Add team roles and responsibilities to AboutUs","messageBody":"The AboutUs page lists every member\u0027s role and responsibilities as\n\"TBA\", but the Week 7 tasks require each member\u0027s role to be stated.\n\nLet\u0027s add the roles the team agreed on, based on each member\u0027s work\nso far, with responsibilities phrased after the course\u0027s role\ndefinitions. Joel takes the team lead role.\n\nCo-Authored-By: Claude Opus 5.5 \u003cnoreply@anthropic.com\u003e\n","fileTypesAndContributionMap":{"docs":{"insertions":10,"deletions":10}}}]}],"qztoh":[{"date":"2026-10-01T00:00:00","commitResults":[{"hash":"52ea694872425b907571b13187c245f3f06de850","isMergeCommit":false,"messageTitle":"Update Qi Zhang\u0027s About Us details","messageBody":"Replace the placeholder photo and GitHub link so the team page identifies\nQi Zhang correctly. Remove the unused portfolio link and retain TBA for\nrole and responsibilities pending team allocation.\n","fileTypesAndContributionMap":{"docs":{"insertions":2,"deletions":3}}},{"hash":"354116e4fe59b480f3927d95760f495451f0fe35","isMergeCommit":true,"messageTitle":"Merge pull request #30 from jingyucodes/26-update-aboutus-page","messageBody":"Update AboutUs page","fileTypesAndContributionMap":{}}]},{"date":"2026-10-05T00:00:00","commitResults":[{"hash":"d7a04933fc0cda7f9fad7f35eb8ee0eb514cc850","isMergeCommit":true,"messageTitle":"Merge pull request #39 from Antelyuu/38-update-readme-site-branding","messageBody":"Update README and TutorContacts site branding","fileTypesAndContributionMap":{}}]}],"Antelyuu":[{"date":"2026-10-01T00:00:00","commitResults":[{"hash":"7e5a3605ea5e08e1830ace9af2f4a53b669317c2","isMergeCommit":false,"messageTitle":"Docs: Update Joel\u0027s AboutUs page","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":2,"deletions":2}}},{"hash":"8c520f6741b9db81c24adfc9eb927ef9d327ea88","isMergeCommit":true,"messageTitle":"Merge pull request #18 from jingyucodes/12-add-jingyu-photo","messageBody":"Add Jingyu\u0027s photo","fileTypesAndContributionMap":{}},{"hash":"f032aa4ad9685dec6fe9fc1cec8ae318e8cf4c4c","isMergeCommit":true,"messageTitle":"Merge pull request #27 from qztoh/25-update-qizhang-about-us","messageBody":"Update Qi Zhang\u0027s About Us details","fileTypesAndContributionMap":{}}]},{"date":"2026-10-04T00:00:00","commitResults":[{"hash":"11da6266d1e310dde9968eb7f7f20eedf38f4cf1","isMergeCommit":false,"mes