ut Us","fileTypesAndContributionMap":{}}]},{"date":"2026-10-01T00:00:00","commitResults":[{"hash":"3dde333f68006c99648719d5685bf777dfc0d4ef","isMergeCommit":false,"messageTitle":"Update usecases in docs","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":65,"deletions":15}}}]}],"Ryanyzh":[{"date":"2026-09-29T00:00:00","commitResults":[{"hash":"a37d17b05690f030f6b865bed1a28ebe3be37689","isMergeCommit":false,"messageTitle":"Add Ryan\u0027s picture and roles description into about us","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":10,"deletions":0}}},{"hash":"7930f433f949a48db14cf3e2395522ad52a035ac","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-update-about-us","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"c4698bbea35ed19e2198075bfc4bd0088085c67d","isMergeCommit":true,"messageTitle":"Merge pull request #79 from Aster0/branch-update-about-us","messageBody":"Add Aden\u0027s About Us","fileTypesAndContributionMap":{}}]},{"date":"2026-10-06T00:00:00","commitResults":[{"hash":"212ad25a3d776c8d2fd52df7d9f499a102a55f70","isMergeCommit":false,"messageTitle":"Add academic class model","messageBody":"The app needs to represent classes so students can later be assigned to\nor removed from them.\n\nThe MVP specifies that each class is identified by a module code and\nclass name pair. The model should enforce that identity before command,\nstorage, or UI work builds on top of it.\n\nLet\u0027s add academic class model classes for module code, class name, and\nstudent membership.\n\nThe value objects normalize stored values to uppercase and validate the\ninput rules from the MVP. The academic class model follows the existing\nPerson model style, including immutable fields, identity comparison,\nequality, hashing, and string formatting.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":237,"deletions":0},"test-code":{"insertions":233,"deletions":0}}},{"hash":"8f4cee2eca1754d0f9f887ac90ab8e537071ae24","isMergeCommit":false,"messageTitle":"Align academic class equality with identity","messageBody":"AcademicClass has no planned need for equality that includes student\nmembership.\n\nIncluding students in equals makes duplicate checks and collection use\ndepend on assignment state, even though the MVP identifies a class by its\nmodule code and class name pair.\n\nLet\u0027s make AcademicClass equality use only module code and class name.\n\nThis keeps equals consistent with the class identity rule used by future\nadd, delete, list, assign, and unassign features.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":5,"deletions":10},"test-code":{"insertions":13,"deletions":23}}},{"hash":"8d602c2d5502f33ad8b379f63a96603b4be9853b","isMergeCommit":false,"messageTitle":"Remove duplicate academic class identity method","messageBody":"AcademicClass uses module code and class name as its equality rule.\n\nThe separate identity helper has the same behavior as equals, so keeping\nboth methods creates an unnecessary second API for future class features.\n\nLet\u0027s remove the duplicate identity helper and keep equals as the single\ncomparison method.\n\nThis keeps the model simpler while preserving the MVP identity rule for\nacademic classes.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":2,"deletions":14},"test-code":{"insertions":0,"deletions":23}}}]}],"Luigi-Simon":[{"date":"2026-09-29T00:00:00","commitResults":[{"hash":"0d9cb7c4015aec6fda80e1ff4b3cf24051ad8be0","isMergeCommit":true,"messageTitle":"Merge pull request #62 from Luigi-Simon/add-luigi-simon-photo","messageBody":"Add Luigi Simon\u0027s profile photo","fileTypesAndContributionMap":{}},{"hash":"1e5529488cb8e5d9b77303440896373c071d0a12","isMergeCommit":false,"messageTitle":"Update Luigi Simon\u0027s AboutUs details","messageBody":"AboutUs does not list Luigi Simon or his project responsibilities.\n\nAdd his profile, GitHub link, and documentation role so the team page reflects the current team.\n","fileTypesAndContributionMap":{"docs":{"insertions":9,"deletions":0}}}]},{"date":"2026-09-30T00:00:00","commitResults":[{"hash":"b4916895a714a5eea91523826ed3e1d759ceb867","isMergeCommit":false,"messageTitle":"Update README build status badge","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":1,"deletions":1}}},{"hash":"194a4f45dfc85b620ae8089118f4b409b430d970","isMergeCommit":false,"messageTitle":"Acknowledge AddressBook-Level3 source","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":5,"deletions":0}}}]},{"date":"2026-10-01T00:00:00","commitResults":[{"hash":"8286cc52b77d24a896648c53d9bc4c1c3cc35905","isMergeCommit":false,"messageTitle":"Update README for TAssist","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":23,"deletions":12}}}]}]},"authorFileTypeContributionMap":{"Aster0":{"docs":13,"functional-code":0,"test-code":0},"luyao-111":{"docs":4,"functional-code":0,"test-code":0},"bevanpoh":{"docs":3,"functional-code":0,"test-code":0},"LeeWenKang-NUS":{"docs":65,"functional-code":0,"test-code":0},"Ryanyzh":{"docs":10,"functional-code":220,"test-code":200},"Luigi-Simon":{"docs":34,"functional-code":0,"test-code":0}},"authorContributionVariance":{"Aster0":134.4432,"luyao-111":4.9861493,"bevanpoh":197.9003,"LeeWenKang-NUS":321.7784,"Ryanyzh":15610.526,"Luigi-Simon":64.11079},"authorDisplayNameMap":{"Aster0":"CS2103-F10-2 KOH ..ADEN","luyao-111":"CS2103-F10-2 LU Y.. YAO","bevanpoh":"CS2103-F10-2 POH ..EVAN","LeeWenKang-NUS":"CS2103-F10-2 LEE ..KANG","Ryanyzh":"CS2103-F10-2 YONG..RYAN","Luigi-Simon":"CS2103-F10-2 SIMO..IANO"}}
