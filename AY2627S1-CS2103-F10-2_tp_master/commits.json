,{"hash":"1741a49be1721b95bdc99ef61958f4d1ebf19ffb","isMergeCommit":true,"messageTitle":"Merge pull request #94 from Ryanyzh/docs-nfr-glossary","messageBody":"Add NFRs and glossary to Developer Guide","fileTypesAndContributionMap":{}},{"hash":"ac54964429506b83acf237d03faee5d673e64a35","isMergeCommit":true,"messageTitle":"Merge pull request #99 from bevanpoh/branch-More-Use-cases","messageBody":"Add use cases to user docs","fileTypesAndContributionMap":{}},{"hash":"60082be845fd9bc9f0f7005f2742a12071bc14b4","isMergeCommit":true,"messageTitle":"Merge pull request #108 from Ryanyzh/add-class-command","messageBody":"Add academic class creation command","fileTypesAndContributionMap":{}}]}],"Ryanyzh":[{"date":"2026-09-29T00:00:00","commitResults":[{"hash":"a37d17b05690f030f6b865bed1a28ebe3be37689","isMergeCommit":false,"messageTitle":"Add Ryan\u0027s picture and roles description into about us","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":10,"deletions":0}}},{"hash":"7930f433f949a48db14cf3e2395522ad52a035ac","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-update-about-us","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"c4698bbea35ed19e2198075bfc4bd0088085c67d","isMergeCommit":true,"messageTitle":"Merge pull request #79 from Aster0/branch-update-about-us","messageBody":"Add Aden\u0027s About Us","fileTypesAndContributionMap":{}}]},{"date":"2026-10-05T00:00:00","commitResults":[{"hash":"782d904f54c7b002fc0cff9effc4bab354834106","isMergeCommit":false,"messageTitle":"Add NFRs and glossary to Developer Guide","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":28,"deletions":7}}}]},{"date":"2026-10-06T00:00:00","commitResults":[{"hash":"212ad25a3d776c8d2fd52df7d9f499a102a55f70","isMergeCommit":false,"messageTitle":"Add academic class model","messageBody":"The app needs to represent classes so students can later be assigned to\nor removed from them.\n\nThe MVP specifies that each class is identified by a module code and\nclass name pair. The model should enforce that identity before command,\nstorage, or UI work builds on top of it.\n\nLet\u0027s add academic class model classes for module code, class name, and\nstudent membership.\n\nThe value objects normalize stored values to uppercase and validate the\ninput rules from the MVP. The academic class model follows the existing\nPerson model style, including immutable fields, identity comparison,\nequality, hashing, and string formatting.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":237,"deletions":0},"test-code":{"insertions":233,"deletions":0}}},{"hash":"8f4cee2eca1754d0f9f887ac90ab8e537071ae24","isMergeCommit":false,"messageTitle":"Align academic class equality with identity","messageBody":"AcademicClass has no planned need for equality that includes student\nmembership.\n\nIncluding students in equals makes duplicate checks and collection use\ndepend on assignment state, even though the MVP identifies a class by its\nmodule code and class name pair.\n\nLet\u0027s make AcademicClass equality use only module code and class name.\n\nThis keeps equals consistent with the class identity rule used by future\nadd, delete, list, assign, and unassign features.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":5,"deletions":10},"test-code":{"insertions":13,"deletions":23}}},{"hash":"8d602c2d5502f33ad8b379f63a96603b4be9853b","isMergeCommit":false,"messageTitle":"Remove duplicate academic class identity method","messageBody":"AcademicClass uses module code and class name as its equality rule.\n\nThe separate identity helper has the same behavior as equals, so keeping\nboth methods creates an unnecessary second API for future class features.\n\nLet\u0027s remove the duplicate identity helper and keep equals as the single\ncomparison method.\n\nThis keeps the model simpler while preserving the MVP identity rule for\nacademic classes.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":2,"deletions":14},"test-code":{"insertions":0,"deletions":23}}}]},{"date":"2026-10-08T00:00:00","commitResults":[{"hash":"515d399a5a096cbd58b31fd222000b7a5938b8cd","isMergeCommit":false,"messageTitle":"Add academic class data support","messageBody":"The app needs to store academic classes before create, delete, list,\nassign, and unassign commands can work reliably.\n\nAcademic classes are uniquely identified by their module code and class\nname pair. This identity rule needs to be enforced at the model level so\nfuture features use the same duplicate handling.\n\nLet\u0027s add a uniqueness-enforcing academic class list to AddressBook and\ninclude academic classes in JSON storage.\n\nThis keeps class data managed alongside persons while preserving\ninsertion order for future listclass behavior.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":145,"deletions":2},"test-code":{"insertions":82,"deletions":0}}},{"hash":"117cf465c45347b2c1f6cb36ab8a87be1053f4f3","isMergeCommit":false,"messageTitle":"Add create class command","messageBody":"Users need a command to create classes that students can later be\nassigned to.\n\nThe MVP requires addclass to accept module code and class name in any\norder, reject missing or repeated parameters, normalize values, and\nprevent duplicate module-code/class-name pairs.\n\nLet\u0027s add the addclass command, parser, CLI prefixes, and parser helpers\nfor academic class fields.\n\nThis implements the command behavior while reusing the model\u0027s academic\nclass identity and validation rules.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":191,"deletions":6},"test-code":{"insertions":296,"deletions":2}}},{"hash":"632563dc3c750ad8049e04fadd77f67e68245348","isMergeCommit":false,"messageTitle":"Show academic classes in UI","messageBody":"Created classes need to appear immediately after a successful addclass\ncommand.\n\nThe model exposes academic classes as an observable list, but the UI\ndoes not have a panel that displays that list.\n\nLet\u0027s add an academic class list panel and card, then wire it into the\nmain window through Logic.\n\nThis keeps the UI update path consistent with the existing person list\npanel while showing classes in insertion order.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":146,"deletions":1}}},{"hash":"5efbc253cec84910c52c20d706c632a98af771b3","isMergeCommit":false,"messageTitle":"Align academic class style","messageBody":"The rebased addclass branch should follow the project\u0027s Java coding\nstandard before opening the pull request.\n\nSome touched files had minor Javadoc formatting gaps and an extra blank\nline that Checkstyle did not flag directly.\n\nLet\u0027s add the missing public constructor documentation, format the model\nAPI comment consistently, and clean up parser and model whitespace.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":7,"deletions":2}}},{"hash":"f6453663e2b2efaf9d02b692a16a9ddd52b83b0c","isMergeCommit":false,"messageTitle":"Improve academic class coverage","messageBody":"The addclass PR has uncovered model, logic, and storage paths in the\nacademic class workflow.\n\nLet\u0027s add focused tests for academic class list access, duplicate class\nhandling, model manager delegation, logic list exposure, and JSON class\nserialization.\n\nThis also updates the section labels to use white text so Students and\nClasses remain readable on the dark background.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":1},"test-code":{"insertions":122,"deletions":0}}},{"hash":"8cede8a89af47b3c0cf96e503e68dad1ade0bdb7","isMergeCommit":false,"messageTitle":"Cover academic class UI paths","messageBody":"Codecov still reports missing lines in the academic class UI and JSON\nadapter changes.\n\nLet\u0027s add focused JavaFX tests for the academic class card, list panel,\nand main window wiring, plus the remaining empty-field JSON adapter\ncases.\n\nThis covers the source lines added for displaying academic classes while\nkeeping the tests scoped to the new UI components.\n","fileTypesAndContributionMap":{"test-code":{"insertions":283,"deletions":0}}},{"hash":"fa396cd6ef8de78d477b18176c4f591da5192bc8","isMergeCommit":false,"messageTitle":"Clarify add class comments","messageBody":"The addclass command and parser comments should describe the current\nbehavior in plain language.\n\nLet\u0027s tighten the wording without changing command behavior so the PR\ncan retrigger CI with a small documentation-only update.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":3,"deletions":3}}},{"hash":"f8d3032cb5a78bab32d49b9f2046ffb20fc60d1e","isMergeCommit":false,"messageTitle":"Run JavaFX tests with Xvfb","messageBody":"The new academic class UI tests start the JavaFX toolkit, which needs a\ndisplay on the Ubuntu GitHub runner.\n\nRun the Linux Gradle check through xvfb-run so JavaFX has a virtual\ndisplay in CI while keeping the normal command for macOS and Windows.\n","fileTypesAndContributionMap":{"other":{"insertions":5,"deletions":0}}}]}],"Luigi-Simon":[{"date":"2026-09-29T00:00:00","commitResults":[{"hash":"0d9cb7c4015aec6fda80e1ff4b3cf24051ad8be0","isMergeCommit":true,"messageTitle":"Merge pull request #62 from Luigi-Simon/add-luigi-simon-photo","messageBody":"Add Luigi Simon\u0027s profile photo","fileTypesAndContributionMap":{}},{"hash":"1e5529488cb8e5d9b77303440896373c071d0a12","isMergeCommit":false,"messageTitle":"Update Luigi Simon\u0027s AboutUs details","messageBody":"AboutUs does not list Luigi Simon or his project responsibilities.\n\nAdd his profile, GitHub link, and documentation role so the team page reflects the current team.\n","fileTypesAndContributionMap":{"docs":{"insertions":9,"deletions":0}}}]},{"date":"2026-09-30T00:00:00","commitResults":[{"hash":"b4916895a714a5eea91523826ed3e1d759ceb867","isMergeCommit":false,"messageTitle":"Update README build status badge","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":1,"deletions":1}}},{"hash":"194a4f45dfc85b620ae8089118f4b409b430d970","isMergeCommit":false,"messageTitle":"Acknowledge AddressBook-Level3 source","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":5,"deletions":0}}}]},{"date":"2026-10-01T00:00:00","commitResults":[{"hash":"8286cc52b77d24a896648c53d9bc4c1c3cc35905","isMergeCommit":false,"messageTitle":"Update README for TAssist","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":23,"deletions":12}}}]},{"date":"2026-10-07T00:00:00","commitResults":[{"hash":"d0d7d7530bd0fb8fe4a802eba98630a10acfba4c","isMergeCommit":false,"messageTitle":"Add alphabetical person name comparator","messageBody":"Prepare name ordering for the list-by-class feature without changing Person records or the displayed list yet.\n\nCompare names ignoring case, then use original spelling to break ties. Add focused tests for ordering, equal names, null inputs, and comparison consistency.\n\nRefs #103\n","fileTypesAndContributionMap":{"functional-code":{"insertions":29,"deletions":0},"test-code":{"insertions":92,"deletions":0}}}]},{"date":"2026-10-08T00:00:00","commitResults":[{"hash":"225d5f4a253b858109188bfd71c348732515389c","isMergeCommit":true,"messageTitle":"Merge pull request #102 from LeeWenKang-NUS/branch-Skeleton-AcademicClassList","messageBody":"Add skeleton academic class list","fileTypesAndContributionMap":{}},{"hash":"36ab17a452430d6d18b6044594f5830795af9d4e","isMergeCommit":true,"messageTitle":"Merge pull request #105 from Luigi-Simon/103-list-by-class","messageBody":"Add alphabetical person name comparator","fileTypesAndContributionMap":{}},{"hash":"5299dbe0f48f29254454562ef15f5359b571f36d","isMergeCommit":true,"messageTitle":"Merge pull request #92 from luyao-111/w8","messageBody":"Update user stories in DG","fileTypesAndContributionMap":{}}]}]},"authorFileTypeContributionMap":{"Aster0":{"docs":13,"functional-code":18,"test-code":9},"luyao-11