[{"path":"README.md","fileType":"docs","lines":[{"lineNumber":1,"author":{"gitId":"-"},"content":"[![CI Status](https://github.com/AY2627S1-CS2103T-T16-2/tp/workflows/Java%20CI/badge.svg)](https://github.com/AY2627S1-CS2103T-T16-2/tp/actions)","lastModifiedDate":"2026-09-13T16:11:49","isFullCredit":false},{"lineNumber":2,"author":{"gitId":"-"},"content":"[![codecov](https://codecov.io/gh/AY2627S1-CS2103T-T16-2/tp/branch/master/graph/badge.svg)](https://codecov.io/gh/AY2627S1-CS2103T-T16-2/tp)","lastModifiedDate":"2026-09-13T16:11:49","isFullCredit":false},{"lineNumber":3,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2020-05-23T01:10:16","isFullCredit":false},{"lineNumber":4,"author":{"gitId":"ooixs"},"content":"# TuitionBook","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":5,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":6,"author":{"gitId":"-"},"content":"![Ui](docs/images/Ui.png)","lastModifiedDate":"2020-05-23T01:10:16","isFullCredit":false},{"lineNumber":7,"author":{"gitId":"-"},"content":"","lastModifiedDate":"2020-05-23T01:10:16","isFullCredit":false},{"lineNumber":8,"author":{"gitId":"ooixs"},"content":"**TuitionBook is a desktop address book for private tutors.** Every student comes with a guardian who pays and a home address to travel to. TuitionBook keeps student and guardian contacts linked and grouped by level and subject, so the tutor can reach the right person and find the right address quickly.","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":9,"author":{"gitId":"ooixs"},"content":"","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":10,"author":{"gitId":"ooixs"},"content":"It is optimised for tutors who prefer typing: while it has a GUI, most interactions happen through a Command Line Interface (CLI), so frequent tasks can be done faster than with a mouse.","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":11,"author":{"gitId":"ooixs"},"content":"","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":12,"author":{"gitId":"ooixs"},"content":"## Features","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":13,"author":{"gitId":"ooixs"},"content":"","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":14,"author":{"gitId":"ooixs"},"content":"* Add, edit, find, list and delete contacts","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":15,"author":{"gitId":"ooixs"},"content":"* Mark each contact as a **student** or a **guardian**","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":16,"author":{"gitId":"ooixs"},"content":"* **Link** a guardian to a student (one guardian per student; a guardian may have several students, e.g. siblings)","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":17,"author":{"gitId":"ooixs"},"content":"* Look up a student and see their guardian\u0027s contact details in one step","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":18,"author":{"gitId":"ooixs"},"content":"* Link-aware deletion, so the data never points at a contact that no longer exists","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":19,"author":{"gitId":"ooixs"},"content":"* Data is saved automatically after every change and reloaded on startup","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":20,"author":{"gitId":"ooixs"},"content":"","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":21,"author":{"gitId":"ooixs"},"content":"## Getting started","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":22,"author":{"gitId":"ooixs"},"content":"","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":23,"author":{"gitId":"ooixs"},"content":"* Requires Java `25` or above installed on your computer.","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":24,"author":{"gitId":"ooixs"},"content":"* Download the latest `.jar` file from the [Releases](https://github.com/AY2627S1-CS2103T-T16-2/tp/releases) page and run it with `java -jar \u003cfilename\u003e.jar`.","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":25,"author":{"gitId":"ooixs"},"content":"* See the [User Guide](https://ay2627s1-cs2103t-t16-2.github.io/tp/UserGuide.html) for a quick start and the full list of commands.","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":26,"author":{"gitId":"ooixs"},"content":"","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":27,"author":{"gitId":"ooixs"},"content":"## Documentation","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":28,"author":{"gitId":"ooixs"},"content":"","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":29,"author":{"gitId":"ooixs"},"content":"* [Product website](https://ay2627s1-cs2103t-t16-2.github.io/tp/)","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":30,"author":{"gitId":"ooixs"},"content":"* [User Guide](https://ay2627s1-cs2103t-t16-2.github.io/tp/UserGuide.html)","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":31,"author":{"gitId":"ooixs"},"content":"* [Developer Guide](https://ay2627s1-cs2103t-t16-2.github.io/tp/DeveloperGuide.html)","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":32,"author":{"gitId":"ooixs"},"content":"* [About Us](https://ay2627s1-cs2103t-t16-2.github.io/tp/AboutUs.html)","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":33,"author":{"gitId":"ooixs"},"content":"","lastModifiedDate":"2026-10-01T14:15:42","isFullCredit":false},{"lineNumber":34,"author":{"gitId":"ooixs"},"content":"## Acknowledgements","l