c6fb8a02767c8d77058585f7b0b8269","isMergeCommit":true,"messageTitle":"Merge pull request #59 from ooixs/model-foundation","messageBody":"Add model foundation for roles and guardian links","fileTypesAndContributionMap":{}},{"hash":"7f2a378f82a4384a917030e448acded2f7f1072d","isMergeCommit":false,"messageTitle":"Add role filter to list command","messageBody":"`list` previously showed every contact with no way to narrow a long\nmixed list. Support `list r/ROLE` to show only students or only\nguardians; bare `list` still clears the filter. Extraneous preamble\narguments are now rejected instead of silently ignored, and the UG\u0027s\nclaim that `list` ignores extra parameters is removed to match.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":134,"deletions":4},"docs":{"insertions":1,"deletions":1},"test-code":{"insertions":179,"deletions":1}}},{"hash":"4303d3c0c0d9bbaff0ea3a3cfd119fd8be9419cc","isMergeCommit":false,"messageTitle":"Update exit message product name and polish help/exit UG sections","messageBody":"The exit acknowledgement still said \"Address Book\"; rename it to\nTuitionBook. Document the F1/menu routes to the help window and the\nneed for an internet connection to open the linked guide, and note in\nthe exit section that data is always saved beforehand.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":1},"docs":{"insertions":5,"deletions":2}}},{"hash":"a5ae4cbb1c73834aa7ebaedd88e9ad13ef7e0451","isMergeCommit":false,"messageTitle":"Update ListCommandTest.java","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":12,"deletions":0}}}]},{"date":"2026-10-04T00:00:00","commitResults":[{"hash":"4dfbf88021779b5c41d0edb2ab9bbe2b0663eb57","isMergeCommit":false,"messageTitle":"Address review comments on list role filter","messageBody":"Reject null in PersonHasRolePredicate at construction, drop a spurious\nthrows clause in the parser test, and decouple the role-filter tests\nfrom the roles of TypicalPersons so they survive fixture changes. Also\ncover ListCommand#toString in both modes for patch coverage.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":6,"deletions":0},"test-code":{"insertions":33,"deletions":11}}},{"hash":"73240d4ddcea0229fbb5632fe751b819bdeed75d","isMergeCommit":false,"messageTitle":"Add AGENTS.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":468,"deletions":0}}},{"hash":"0e4c53a41187a0e224c581721138ff5f3bbb9e7a","isMergeCommit":false,"messageTitle":"Update AGENTS.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":553,"deletions":462}}},{"hash":"afeabed24c340485b3e49149b301eb50b0f5cca2","isMergeCommit":false,"messageTitle":"Update AGENTS.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":48,"deletions":3}}},{"hash":"676ac66657a3fcb2626c2614a4e21246e376d440","isMergeCommit":false,"messageTitle":"Update AGENTS.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":60,"deletions":53}}},{"hash":"09ca1d46e8e4ccae2bfcd4f0c01f81286468064b","isMergeCommit":false,"messageTitle":"Update AGENTS.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":8,"deletions":6}}},{"hash":"8742f7f684b76ef1e9cd7b90d0662ecb0ef42404","isMergeCommit":false,"messageTitle":"Update AGENTS.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":156,"deletions":599}}},{"hash":"572f05e5cf21c4687b6f65879143ebc0dd668d07","isMergeCommit":false,"messageTitle":"Update AGENTS.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":11,"deletions":2}}},{"hash":"eab7f229252ab1bd3f316760f3b0cdc725bbc940","isMergeCommit":false,"messageTitle":"Update AGENTS.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":3,"deletions":2}}},{"hash":"ae3e05d4bed92a5c5dcf4ed985716fd2571ca346","isMergeCommit":true,"messageTitle":"Merge pull request #64 from ooixs/add-agents","messageBody":"Add AGENTS.md","fileTypesAndContribut