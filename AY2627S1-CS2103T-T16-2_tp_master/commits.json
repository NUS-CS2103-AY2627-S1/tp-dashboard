d9bbaff0ea3a3cfd119fd8be9419cc","isMergeCommit":false,"messageTitle":"Update exit message product name and polish help/exit UG sections","messageBody":"The exit acknowledgement still said \"Address Book\"; rename it to\nTuitionBook. Document the F1/menu routes to the help window and the\nneed for an internet connection to open the linked guide, and note in\nthe exit section that data is always saved beforehand.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":1},"docs":{"insertions":5,"deletions":2}}},{"hash":"a5ae4cbb1c73834aa7ebaedd88e9ad13ef7e0451","isMergeCommit":false,"messageTitle":"Update ListCommandTest.java","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":12,"deletions":0}}}]},{"date":"2026-10-04T00:00:00","commitResults":[{"hash":"4dfbf88021779b5c41d0edb2ab9bbe2b0663eb57","isMergeCommit":false,"messageTitle":"Address review comments on list role filter","messageBody":"Reject null in PersonHasRolePredicate at construction, drop a spurious\nthrows clause in the parser test, and decouple the role-filter tests\nfrom the roles of TypicalPersons so they survive fixture changes. Also\ncover ListCommand#toString in both modes for patch coverage.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":6,"deletions":0},"test-code":{"insertions":33,"deletions":11}}},{"hash":"73240d4ddcea0229fbb5632fe751b819bdeed75d","isMergeCommit":false,"messageTitle":"Add AGENTS.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":468,"deletions":0}}},{"hash":"0e4c53a41187a0e224c581721138ff5f3bbb9e7a","isMergeCommit":false,"messageTitle":"Update AGENTS.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":553,"deletions":462}}},{"hash":"afeabed24c340485b3e49149b301eb50b0f5cca2","isMergeCommit":false,"messageTitle":"Update AGENTS.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":48,"deletions":3}}},{"hash":"676ac66657a3fcb2626c2614a4e21246e376d440","isMerg