sMergeCommit":false,"messageTitle":"Implement TutorRoster student deletion","messageBody":"Use displayed indices, show student-specific feedback, and restore the\ncomplete remaining roster after successful deletion.\n\nAdd regression tests and update the user and developer guides.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":20,"deletions":17},"docs":{"insertions":208,"deletions":13},"test-code":{"insertions":102,"deletions":28}}}]},{"date":"2026-10-14T00:00:00","commitResults":[{"hash":"24c199a0d882844ce983c607d4b2e7fca4daa576","isMergeCommit":true,"messageTitle":"Merge pull request #46 from dionhjx/branch-AddStudent","messageBody":"Add student command with validation, duplicate detection, and safe saving. \n\nResolve whitespace duplicate issue.","fileTypesAndContributionMap":{}}]}],"timthedev07":[{"date":"2026-10-01T00:00:00","commitResults":[{"hash":"d06f7d096a34539c5428ca78e0c192f856d82c6c","isMergeCommit":true,"messageTitle":"Merge pull request #10 from dionhjx/add-dion-photo","messageBody":"Add Dion\u0027s profile photo","fileTypesAndContributionMap":{}},{"hash":"3b1d5f244da7f61efa9a3bb812e504d6f69bf19b","isMergeCommit":false,"messageTitle":"Replace John Doe with Bao Xiyu in AboutUs.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":5,"deletions":6}}}]},{"date":"2026-10-02T00:00:00","commitResults":[{"hash":"655d67ceb0f38814f7d5a5d10a2cb13c594574a4","isMergeCommit":true,"messageTitle":"Merge pull request #13 from Jax0312/branch-aboutus","messageBody":"Update AboutUs.md for Jaxon","fileTypesAndContributionMap":{}},{"hash":"ac77a5b1d42a7cdac5138458c441914b791df901","isMergeCommit":false,"messageTitle":"Document use cases for student management","messageBody":"Added detailed use cases for managing students in TutorRoster, including adding, listing, finding, deleting, and restoring student records, along with their respective extensions.","fileTypesAndContributionMap":{"docs":{"insertions":151,"deletions":1}}}]},{"date":"2026-10-06T00:00:00","commitResults":[{"hash":"1591b5d934c6063e5a48b657988ed691841c517d","isMergeCommit":true,"messageTitle":"Merge pull request #32 from dionhjx/add-glossary","messageBody":"Add glossary to developer guide","fileTypesAndContributionMap":{}},{"hash":"54307a3effa43bc46561dbeb9d25433bbe12e507","isMergeCommit":true,"messageTitle":"Merge pull request #30 from Jax0312/branch-readme","messageBody":"Update README","fileTypesAndContributionMap":{}},{"hash":"5cec7551f5d650d3e5d3025213301468ae2ce43f","isMergeCommit":true,"messageTitle":"Merge pull request #26 from lohjn/25-update-NFRs","messageBody":"Document TutorRoster non-functional requirements","fileTypesAndContributionMap":{}},{"hash":"2c272886c3cf93d38fc191b9775f50e2b6e4502b","isMergeCommit":true,"messageTitle":"Merge pull request #24 from timthedev07/timthedev07-usecases","messageBody":"Document use cases for student management","fileTypesAndContributionMap":{}},{"hash":"b8d5f785ae42570c5065df5b08c40d814b495887","isMergeCommit":false,"messageTitle":"Refactor UI to align with mockup","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":502,"deletions":450},"docs":{"insertions":121,"deletions":0}}}]},{"date":"2026-10-08T00:00:00","commitResults":[{"hash":"beb2aecf0e5f6566f19a498d66daf77bd7b09198","isMergeCommit":true,"messageTitle":"Merge pull request #39 from Jax0312/branch-disable-extra","messageBody":"MVP Feature: Disable unused command","fileTypesAndContributionMap":{}}]},{"date":"2026-10-14T00:00:00","commitResults":[{"hash":"3f67662671de2d59d6782c07c8b2d852ebf1c27e","isMergeCommit":true,"messageTitle":"Merge pull request #54 from Jax0312/branch-hotkey","messageBody":"Feat: Add CommandField hotkey","fileTypesAndContributionMap":{}}]},{"date":"2026-10-15T00:00:00","commitResults":[{"hash":"2218ec5a59469839f46cfb18640d1d31b07eb20b","isMergeCommit":false,"messageTitle":"Add command history navigation","messageBody":"The command field does not retain previously entered commands, so keyboard-heavy users must retype repeated operations.\n\nAdd session-only history navigation with the up and down arrow keys, preserve unfinished drafts, and avoid consecutive duplicate entries. Document the new shortcuts and cover the navigation behaviour with focused unit tests.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":112,"deletions":1},"docs":{"insertions":2,"deletions":0},"test-code":{"insertions":41,"deletions":0}}},{"hash":"353c5d8c730f9853726c7e65916078f652da5704","isMergeCommit":false,"messageTitle":"Expand command history tests","messageBody":"The initial command history tests cover the main navigation path but not boundary or empty-history behaviour.\n\nAdd tests for empty history, navigation limits, draft preservation, reset behaviour, and non-consecutive duplicates. Preserve typed command text when the down arrow is pressed before any history exists.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":4,"deletions":3},"test-code":{"insertions":73,"deletions":4}}},{"hash":"93c856175c3700d5610f7e9f77cd1b9fc2e72b91","isMergeCommit":false,"messageTitle":"Cover CommandBox interactions","messageBody":"CommandBox had no direct unit coverage, leaving command execution, failure feedback, focus, and keyboard history handling unverified.\n\nAdd JavaFX-thread tests for successful and empty commands, command and parse failures, error-style reset behaviour, modifier handling, history navigation, focus, and caret placement. Exercise the installed key handler directly to keep the tests deterministic.\n","fileTypesAndContributionMap":{"test-code":{"insertions":251,"deletions":0}}},{"hash":"2801df8d3a7907e7f2cfbc100e95bb1c5639c77a","isMergeCommit":false,"messageTitle":"Replace JavaFX tests with pure tests","messageBody":"CommandBox UI tests require a graphical display and fail when Ubuntu runs the suite headlessly.\n\nRemove the JavaFX-dependent tests and expand the no-UI CommandHistory tests to cover first insertion, intermediate navigation, history boundaries, draft restoration, and duplicate handling. Keep the coverage checks compatible with headless environments.\n","fileTypesAndContributionMap":{"test-code":{"insertions":28,"deletions":251}}},{"hash":"3f8d2648c6f8156bc5d39975d8130439e8c9fd45","isMergeCommit":false,"messageTitle":"Extract testable command box logic","messageBody":"CommandBox behaviour depended directly on JavaFX controls, so its tests required a graphical display and were unreliable on headless Ubuntu runners.\n\nMove command execution, history navigation, modifier handling, and history resets into a pure collaborator. Keep CommandBox as a thin JavaFX adapter and cover the extracted behaviour with display-independent unit tests.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":92,"deletions":14},"test-code":{"insertions":122,"deletions":0}}},{"hash":"5c8697a7bb2feb2cea7b13eecbb3cc7f5f6fe400","isMergeCommit":false,"messageTitle":"Exclude JavaFX adapter from coverage","messageBody":"Keep headless coverage focused on the command-box behaviour that can be\nexercised without starting the JavaFX toolkit. Exclude the UI adapter and\nits nested executor from both JaCoCo reports while documenting that the\nbehaviour is covered by CommandBoxLogicTest.\n","fileTypesAndContributionMap":{"other":{"insertions":16,"deletions":3}}}]}]},"authorFileTypeContributionMap":{"sarinake":{"docs":16,"functional-code":72,"test-code":108},"dionhjx":{"docs":88,"functional-code":550,"test-code":363},"Jax0312":{"docs":52,"functional-code":144,"test-code":19},"lohjn":{"docs":225,"functional-code":21,"test-code":102},"timthedev07":{"docs":273,"functional-code":650,"test-code":260,"other":16}},"authorContributionVariance":{"sarinake":36330.785,"dionhjx":63756.523,"Jax0312":4725.6875,"lohjn":5226.7144,"timthedev07":72412.74},"authorDisplayNameMap":{"sarinake":"CS2103T-F14-2 KE S..XUAN","dionhjx":"CS2103T-F14-2 DION..G XI","Jax0312":"CS2103T-F14-2 JAXO..XUAN","lohjn":"CS2103T-F14-2 LOH .. NIN","timthedev07":"CS2103T-F14-2 BAO ..XIYU"}}
