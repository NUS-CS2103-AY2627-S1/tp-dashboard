,"fileTypesAndContributionMap":{}},{"hash":"2d31282da063f4b67f77504b7e86c4a5501f5796","isMergeCommit":true,"messageTitle":"Merge pull request #15 from MeowyMacMeowza/add-JoonZen-about","messageBody":"Add details to AboutUs.md","fileTypesAndContributionMap":{}},{"hash":"2d6a7915be0e0c00cec070bf94405406af3df37e","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into update-Zewei-AboutUs","messageBody":"","fileTypesAndContributionMap":{}}]},{"date":"2026-10-08T00:00:00","commitResults":[{"hash":"61a41cae3b2a870a9138210c5a313c3d4826e74f","isMergeCommit":false,"messageTitle":"Update side-wide settings","messageBody":"","fileTypesAndContributionMap":{"other":{"insertions":2,"deletions":2}}},{"hash":"73a46f0b8bbfbb905c603c83a743be9e2bf58188","isMergeCommit":false,"messageTitle":"Acknowledge code source in README.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":2,"deletions":1}}},{"hash":"0714eb110ec58db4fce0aaf232af85eab214af7d","isMergeCommit":false,"messageTitle":"Update README to match project details","messageBody":"The README currently describes the AddressBook sample project.\n\nReplace sample content with LinkedOut\u0027s purpose and project direction.\nDistinguish implemented functionality from planned recruitment features.\n","fileTypesAndContributionMap":{"docs":{"insertions":38,"deletions":12}}},{"hash":"7d5fff0c73466f35176e8beef2005d1d6de40bc0","isMergeCommit":false,"messageTitle":"Update landing page for LinkedOut","messageBody":"The landing page describes AddressBook and links to its CI status.\n\nIntroduce LinkedOut\u0027s target users and recruitment workflow, clarify\nwhich features are under development, and point the CI badge to our\nrepository. Keep the UI image below the badge and retain upstream\nattribution.\n","fileTypesAndContributionMap":{"docs":{"insertions":15,"deletions":8}}},{"hash":"a36756f0b5558a0cfd8b175f9f39e74ac3eb1267","isMergeCommit":false,"messageTitle":"Update developer guide glossary for LinkedOut","messageBody":"The glossary contains terminology from the AddressBook template\nthat does not reflect LinkedOut\u0027s applicant tracking features.\n\nReplace the private contact detail entry with definitions for\napplicants, applications, job descriptions, statuses, and indices.\nBase these definitions on the official Feature Specification tab\nand retain Mainstream OS for legacy compatibility.\n","fileTypesAndContributionMap":{"docs":{"insertions":5,"deletions":1}}},{"hash":"8e3366d74ba3d7f1a688c1dde22bfe2589834191","isMergeCommit":false,"messageTitle":"Clean up About Us page","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":1,"deletions":22}}},{"hash":"be3ba96cdd2cacf25c759586d318917399a5ed2c","isMergeCommit":true,"messageTitle":"Merge pull request #50 from cewau/update-Zewei-AboutUs","messageBody":"Clean up About Us page","fileTypesAndContributionMap":{}},{"hash":"d04818cd0813f8fa4d23aab20366a82d5f5b06e1","isMergeCommit":false,"messageTitle":"Add initial applicant view command","messageBody":"LinkedOut needs a command to view an applicant, but the parser has no\nview route and the dedicated details panel has not been built yet.\n\nAdd view INDEX using the existing index parser and command result\ndisplay to show the applicant\u0027s name and email. Preserve the displayed\nlist and its filter, and report invalid indices with a usage hint or\nvalid range.\n\nKeep this first slice independent of hyphen-option parsing and model\nchanges so the details panel can be introduced in a later PR.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":104,"deletions":0},"docs":{"insertions":16,"deletions":0},"test-code":{"insertions":127,"deletions":0}}},{"hash":"c627089bd7b00eed6cc6682a67d7a7ed00b94086","isMergeCommit":true,"messageTitle":"Merge pull request #40 from BirdsArentReal/branch-W7-DG-AddUserProfile","messageBody":"W7-C: Update DG -- Subissue 1","fileTypesAndContributionMap":{}},{"hash":"52491673456964e24a4349488fcbe8496310c20d","isMergeCommit":false,"messageTitle":"Add ViewCommand assertion","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":0}}}]},{"date":"2026-10-15T00:00:00","commitResults":[{"hash":"57117e86900fa86aef5f47be38b1bff64aa08ccf","isMergeCommit":false,"messageTitle":"Add applicant selection to command results","messageBody":"Command results only carry feedback and help or exit actions, so the\nUI cannot identify an applicant to select after a command succeeds.\n\nAdd an optional applicant selection to command results while preserving\nthe existing defaults. Cover the new result state in constructor,\nequality, and hash code tests.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":28,"deletions":2},"test-code":{"insertions":46,"deletions":1}}},{"hash":"340f00fdddb2ae3dadc1c62c26d9e40972ebc33a","isMergeCommit":false,"messageTitle":"Connect view commands to applicant details","messageBody":"The view command prints contact details without updating the selected\napplicant, leaving the detail panel out of sync with the command.\n\nSelect and scroll to the requested applicant, and show a short\nconfirmation alongside the detail panel. Preserve filtered list indices\nand failed-command selections, with regression coverage for both.\n\nFixes #68\n","fileTypesAndContributionMap":{"functional-code":{"insertions":13,"deletions":4},"test-code":{"insertions":118,"deletions":5}}},{"hash":"a27f9d57159925f9704cb1a98fcf54912239c562","isMergeCommit":false,"messageTitle":"Document applicant selection with view","messageBody":"The view guide describes name and email output in the command result\ndisplay, which no longer matches the applicant detail workflow.\n\nDescribe list selection, scrolling, and the details shown in the panel.\nInclude an example that selects an applicant from filtered results.\n","fileTypesAndContributionMap":{"docs":{"insertions":6,"deletions":2}}},{"hash":"3a4089e3dce6ee6be133370917fd08d470b24954","isMergeCommit":false,"messageTitle":"Migrate add to hyphen option syntax","messageBody":"The add command uses slash prefixes even though a shared tokenizer\nsupports hyphen options.\n\nUse that tokenizer to accept short and long aliases for all four\nrequired person fields and reject the legacy add syntax. Preserve field\nvalidation and edit syntax, and update usage hints and test fixtures.\n\nCover aliases, malformed options, legacy input, and saving a person\nthrough the logic layer.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":22,"deletions":36},"test-code":{"insertions":113,"deletions":129}}},{"hash":"d02a98df53cb6cba428a64ea3b0c1310c9cba5c2","isMergeCommit":false,"messageTitle":"Document the new add command syntax","messageBody":"The User Guide still shows slash syntax and tag options for add, which\nno longer match the command parser.\n\nUpdate the quick start, command reference, examples, and summary to use\nhyphen options. Explain required fields, long aliases, and validation\nrules so users can construct valid add commands.\n","fileTypesAndContributionMap":{"docs":{"insertions":26,"deletions":11}}},{"hash":"1087f3e440301974f612b12f07507bd0daff7379","isMergeCommit":false,"messageTitle":"Unlink edit command from MVP user interface","messageBody":"The edit command remains reachable and documented even though editing\napplicants is outside the MVP.\n\nRemove edit from command dispatch and user-facing documentation.\nPreserve its implementation and unit tests so it can return later, and\nkeep UI update coverage through direct model changes.\n\nFixes #75\n","fileTypesAndContributionMap":{"functional-code":{"insertions":0,"deletions":2},"docs":{"insertions":1,"deletions":16},"test-code":{"insertions":58,"deletions":28}}},{"hash":"52dcc0c7e2fa89a4ae7968ff2e2a0849918fed3a","isMergeCommit":false,"messageTitle":"Point help window to LinkedOut user guide","messageBody":"The help window directs users to the AddressBook guide, which describes\ncommands that may differ from LinkedOut.\n\nUse the LinkedOut project guide so the displayed link and copied URL\nmatch this application.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":1}}},{"hash":"3224615271dc2ddc1297f555f62d89c0954a85f0","isMergeCommit":true,"messageTitle":"Merge pull request #86 from cewau/branch-W9-UpdateHelpLink","messageBody":"Point help window to LinkedOut user guide","fileTypesAndContributionMap":{}},{"hash":"e6abb364eb165709bdc3e75c653826c0745f62f8","isMergeCommit":true,"messageTitle":"Merge master into the command syntax branch","messageBody":"Master removes person addresses while this branch introduces hyphen\noptions for add, so their parsers, fixtures, and documentation conflict.\n\nPreserve master\u0027s address removal and keep short and long aliases for\nname, phone, and email. Update the affected tests and guide to use the\nthree-field add command and reject removed address options.\n\nValidate with Java 25 using Gradle check and coverage, including the\nJavaFX integration tests under Xvfb.\n","fileTypesAndContributionMap":{}}]}],"hytradebridge":[{"date":"2026-10-01T00:00:00","commitResults":[{"hash":"92aadbd07cb37cb2af4e53f68a24605f41739601","isMergeCommit":false,"messageTitle":"Add my photo","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":12,"deletions":12}}},{"hash":"f1eaf323f1bc84c43ddf81f29adae6a04d046572","isMergeCommit":true,"messageTitle":"Merge pull request #12 from hytradebridge/add_my_photo","messageBody":"Add Juncheng\u0027s photo","fileTypesAndContributionMap":{}},{"hash":"a4752cc2bad74d6f49160349d68e67b2081e3416","isMergeCommit":false,"messageTitle":"Add my details to AboutUs","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":0,"deletions":1}}},{"hash":"96c738c968a18d03ada86354ce80c849e977cce4","isMergeCommit":true,"messageTitle":"Merge pull request #17 from hytradebridge/add_my_photo","messageBody":"Add my details to AboutUs","fileTypesAndContributionMap":{}}]