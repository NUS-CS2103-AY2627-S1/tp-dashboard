rsionedAddressBook","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":324,"deletions":0}}}]},{"date":"2026-10-21T00:00:00","commitResults":[{"hash":"b799438a099d71b2adfce291d3f5a51888da1458","isMergeCommit":false,"messageTitle":"Improve VersionedAddressBookTest naming and branch coverage","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":6,"deletions":4}}}]}],"chester-wong-33":[{"date":"2026-09-30T00:00:00","commitResults":[{"hash":"71fb2b37d1471dee9dc193440929e52109fe7fea","isMergeCommit":false,"messageTitle":"Add Chester\u0027s GitHub","messageBody":"On the AboutUs.md, Chester\u0027s GitHub is not available\nin the document. Let\u0027s add that for future reference.\n","fileTypesAndContributionMap":{"docs":{"insertions":2,"deletions":2}}},{"hash":"27541a305a3a0d441170979b4e7ffaf3e6af4582","isMergeCommit":true,"messageTitle":"Merge pull request #7 from Kimame04/add-kimame04-photo","messageBody":"Add Kieran\u0027s profile photo and homepage","fileTypesAndContributionMap":{}},{"hash":"0c4b3f55f48b39b9647a54a51e1bceb634dc42bb","isMergeCommit":true,"messageTitle":"Merge pull request #14 from chiacxx/add-chiacxx-photo","messageBody":"Add Xavier\u0027s photo","fileTypesAndContributionMap":{}},{"hash":"2623a759f27780eac01ae5a2dfbc9e2a0101b4c6","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into add-chester-wong-33-photo","messageBody":"# Conflicts:\n#\tdocs/AboutUs.md\n","fileTypesAndContributionMap":{}}]},{"date":"2026-10-01T00:00:00","commitResults":[{"hash":"5fde18b71101b2d5b68193d03f5f027353dc6a8d","isMergeCommit":true,"messageTitle":"Merge pull request #24 from chiacxx/update-developer-guide-use-cases","messageBody":"Update the Developer Guide Use Cases","fileTypesAndContributionMap":{}},{"hash":"59ca6a12f208c6afb7ae30e78287c4c9a4e3db89","isMergeCommit":false,"messageTitle":"Add target, value proposition and user stories","messageBody":"Currently, the DeveloperGuide.md is quite general for\nAddressBook rather than KeyBossWarriorsPro. Let\u0027s change\nthat to be more specific to our project, with the target\nprofile, value proposition and user stories that we\ndiscussed earlier.\n","fileTypesAndContributionMap":{"docs":{"insertions":43,"deletions":15}}}]},{"date":"2026-10-09T00:00:00","commitResults":[{"hash":"6ea7c3c2d0d6b20928515c32d7a96ac57d26d0d7","isMergeCommit":false,"messageTitle":"Add delay to exit","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":14,"deletions":1}}},{"hash":"a4703eeab6167d81d2ae92b35a2d2a1064dbdc89","isMergeCommit":false,"messageTitle":"Add UI integration test for delayed exit","messageBody":"Verify exit displays the acknowledgement, disabled command input\nand keeps the window open briefly before closing.\n","fileTypesAndContributionMap":{"test-code":{"insertions":115,"deletions":0}}},{"hash":"fdfa76a5ce64684870ba91da1115e914f6d84520","isMergeCommit":false,"messageTitle":"Handle UnsupportedOperationException in MainWindowTest","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":6,"deletions":0}}},{"hash":"21f1ba7454419d0a7d1c6d0b52dd5946dc75b8d8","isMergeCommit":false,"messageTitle":"Reconfigure gradle.yml","messageBody":"Currently, the UI test in MainWindowTest.java is not run\nby the current CI pipeline on GitHub as there is no graphical\ndisplay configured for the Linux check. This causes the\ncodecov patch coverage to reflect missing coverage.\n\nLet\u0027s change the gradle.yml configuraiton in .github/workflows,\nto allow Linux to test via a virtual display and run the UI test.\nThis allows us to confirm test pass.\n","fileTypesAndContributionMap":{"other":{"insertions":10,"deletions":1}}}]},{"date":"2026-10-11T00:00:00","commitResults":[{"hash":"7c2e18939b11a273d07c4d3c0c4c051f4f6a2169","isMergeCommit":false,"messageTitle":"Modify ExitCommandParser to check extra arguments","messageBody":"Currently, AddressBookParser does not parse additional arguments\nif the exit command is given. Let\u0027s change it so that our ExitCommand\ncan check if extra arguments are given, and if so, provide the new\ndisclaimer when terminating KeyBossWarriorsPro. We do so by adding a\nnew ExitCommandParser and modifying ExitCommand to contain the new\ndisclaimer message when executed.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":36,"deletions":2}}},{"hash":"528d664cd0ae6ba5b2dc90799633c48c23e8b10e","isMergeCommit":false,"messageTitle":"Add unit tests for ExitCommand","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":18,"deletions":2}}},{"hash":"9d3d1d26be43715b820d4dba78b3a34aab97c8dd","isMergeCommit":false,"messageTitle":"Standardize ExitCommand to other commands","messageBody":"Currently, ExitCommand fulfils the contract with ExitCommandParser\nand ExitCommandTest. However, it does not override the toString and\nequal methods that other commands with parsers like DeleteCommand do.\nLet\u0027s override these methods to:\n- maintain consistency\n- provide ease in writing ExitCommandParserTest\n","fileTypesAndContributionMap":{"functional-code":{"insertions":22,"deletions":0}}},{"hash":"638dfe200e0097561a0ec1bce99832282f4a3322","isMergeCommit":false,"messageTitle":"Add tests for ExitCommandParser","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":2,"deletions":2},"test-code":{"insertions":31,"deletions":0}}},{"hash":"73af8869318e75f68d537228b2744ac323f4ce31","isMergeCommit":false,"messageTitle":"Modify UserGuide to explain new exit behavior","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":6,"deletions":2}}},{"hash":"19d25b01dfacf06f27a73f8d5b218c1e76dccc6b","isMergeCommit":false,"messageTitle":"Add toString and equal test in ExitCommand","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":33,"deletions":0}}}]},{"date":"2026-10-13T00:00:00","commitResults":[{"hash":"d62fad12c91c6d148ae4ffff569c7a58ecd205be","isMergeCommit":false,"messageTitle":"Support substring matching for find","messageBody":"Currently, NameContainsKeywordsPredicate only matches whole words\nin contact names. Let\u0027s change to allow case-insensitive substring\nmatching while preserving OR behavior across multiple keywords.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":3,"deletions":1}}},{"hash":"4fceef979ccd7ba7a75d946d7009a6d7299e3220","isMergeCommit":false,"messageTitle":"Update Javadocs and FindCommand\u0027s MESSAGE_USAGE","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":6,"deletions":4}}},{"hash":"0560bdff4f3ab873f44690cfafe5e2988c9364cd","isMergeCommit":false,"messageTitle":"Add tests for substring matching","messageBody":"Add coverage for prefix, middle and suffix matches in name words,\nmixed-case substrings and single-character keywords.\nVerify that multiple keywords preserve OR behavior: names match\nwhen either or both keywords occur, and do not match when none\noccur. Also cover a matching substring among several unrelated\nkeywords.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":0,"deletions":1},"test-code":{"insertions":46,"deletions":1}}},{"hash":"300d4b07d1b6cc6423f0c6d1ceab93b83c5b31d5","isMergeCommit":false,"messageTitle":"Test substring matching in FindCommandTest","messageBody":"Add integration tests verifying that a substring matches multiple\ncontacts and that multiple keywords matching the same contact\nreturn it only once. Assert the expected result counts and ordering.\n","fileTypesAndContributionMap":{"test-code":{"insertions":23,"deletions":0}}},{"hash":"04602fbe36e8fbaca811eb2b8e106d0a7c60d81a","isMergeCommit":false,"messageTitle":"Update UserGuide and DeveloperGuide","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":8,"deletions":4}}}]},{"date":"2026-10-14T00:00:00","commitResults":[{"hash":"4a2aa566027df82b7b12e5a41b48b3f1cc69c320","isMergeCommit":true,"messageTitle":"Merge pull request #54 from Kimame04/45-refa