ontributionMap":{}}]},{"date":"2026-10-12T00:00:00","commitResults":[{"hash":"bebba67de6fb5e81f0805d8da40e2163a0df84e9","isMergeCommit":true,"messageTitle":"Merge pull request #44 from Kimame04/43-update-ug-role","messageBody":"Update User Guide and RoleTest for Role field","fileTypesAndContributionMap":{}},{"hash":"dad07736de261711dd199507ce32a6fa0e44873e","isMergeCommit":true,"messageTitle":"Merge pull request #49 from chester-wong-33/add-exit-warning","messageBody":"Add exit warning","fileTypesAndContributionMap":{}}]},{"date":"2026-10-13T00:00:00","commitResults":[{"hash":"1c54efd2e78457fabbd51d287c270e2c3cbddc8d","isMergeCommit":false,"messageTitle":"Improve DELETE validation and user guidance","messageBody":"The DELETE command reports generic errors for malformed and invalid\nindex inputs.\n\nUsers need specific feedback to understand whether the index is missing,\nmalformed, duplicated, or out of range.\n\nHandle DELETE argument validation for missing, extra, non-integer,\nnon-positive, and out of range indexes. Add tests for the new behaviour\nand update the User Guide to document common errors.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":37,"deletions":13},"docs":{"insertions":14,"deletions":6},"test-code":{"insertions":48,"deletions":8}}},{"hash":"f0d6ca63b52a1206aed8692b5cfb45053df90ebb","isMergeCommit":false,"messageTitle":"Refine DELETE validation, terminology, and documentation","messageBody":"The DELETE command documentation and tests do not fully reflect its\ncurrent parsing behaviour and displayed-list semantics.\n\nImprove test coverage and documentation so users and developers receive\nclear, consistent guidance when deleting contacts.\n\nUpdate DELETE parser tests for whitespace-only arguments and single-token\ninvalid input, remove the stale parser-test comment, and standardise\nDELETE messages and documentation to use “contact”.\n\nUpdate the DELETE use case in the Developer Guide to document its\npreconditions, successful flow, empty-list handling, and invalid-index\nerrors.\n\nKeep the documentation and tests aligned with the command’s current\nimplementation, where indexes refer to the currently displayed contact\nlist.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":4,"deletions":4},"docs":{"insertions":14,"deletions":11},"test-code":{"insertions":9,"deletions":8}}},{"hash":"83cd62e5862eccb47be61e7c27e07e80775490dd","isMergeCommit":false,"messageTitle":"Remove trailing whitespace in Developer Guide","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":2,"deletions":2}}}]},{"date":"2026-10-14T00:00:00","commitResults":[{"hash":"d881d836b1d83c91d61d1c79bac107490905519a","isMergeCommit":false,"messageTitle":"Handle out-of-range DELETE indexes for single-contact lists","messageBody":"DELETE currently describes a single displayed contact using the range\n`1-1`, which is awkward for users.\n\nDisplay `valid index: 1` when only one contact is displayed, while\nretaining the range format for lists with multiple contacts.\n\nAdd tests covering both single-contat and multiple-contact out-of-range\nerrors.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":20,"deletions":5},"test-code":{"insertions":8,"deletions":5}}},{"hash":"f01e610dc4fd38dd02c44e12fd820c8b47f38367","isMergeCommit":false,"messageTitle":"Handle ignored arguments in LIST command","messageBody":"The LIST command accepts additional arguments without informing users.\nThis may cause users to assume that arguments such as `list 3` have a\npurpose, such as displaying only the first three contacts. The behaviour\nfor empty address books and search filters is also not clearly\ncommunicated.\n\nAdd a dedicated `ListCommandParser` to detect meaningful additional\narguments, display a warning that they are ignored, reset active search\nfilters, and report when no contacts are available.\n\nTreat whitespace-only arguments as empty input so trailing whitespace\ndoes not trigger a warning. Add command, parser, and end-to-end tests,\nand update the User Guide and Developer Guide to document the behaviour.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":74,"deletions":4},"docs":{"insertions":28,"deletions":6},"test-code":{"insertions":128,"deletions":4}}},{"hash":"2b199ba5ec8d7a6a971e9ccff2197a206ffcf0c7","isMergeCommit":false,"messageTitle":"Add tests for ListCommand equality and string representation","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":41,"deletions":0}}}]},{"date":"2026-10-15T00:00:00","commitResults":[{"hash":"e34314ecf3f3c15eaae8e6ebe664411bddf2bada","isMergeCommit":true,"messageTitle":"Merge pull request #62 from Ken-Tat/branch-refactor-help","messageBody":"Refactor help","fileTypesAndContributionMap":{}},{"hash":"0a06e7593614c332f27738085ef26e292c2fa24b","isMergeCommit":false,"messageTitle":"Improve User Guide documentation and consistency","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":86,"deletions":72}}}]},{"date":"2026-10-19T00:00:00","commitResults":[{"hash":"9ef5caa0a1fadccf1e066f1e30df4cb166dbefe8","isMergeCommit":true,"messageTitle":"Merge pull request #71 from Kimame04/70-reject-extraneous-add-args","messageBody":"Reject unrecognized prefixes in AddCommand","fileTypesAndContributionMap":{}},{"hash":"a9b07797dd1bf52ea6c864857102c7e902a4d333","isMergeCommit":true,"messageTitle":"Merge pull request #73 from Kimame04/72-align-user-facing-branding","messageBody":"Align application name in ExitCommand","fileTypesAndContributionMap":{}},{"hash":"f923dc9d15a5c12320775d48faeb0ceae174c2ce","isMergeCommit":true,"messageTitle":"Merge pull request #79 from chester-wong-33/modify-address-book-phrase-usage","messageBody":"Remove Address Book message usage in ClearCommand","fileTypesAndContributionMap":{}},{"hash":"1ad18c4c88296215654924233bf74e106eb09e93","isMergeCommit":true,"messageTitle":"Merge pull request #80 from chester-wong-33/add-chester-wong-33-intro","messageBod