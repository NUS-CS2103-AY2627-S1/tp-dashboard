{"authorDailyContributionsMap":{"preyjwal":[{"date":"2026-09-30T00:00:00","commitResults":[{"hash":"610fe12f5c081ddbb19ec8972f8db7531eb88ec0","isMergeCommit":false,"messageTitle":"Add Prakash Prajwal\u0027s details to About Us page","messageBody":"The About Us page still lists placeholder team members, one of which\nis \"Johnny Doe\" with a stock photo and GitHub link.\n\nReplace that placeholder with my name, photo and GitHub profile.\nRemove the portfolio link, as the Project Portfolio Page is an\noptional deliverable that has not been opted into yet.\n","fileTypesAndContributionMap":{"docs":{"insertions":3,"deletions":3}}},{"hash":"6f9c6d28bcd528ae248caeead91d394227b486ba","isMergeCommit":true,"messageTitle":"Merge pull request #15 from preyjwal/add-photo","messageBody":"Add Prajwal\u0027s photo","fileTypesAndContributionMap":{}},{"hash":"6ccf2295106ebda40b32c5b347088447e10ccb23","isMergeCommit":false,"messageTitle":"Update Prakash Prajwal\u0027s responsibilities on About Us page","messageBody":"The About Us page still lists the placeholder responsibility \"Data\"\nfor my entry, carried over from the \"Johnny Doe\" template.\n\nReplace it with my actual responsibilities, documentation and the\nStorage component, so the page reflects the team\u0027s division of work.\n","fileTypesAndContributionMap":{"docs":{"insertions":1,"deletions":1}}},{"hash":"bdc30a2cc5978bc5566f501bfaa5b662eeafd09e","isMergeCommit":false,"messageTitle":"Update team contact email on About Us page","messageBody":"The About Us page still shows the template\u0027s contact address,\nseer[at]comp.nus.edu.sg, which does not reach our team.\n\nReplace it with an address the team actually uses.\n","fileTypesAndContributionMap":{"docs":{"insertions":1,"deletions":1}}},{"hash":"4416867ed5bcfe1c6729f8669af711f5e96f9645","isMergeCommit":false,"messageTitle":"Shorten Storage responsibility on About Us page","messageBody":"Teammates list their responsibilities are supposed to be listed by component name alone,\ne.g. \"UI\", without the word \"Component\".\n\nDrop it from my entry\nto match.\n","fileTypesAndContributionMap":{"docs":{"insertions":1,"deletions":1}}}]},{"date":"2026-10-01T00:00:00","commitResults":[{"hash":"63ef2427b6968076ef23fc7b89dce68ceebb1a2b","isMergeCommit":true,"messageTitle":"Merge pull request #27 from HONYIEN/update-honyien-details","messageBody":"docs: Fix Hon Yien\u0027s profile image link","fileTypesAndContributionMap":{}},{"hash":"fe3976adc17ed9e3ba62b3b93fe6a01baf5a42d0","isMergeCommit":false,"messageTitle":"Restore Prakash Prajwal\u0027s entry on About Us page","messageBody":"Prajwal\u0027s entry reverted to the \"Johnny Doe\" placeholder in 0cbd67fb,\nmost likely while a merge conflict was being resolved, so the page\nno longer shows my name, photo or GitHub link.\n\nRestore them. Responsibilities are unaffected and stay as they are.\n","fileTypesAndContributionMap":{"docs":{"insertions":3,"deletions":3}}},{"hash":"80e124edcc305cba5d6a4c697eaee09d899a41db","isMergeCommit":true,"messageTitle":"Merge pull request #28 from preyjwal/update-aboutus","messageBody":"Restore Prakash Prajwal\u0027s entry on About Us page","fileTypesAndContributionMap":{}},{"hash":"b58db44324621eaf8c59c7b2621504f1837ad3fc","isMergeCommit":false,"messageTitle":"Update README to describe PingBook","messageBody":"The README still describes AddressBook-Level3 as a sample project\nfor students, and its CI badge reports se-edu\u0027s build status rather\nthan ours.\n\nRewrite it to describe PingBook: its target user, the commands\nplanned for the first version, and possible later features. Point\nthe CI badge at the team repo, link to the project website\u0027s guides,\nand credit AB3 as the project\u0027s starting point.\n","fileTypesAndContributionMap":{"docs":{"insertions":48,"deletions":11}}},{"hash":"b17f1ef2e411d18e5b494a8f8fed60ecfee9b938","isMergeCommit":true,"messageTitle":"Merge pull request #32 from preyjwal/update-readme","messageBody":"Update the README.md and site-wide settings","fileTypesAndContributionMap":{}}]},{"date":"2026-10-07T00:00:00","commitResults":[{"hash":"bcae44d316e92497e9038a3bd10bf5b2b4b44f51","isMergeCommit":false,"messageTitle":"Save meetings to and load them from the data file","messageBody":"Meetings exist in the model but are not written to addressbook.json,\nso any meetings added are lost when PingBook closes.\n\nAdd JsonAdaptedMeeting to convert meetings to and from JSON, storing\nthe date and times in the same DD/MM/YYYY and HHMM formats users type\nso the file stays human-editable. JsonSerializableAddressBook now\nsaves the meeting list and loads it back, rejecting invalid fields\nand duplicate meetings the same way it does for persons.\n\nData files from before this change have no \"meetings\" key; these are\ntreated as having no meetings, so existing data still loads.\n\nMake MeetingName\u0027s name field public so JsonAdaptedMeeting can read\nit, matching how JsonAdaptedPerson reads Name\u0027s public fullName.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":109,"deletions":3}}}]},{"date":"2026-10-08T00:00:00","commitResults":[{"hash":"c43fcbaf1ed8c11975d127544418b1015ddc8041","isMergeCommit":false,"messageTitle":"Rename client commands to addc, deletec and listc","messageBody":"The add, delete and list commands use AB3\u0027s generic names. PingBook\nwill also manage meetings, with addm, deletem and listm, so the\ngeneric names no longer make clear which list a command acts on.\n\nRename them to addc, deletec and listc.\n\nLogicManagerTest hard-coded \"delete 9\", which would now fail as an\nunknown command instead of testing the invalid-index error. Build it\nfrom DeleteCommand.COMMAND_WORD so it follows future renames.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":3,"deletions":3},"test-code":{"insertions":2,"deletions":1}}},{"hash":"91bbda0cec0d4c656775dbc9758751c639ad6a7d","isMergeCommit":true,"messageTitle":"Merge pull request #54 from preyjwal/update-storage-meetings","messageBody":"Update storage for meetings","fileTypesAndContributionMap":{}}]}],"kaih4n":[{"date":"2026-09-30T00:00:00","commitResults":[{"hash":"43fb0e14d83666d2f975847a7248cad9336bd9ab","isMergeCommit":false,"messageTitle":"Update AboutUs.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":3,"deletions":4}}},{"hash":"0cbd67fbae33f76dd1f2f2c0b1f9382934db2b3b","isMergeCommit":false,"messageTitle":"Update AboutUs.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":12,"deletions":13}}},{"hash":"2eac869c805e8d002f739b32c125d886be6ed96d","isMergeCommit":false,"messageTitle":"Update AboutUs.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":2,"deletions":1}}}]},{"date":"2026-10-01T00:00:00","commitResults":[{"hash":"b9ed28654fcbeb0c71dcc8204a051b2505e66f0f","isMergeCommit":false,"messageTitle":"Add use cases 11-21 to DeveloperGuide.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":218,"deletions":12}}},{"hash":"07f8bba5e460887164e71534ab4f708adacad69a","isMergeCommit":false,"messageTitle":"Edit use case 13 in DeveloperGuide.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":1,"deletions":1}}},{"hash":"ff30a5957677d391001ce7004974af1d415a9e9d","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into update-developer-guide","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"c16f10088cc01f7918c03231e38c574346a9cd27","isMergeCommit":true,"messageTitle":"Merge pull request #36 from kaih4n/update-developer-guide","messageBody":"Add use cases 11-21 to DeveloperGuide.md","fileTypesAndContributionMap":{}}]},{"date":"2026-10-06T00:00:00","commitResults":[{"hash":"e638e5a42aecafaddc87b61c4a903fa9e7b0ac4d","isMergeCommit":false,"messageTitle":"Add Meeting.java in model","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":0,"deletions":0}}},{"hash":"c1b1ead5fd18e6e4b4eaaf96bc5924caed6be008","isMe