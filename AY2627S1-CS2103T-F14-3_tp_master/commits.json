 README and site settings","fileTypesAndContributionMap":{}},{"hash":"ebd6efbf37f39c246bc005719d22b1265f74d352","isMergeCommit":false,"messageTitle":"Add NFRs","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":8,"deletions":4}}},{"hash":"2b376895799c3544cc62c3fca5823713cbf6d54e","isMergeCommit":true,"messageTitle":"Merge pull request #30 from Yik-Wee/week7-update-dg","messageBody":"Update DG product scope and user stories","fileTypesAndContributionMap":{}},{"hash":"1b7beb14a9edf111461803cc3279a0d5a33456e1","isMergeCommit":false,"messageTitle":"Add glossary","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":12,"deletions":0}}},{"hash":"5cd957c93980c2f499f2b336f38543979030329c","isMergeCommit":true,"messageTitle":"Merge pull request #32 from GODMODE899/branch-new-use-cases","messageBody":"Add use cases","fileTypesAndContributionMap":{}}]},{"date":"2026-10-10T00:00:00","commitResults":[{"hash":"abeb973f06da41438cfeb3f519db43bd01239fda","isMergeCommit":false,"messageTitle":"Add parsing support for client orders","messageBody":"The command parser currently has no support for bakery orders.\nIntroduce add-order parsing with client and item indices, quantity,\nand a strictly validated deadline to begin the MVP order feature.\n\nAccept past deadlines and catch invalid numbers without changing data.\nKeep model, storage, and UI integration for a later increment, and\nreport this limitation safely when execution is attempted.\n\nAdd boundary and regression tests and document the requirements.\nValidate with the full test suite and both Checkstyle tasks.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":310,"deletions":0},"docs":{"insertions":31,"deletions":0},"test-code":{"insertions":290,"deletions":0}}},{"hash":"dfc9d56c44632bfa08a0b51204bb4c1719b6933f","isMergeCommit":false,"messageTitle":"Add parsing support for deleting client orders","messageBody":"Client order deletion currently has no recognized command.\nParse delete-order requests with validated client and order indices\nas a small increment before model and storage integration.\n\nReject malformed, repeated, and overflowing arguments with useful\nerrors. Report deferred execution without changing existing data.\nAdd parser and command tests and document the parsing requirements.\n\nRefs #38\n","fileTypesAndContributionMap":{"functional-code":{"insertions":127,"deletions":0},"docs":{"insertions":20,"deletions":0},"test-code":{"insertions":117,"deletions":0}}},{"hash":"82a3ee938a42ec3c33807ae260d625fcbe717f27","isMergeCommit":false,"messageTitle":"Add parsing support for marking orders complete","messageBody":"Order completion currently has no recognized command.\nParse mark-order-complete requests with validated client and order\nindices before integrating completion changes with the model.\n\nReject malformed, repeated, and overflowing arguments with useful\nerrors. Report deferred execution without changing existing data.\nAdd parser and command tests and document the parsing requirements.\n\nRefs #39\n","fileTypesAndContributionMap":{"functional-code":{"insertions":127,"deletions":0},"docs":{"insertions":20,"deletions":0},"test-code":{"insertions":117,"deletions":0}}},{"hash":"c18a7cab16b1d44c0b294ee80a4dd4b091bfb821","isMergeCommit":false,"messageTitle":"Add parsing support for unmarking client orders","messageBody":"Reversing order completion currently has no recognized command.\nParse unmark requests with validated client and order indices before\nintegrating restoration of incomplete status with the model.\n\nReject malformed, repeated, and overflowing arguments with useful\nerrors. Report deferred execution without changing existing data.\nAdd parser and command tests and document the parsing requirements.\n\nRefs #40\n","fileTypesAndContributionMap":{"functional-code":{"insertions":127,"deletions":0},"docs":{"insertions":20,"deletions":0},"test-code":{"insertions":117,"deletions":0}}},{"hash":"d5d3da1201bca1ca388e8