 from kkyingovo/branch-add-remark","messageBody":"Update add commands for jobseekers","fileTypesAndContributionMap":{}},{"hash":"0484fb97d2964b8ad00df570db00dcf5a4f1a5c9","isMergeCommit":true,"messageTitle":"Merge pull request #51 from PenguinPiplup/branch-follow-coding-standard","messageBody":"Improve code style","fileTypesAndContributionMap":{}},{"hash":"6c584de66c8203826abaec500e47cb34545d3ecf","isMergeCommit":false,"messageTitle":"Change find command to findj command","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":10,"deletions":10},"other":{"insertions":14,"deletions":14},"test-code":{"insertions":12,"deletions":11}}},{"hash":"b158b3d07b4a5ca59c13514afd8a66c50d155c78","isMergeCommit":false,"messageTitle":"Add substring matching by name","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":8,"deletions":3},"test-code":{"insertions":72,"deletions":0}}},{"hash":"5ad23fb5efa15f092b94912b01bcfe467170210d","isMergeCommit":false,"messageTitle":"Match findj keywords against phone and email","messageBody":"Recruiters often have only a jobseeker\u0027s number or email address to hand.\nHence, each keyword is now matched, case-insensitively and as a substring,\nagainst the name, phone number and email. The fields are checked separately\nso a keyword cannot match across a field boundary (e.g. Alice12345).\nTags are still not searched.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":16,"deletions":9},"test-code":{"insertions":53,"deletions":2}}},{"hash":"0f08d0d4cceefd4f5c0c6c1ba455898bae6eed35","isMergeCommit":false,"messageTitle":"Add assertions, defensive coding","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":31,"deletions":4},"test-code":{"insertions":47,"deletions":6}}},{"hash":"9e936fb4ef75da5b67054f33b4f1bc24d03256aa","isMergeCommit":false,"messageTitle":"Remove duplicate findjobseekers test code","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":5,"deletions":0},"test-code":{"insertions":20,"deletions":30}}},{"hash":"7980bd0f1c082c4080715b0d62de6fb555c304f8","isMergeCommit":false,"messageTitle":"Add findc command","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":122,"deletions":14},"test-code":{"insertions":182,"deletions":4}}}]},{"date":"2026-10-15T00:00:00","commitResults":[{"hash":"4a4dc12a640d8de43d2b0634f4a6b9e8e912d891","isMergeCommit":false,"messageTitle":"Fix minor mistakes in code","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":1},"test-code":{"insertions":2,"deletions":12}}},{"hash":"4db7b358397699a879d37eb97e30ef85c906f5df","isMergeCommit":true,"messageTitle":"Merge from master branch","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"0bd7968add7ce1763d1f30d09345005550de194d","isMergeCommit":false,"messageTitle":"Rename NameContainsKeywordsPredicate class","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":28,"deletions":12},"other":{"insertions":38,"deletions":33},"test-code":{"insertions":29,"deletions":29}}},{"hash":"f06e8f8fec2d399f16f96621f11b9ee14466bb98","isMergeCommit":false,"messageTitle":"Add additional testcase","messageBody":"Added additional test case in FindJobseekerCommandTest to verify\nthat filtered clients list is unchanged.\n","fileTypesAndContributionMap":{"test-code":{"insertions":13,"deletions":0}}},{"hash":"e06a1788d7c8c653ee648a8874c33a1d435926cb","isMergeCommit":true,"messageTitle":"Merge pull request #66 from PenguinPiplup/branch-find-jobseekers","messageBody":"Update find command for jobseekers/clients","tags":["v1.3"],"fileTypesAndContributionMap":{}}]},{"date":"2026-10-16T00:00:00","commitResults":[{"hash":"9dfabf13eb0d8c221fb86996bd5510a9f914cdce","isMergeCommit":false,"messageTitle":"Fix edge case bug caused by em-space","messageBody":"Previously, having an em-space-only argument to findj/findc causes IllegalArgumentException to be\nthrown from isBlank NameContainsKeywordsPredicate.java, instead of the expected ParseException.\nThis could have caused the app to show an uncaught exception since MainWindow.java only catches\nCommandException or ParseException. The IllegalArgumentException goes past that handler,\nso the user gets no “Invalid command format” message, just an uncaught exception.\n\nHowever, in this commit, this has been fixed such that em-space-only argument would now correctly\ncause ParseException to be thrown.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":2,"deletions":2},"test-code":{"insertions":24,"deletions":0}}},{"hash":"a6b509465ab022e99e8338a701425290e5dbb0ef","isMergeCommit":false,"messageTitle":"Update User Guide for findc/findj","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":27,"deletions":10}}}]},{"date":"2026-10-18T00:00:00","commitResults":[{"hash":"b633205b604f178a176b7f09cca0a1f77b20337c","isMergeCommit":false,"messageTitle":"Add hidden status to jobseekers and clients","messageBody":"Previously, a recruiter can set aside a jobseeker or client only by\ndeleting them, which loses their details and notes, even when the\nrecruiter may want to work with them again later.\n\nThe planned hidej/hidec, unhidej/unhidec and hidden-list commands\nsolve this, but they all need each jobseeker and client to remember\nwhether it is hidden, across restarts.\n\nLet\u0027s,\n* give each jobseeker and client a hidden status, saved under a\n  hidden key in the data file\n* require the status in every Jobseeker and Client constructor, so\n  code that creates or rebuilds a person must state it instead of\n  getting a silent default\n* make new and sample jobseekers/clients as unhidden by default\n* keep the hidden status unchanged when editj, tagj, untagj, tagc and\n  untagc rebuild the person they change\n\nHidden people stay in the existing jobseekers and clients lists of the\ndata file instead of moving to separate lists. Duplicate checks then\nstill cover hidden people, and hiding or unhiding becomes an in-place\nupdate. A missing hidden key is read as unhidden, so existing data\nfiles load without any migration.\n\nNo command reads or changes the status yet, so the app behaves as\nbefore. The hide, unhide and list commands will follow in later\ncommits.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":86,"deletions":39},"test-code":{"insertions":215,"deletions":4}}},{"hash":"6b7e2cc19471602a52bd86af780662a01b27a8ed","isMergeCommit":false,"messageTitle":"Update listj/listc/findj/findc commands","messageBody":"Previously, jobseekers and clients have a hidden status, but no view\nuses it. listj, findj, listc and findc, the view at startup and the\nview after editj all show hidden people alongside everyone else.\n\nHiding someone is meant to take them out of the recruiter\u0027s everyday\nlists. Without that, the planned hidej and hidec commands would have\nno visible effect.\n\nLet\u0027s,\n* make listj and listc show only unhidden people\n* make findj and findc search only unhidden people\n* show only unhidden people at startup and after editj\n\nHidden people are only left out of the view, not removed from the\naddress book, so they keep their details and can be listed or found\nagain by the planned commands for hidden people. The show-all\npredicates are replaced rather than kept alongside, as no view shows\nhidden and unhidden people together.\n\nTests that edit or tag a hidden person now show everyone first,\nbecause they relied on hidden people appearing in the default view.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":19,"deletions":17},"test-code":{"insertions":158,"deletions":6}}}]},{"date":"2026-10-19T00:00:00","commitResults":[{"hash":"2f923f4a549e7582688c6ee18192132f781cb0d4","isMergeCommit":false,"messageTitle":"Add hidej and hidec commands","messageBody":"Previously, jobseekers and clients can be hidden, and listj, findj,\nlistc and findc leave hidden people out, but no command hides anyone.\nA recruiter who wants someone out of their everyday lists can only\ndelete them, which loses their details and notes.\n\nLet\u0027s,\n* add hidej INDEX and hidec INDEX, which hide the jobseeker or client\n  at that index in the displayed list\n* report \"no change\" when hiding someone who is already hidden\n\nHidden jobseekers/clients are kept in the address book with all their\ndetails, so that a later unhide command can bring them back.\n\nThe test helpers showJobseekerAtIndex and showClientAtIndex now leave\nout hidden people, to match findj and findc, which they stand in for.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":245,"deletions":0},"test-code":{"insertions":382,"deletions":4}}},{"hash":"241066f0c6cecc37d3713b45ddc47b525afdd403","isMergeCommit":false,"messageTitle":"Remove unnecessary header comments","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":0,"deletions":6}}}]},{"date":"2026-10-20T00:00:00","commitResults":[{"hash":"3598b87b0d77138e0c17f1567965faa1d77d81d6","isMergeCommit":true,"messageTitle":"Merge pull request #72 from PenguinPiplup/branch-archive-jobseekers","messageBody":"Add jobseekers/clients hide command","fileTypesAndContributionMap":{}}]},{"date":"2026-10-21T00:00:00","commitResults":[{"hash":"0e1940993d044ce38ad0c81d91266fd3e4205d41","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into branch-archive-jobseekers","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"841c65a7e4c1a5eb85bc908b50da47947fa2d17c","isMergeCommit":false,"messageTitle":"Add listhj and listhc commands","messageBody":"hidej and hidec take people out of the jobseeker and client lists, but\nno command shows hidden people again. A recruiter cannot check who\nthey have hidden, and a later unhide command would have no list to\npick an index from.\n\nLet\u0027s,\n* add listhj, which lists only hidden jobseekers\n* add listhc, which lists only hidden clients\n\nEach command changes only its own list, as listj and listc do, so a\nrecruiter can look through hidden jobseekers while the client list\nkeeps showing what it showed before.\n\nCommands to search through hidden people (findhj and findhc) will\nfollow in a later commit.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":56,"deletions":0},"test-code":{"insertions":202,"deletions":0}}},{"hash":"d58b71aac3205693d0a044d1d457745affa6a3b6","isMergeCommit":false,"messageTitle":"Add findhj and findhc commands","messageBody":"listhj and listhc show every hidden jobseeker or client, but findj and\nfindc search only unhidden people. A recruiter who has hidden many\npeople has to scroll through the whole hidden list to find one of\nthem.\n\nLet\u0027s,\n* add findhj, which searches only hidden jobseekers\n* add findhc, which searches only hidden clients\n\nBoth commands take the same keywords and match them in the same way\nas findj and findc, so recruiters need not learn a second search\nsyntax. Each command changes only its own list, as findj and findc do.\n\nThe result message says \"hidden\", e.g. \"2 hidden jobseeker(s)\nlisted!\", so that recruiters can tell which list they are looking at.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":176,"deletions":3},"test-code":{"insertions":369,"deletions":0}}},{"hash":"c498c816c1b7c4f5b78ef988ef961363e4b03d04","isMergeCommit":false,"messageTitle":"Update user guide for new commands","messageBody":"Update user guide for hide-related commands,\nincluding hide, findh and listh\n","fileTypesAndContributionMap":{"docs":{"insertions":79,"deletions":2}}},{"hash":"ea51bd391be50112b248869dcf3cfb60294000fd","isMergeCommit":false,"messageTitle":"Test listhj and listhc after findhj and findhc","messageBody":"Previously, the tests for listhj and listhc start from the default\nview, which shows no hidden people. They would still pass if either\ncommand narrowed the list already on screen instead of replacing it,\nfor example by keeping only the hidden people that a previous findhj\nsearch showed.\n\nLet\u0027s add a test for each command that first runs findhj or findhc to\nshow one hidden person, then checks that listhj or listhc lists every\nhidden person again.\n\nEach test also checks that the search did narrow the list, so that it\ncannot pass merely because the search happened to show everyone.\n","fileTypesAndContributionMap":{"test-code":{"insertions":44,"deletions":0}}},{"hash":"7886d68a16b38d64003997dbfc443df810e0afc1","isMergeCommit":true,"messageTitle":"Merge from master branch","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"f2086a7cb6ea673360dd98dbf7c0607a6f3d0a49","isMergeCommit":true,"messageTitle":"Merge pull request #82 from PenguinPiplup/branch-archive-jobseekers","messageBody":"Add command to list/find hidden jobseekers/hidden clients","fileTypesAndContributionMap":{}}]},{"date":"2026-10-22T00:00:00","commitResults":[{"hash":"9b77b79d63af9340b6c021cb00f6c6a8376902e4","isMergeCommit":true,"messageTitle":"Merge pull request #84 from plainxjane/branch-unhideCommand","messageBody":"Add unhide commands for jobseekers and clients","fileTypesAndContributionMap":{}},{"hash":"ecc695a392559f7b45e3ef14f86f10ba4fd5236c","isMergeCommit":true,"messageTitle":"Merge pull request #87 from SzeTingT/v1.4-update-user-guide","messageBody":"Update user guide for listc, listj and incoming clipboard commands","fileTypesAndContributionMap":{}}]}],"kkyingovo":[{"date":"2026-09-24T00:00:00","commitResults":[{"hash":"e7752aa4d77137378bec6eef59f69cd89d598249","isMergeCommit":false,"messageTitle":"Add keying\u0027s details","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":2,"deletions":2}}},{"hash":"0dd93cac2a545acd6d0a6f5a10eaaf90a97a4a57","isMergeCommit":false,"messageTitle":"Add use cases","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":62,"deletions":8}}}]},{"date":"2026-09-28T00:00:00","commitResults":[{"hash":"fafbc