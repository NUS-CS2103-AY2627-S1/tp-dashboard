ributionMap":{"docs":{"insertions":156,"deletions":21}}}]},{"date":"2026-10-06T00:00:00","commitResults":[{"hash":"aafe9fb7783749ae59145ffc816085e3481d4248","isMergeCommit":false,"messageTitle":"Rename packages and types to InsureConnect","messageBody":"Java packages and product-specific types still use AddressBook names.\nThese names no longer match the InsureConnect product.\n\nLet\u0027s rename the packages, types, APIs, and matching test fixtures,\nand update the Gradle entry point and FXML imports together.\n\nKeep the data filename unchanged so existing records remain readable.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":157,"deletions":157},"other":{"insertions":834,"deletions":834},"test-code":{"insertions":332,"deletions":331}}},{"hash":"3c86d5ebfa588707b972be99c730072b72b236e5","isMergeCommit":false,"messageTitle":"Use InsureConnect in application branding","messageBody":"The window, command messages, build artifact, and logs retain AB3\nbranding even though the product is named InsureConnect.\n\nLet\u0027s update the visible names, help destination, icon references,\nand serialization root name to match the product.\n\nRetain the existing data filename and JSON fields for compatibility,\nand preserve the icon attribution and upstream issue reference.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":47,"deletions":46},"other":{"insertions":1,"deletions":1},"test-code":{"insertions":7,"deletions":7}}},{"hash":"1a24be0778827dc269783c1f18b078bd6b68b639","isMergeCommit":false,"messageTitle":"Align documentation with InsureConnect names","messageBody":"The guides and diagrams still describe AB3 and point to its code,\nrelease artifacts, and help page.\n\nLet\u0027s update the product terminology, package links, launch commands,\nand diagrams, and capture the renamed application\u0027s help screen.\nPolish command wording to use the product name naturally.\n\nDocument the retained data filename so existing users can find their\nrecords, while preserving the upstream acknowledgement and credits.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":29,"deletions":29},"docs":{"insertions":134,"deletions":135},"test-code":{"insertions":1,"deletions":1}}}]}],"BenjaminWong33":[{"date":"2026-09-30T00:00:00","commitResults":[{"hash":"56c03b017ddc9a72911de2df0eb7bba100be3c87","isMergeCommit":false,"messageTitle":"Update AboutUs.md","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":4,"deletions":5}}},{"hash":"95e2f3e6646d1bbcc3bfac90b2b6e306466fa96b","isMergeCommit":false,"messageTitle":"Remove portfolio link","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":2,"deletions":2}}}]},{"date":"2026-10-02T00:00:00","commitResults":[{"hash":"2f61da29abb2413b96712bc0cfde5b7d2eab7359","isMergeCommit":false,"messageTitle":"Update user stories","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":34,"deletions":9}}}]},{"date":"2026-10-06T00:00:00","commitResults":[{"hash":"bb0e85655aff9db7f47d63cac9b36aac6f08bb59","isMergeCommit":true,"messageTitle":"Merge pull request #55 from JonathanZheng/rename-InsureConnect","messageBody":"Standardise InsureConnect naming across code, UI, and docs","fileTypesAndContributionMap":{}}]}],"BurpZes":[{"date":"2026-09-21T00:00:00","commitResults":[{"hash":"ed3b8721675440b85c86228efbb7efbefda19f8b","isMergeCommit":false,"messageTitle":"Fix compileJava FAILED","messageBody":"","fileTypesAndContributionMap":{"other":{"insertions":3,"deletions":0}}}]},{"date":"2026-09-29T00:00:00","commitResults":[{"hash":"2d98f23bc3748394d696a172918b930b83847644","isMergeCommit":true,"messageTitle":"Merge pull request #15 from BenjaminWong33/add-benjaminwong33-photo","messageBody":"Add Benjamin\u0027s photo","fileTypesAndContributionMap":{}},{"hash":"194c4700fc5fcbf19e0750c6a83472deee58a82b","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 of https://github.com/AY2627S1-CS2103T-W09-4/tp","messageBody":"","f