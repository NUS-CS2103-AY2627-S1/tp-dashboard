19078590a49faba008f5ef702182bde875beab","isMergeCommit":false,"messageTitle":"Add follow-up domain foundation","messageBody":"Person records have no shared representation for a pending follow-up.\nThe planned commands, storage and UI need one consistent value type.\n\nAdd immutable follow-up dates, descriptions and derived status labels,\nplus shared workflow messages. Extend Person with an optional follow-up\nwhile preserving existing constructors and contact identity rules.\n\nRetain follow-ups through contact edits and person copies. Add tests for\nvalidation boundaries, status calculation and preservation.\n\nRefs #43\n","fileTypesAndContributionMap":{"functional-code":{"insertions":215,"deletions":7},"test-code":{"insertions":246,"deletions":1}}}]},{"date":"2026-10-06T00:00:00","commitResults":[{"hash":"cede4496f29110f41536e9dc920c51137c879fde","isMergeCommit":false,"messageTitle":"Simplify follow-up message ownership","messageBody":"The foundation defines messages for commands, storage and startup before\nthose behaviours exist, duplicating existing AB3 message owners.\n\nRemove the unused FollowUpMessages class and track the revised shared\nimplementation contract. Assign future messages to their commands and\nexisting generic owners, with explicit file ownership and PR\ndependencies so teammates build on the same domain API without competing\nconstants.\n\nKeep domain validation, date parsing and status display APIs unchanged.\n\nRefs #43\n","fileTypesAndContributionMap":{"functional-code":{"insertions":0,"deletions":41},"docs":{"insertions":538,"deletions":0}}},{"hash":"dbe72aff3ef248d3432c19eb7f8873ef1d15b6ee","isMergeCommit":true,"messageTitle":"Merge pull request #46 from gwenlim89/follow-upmodel-foundation","messageBody":"Add follow-up model state and command candidates","fileTypesAndContributionMap":{}}]}],"SomaadityaSamal":[{"date":"2026-09-30T00:00:00","commitResults":[{"hash":"1e0cbd8a849cfcf0010bfd8ada29d4d18cb95ab7","isMergeCommit":false,"messageTitle":"Add Somaaditya to About Us","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":5,"deletions":6}}}]}],"gwenlim89":[{"date":"2026-09-29T00:00:00","commitResults":[{"hash":"9514280c1a548b962b9eb23f86202dc0d1a591a3","isMergeCommit":false,"messageTitle":"Add Gwen Lim\u0027s profile photo to About Us","messageBody":"The About Us page contains placeholder profiles and does not identify\nGwen Lim as a team member.\n\nAdd Gwen Lim\u0027s photo and GitHub profile link so readers can identify\nher and find her contributions. Use gwenlim89.png to follow the\nrequired lowercase GitHub username naming convention.\n\nLeave out the optional homepage and portfolio links until suitable\ndestinations are available.\n","fileTypesAndContributionMap":{"docs":{"insertions":6,"deletions":0}}},{"hash":"24741f3fc71d67d75196b4d5e82fffb145ae41a8","isMergeCommit":false,"messageTitle":"Add Gwen Lim\u0027s provisional roles to About Us","messageBody":"Gwen Lim\u0027s profile lists a photo and GitHub link but does not describe\nher role or responsibilities.\n\nAdd Developer and Tester roles with responsibilities for implementing\nfeatures, maintaining tests, reporting bugs, and verifying fixes.\nMark the assignment as provisional because the team has not yet\nagreed on responsibilities.\n","fileTypesAndContributionMap":{"docs":{"insertions":5,"deletions":0}}}]},{"date":"2026-09-30T00:00:00","commitResults":[{"hash":"a8b0fed90a286839ee26aa5b0e42a359f19d4f51","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into add-josthan12-photo","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"263436146c796b8fc5c3660ec6636e6dc735c2df","isMergeCommit":true,"messageTitle":"Merge pull request #10 from josthan12/add-josthan12-photo","messageBody":"Add Josthan\u0027s photo","fileTypesAndContributionMap":{}}]},{"date":"2026-10-02T00:00:00","commitResults":[{"hash":"03034af1d55eb2bff28a1546a429d9a2e5eb0a81","isMergeCommit":false,"messageTitle":"Add use cases to Developer Guide","messageBody":"Document representative use cases for retrieving, adding, deleting,\nand managing client records and follow-ups.\n\nInclude main success scenarios and relevant extensions to clarify\nexpected user-system interactions.\n","fileTypesAndContributionMap":{"docs":{"insertions":87,"deletions":12}}},{"hash":"3ff4d6ae8705f376378b9d690afa375ab4ef199e","isMergeCommit":true,"messageTitle":"Merge pull request #42 from Ayushjain8541/update-readme","messageBody":"Update README and UI mockup","fileTypesAndContributionMap":{}},{"hash":"3ad767ccf5c45f83c294d3afd404cc45d4733839","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into NFR","messageBody":"","fileTypesAndContributionMap":{}}]},{"date":"2026-10-06T00:00:00","commitResults":[{"hash":"fd5e315ac1f5631197c611a86722609e4d25a173","isMergeCommit":true,"messageTitle":"Merge pull request #44 from Ayushjain8541/codex/43-follow-up-domain-foundation","messageBody":"Add follow-up domain foundation","fileTypesAndContributionMap":{}},{"hash":"0807b87df5d535616e80af18a382af6e82bdb2cd","isMergeCommit":false,"messageTitle":"Add follow-up model state and command candidates","messageBody":"Provide the PR 2 model foundation for dependent follow-up work.\n\nAdd stable pending views, sampled date properties, isolated command\ncandidates and explicit mutation tracking. Publish validated candidates\nwithout replacing observable objects or rewriting unchanged data.\n\nCover ordering, view transitions, candidate isolation and existing indexed\ncommands. Leave command routing, persistence and UI integration to later PRs.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":149,"deletions":10},"test-code":{"insertions":431,"deletions":0}}},{"hash":"462c7ad521fd6e3731752e127c5a7147298f8ee5","isMergeCommit":false,"messageTitle":"Clarify displayed state publication contract","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":3,"deletions":2},"test-code":{"insertio