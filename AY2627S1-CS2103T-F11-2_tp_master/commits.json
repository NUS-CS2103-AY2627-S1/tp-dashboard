rmat used for the other team members, so each\ndetail renders on its own line.\n\nCo-Authored-By: Claude Opus 5.5 \u003cnoreply@anthropic.com\u003e\n","fileTypesAndContributionMap":{"docs":{"insertions":2,"deletions":2}}}]}]},"authorFileTypeContributionMap":{"juniuslui":{"docs":4,"functional-code":0,"test-code":0},"jaredseezw":{"docs":3,"functional-code":0,"test-code":0,"other":1},"zyangchuan":{"docs":283,"functional-code":0,"test-code":0},"xdJanaut":{"docs":50,"functional-code":0,"test-code":0,"other":2},"imgorf":{"docs":55,"functional-code":0,"test-code":0}},"authorContributionVariance":{"juniuslui":3.75,"jaredseezw":3.859375,"zyangchuan":6833.0586,"xdJanaut":597.71484,"imgorf":160.0625},"authorDisplayNameMap":{"juniuslui":"CS2103T-F11-2 JUNI..FENG","jaredseezw":"CS2103T-F11-2 SEE ..ARED","zyangchuan":"CS2103T-F11-2 ZHAN..HUAN","xdJanaut":"CS2103T-F11-2 JUST.. BIN","imgorf":"CS2103T-F11-2 JASO.. LOH"}}
