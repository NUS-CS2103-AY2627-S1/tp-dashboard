roduct-scope","messageBody":"Update DG target user profile and value proposition","fileTypesAndContributionMap":{}},{"hash":"0bde39fb7ed66daf3baa8ee1a3782b457b28fc74","isMergeCommit":true,"messageTitle":"Merge pull request #33 from vishnuroxx/T-UpdateDeveloperGuide","messageBody":"Add Use Cases in Developer Guide","fileTypesAndContributionMap":{}},{"hash":"af38b73a979e144915a987c81ecc818275649bdf","isMergeCommit":true,"messageTitle":"Merge pull request #35 from Yukino2711/34-Update-website-title-to-ProductName","messageBody":"Update website title to ProductName","fileTypesAndContributionMap":{}},{"hash":"9f821e421eed8eded235d72d5fe6bcbd858c8911","isMergeCommit":true,"messageTitle":"Merge pull request #38 from Yukino2711/37-update-user-stories","messageBody":"Update user stories","fileTypesAndContributionMap":{}},{"hash":"505ef4a5048d1456978495d03dcd0bf2d2831461","isMergeCommit":true,"messageTitle":"Merge pull request #40 from Totonyny511/39-update-glossary-in-DG","messageBody":"Update DG glossary for UniContacts","fileTypesAndContributionMap":{}}]},{"date":"2026-10-08T00:00:00","commitResults":[{"hash":"78b6ba8770ee6546254c6464331ebf8762b561c1","isMergeCommit":false,"messageTitle":"Add context prefix","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":0}}},{"hash":"02fec52b1ed4b43d1c35be7ee3f10bbcc20142ed","isMergeCommit":false,"messageTitle":"Update Name validation to match ADD spec","messageBody":"Names must start with a letter and ocntain only letters, spaces,\nhyphens, apostrophes and periods, up to 100 characters.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":3,"deletions":2},"test-code":{"insertions":32,"deletions":10}}},{"hash":"fba80ea0b9097670414860c1750e19cfd6eb92eb","isMergeCommit":false,"messageTitle":"Update Phone validation","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":2,"deletions":2},"test-code":{"insertions":32,"deletions":7}}},{"hash":"ad59b16aa9d7b9dfba376c9ae272da9909dcb124","isMergeCommit":false,"messageTitle":"Make command words case-insensitive","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":4,"deletions":1},"test-code":{"insertions":43,"deletions":0}}}]},{"date":"2026-10-12T00:00:00","commitResults":[{"hash":"dd6acf9b67a1a62d9b96cf0efa1a6908c96ebcb1","isMergeCommit":true,"messageTitle":"Merge pull request #60 from ryan24chua/54-update-name-validation","messageBody":"Update Name validation to match ADD spec","fileTypesAndContributionMap":{}},{"hash":"685fd443c70f78d955b62c9f5421a4be23c1d755","isMergeCommit":true,"messageTitle":"Merge pull request #58 from ryan24chua/56-add-context-prefix","messageBody":"Add context prefix","fileTypesAndContributionMap":{}}]},{"date":"2026-10-13T00:00:00","commitResults":[{"hash":"927be35234d20815ab978c0d6417ace5aa0799f4","isMergeCommit":true,"messageTitle":"Merge pull request #63 from ryan24chua/61-case-insensitive-commands","messageBody":"Make command words case-insensitive","fileTypesAndContributionMap":{}},{"hash":"e7731c9dff17c0a82e417861ed0b72ecde81f607","isMergeCommit":true,"messageTitle":"Merge pull request #62 from ryan24chua/55-update-phone-validation","messageBody":"Update Phone validation","fileTypesAndContributionMap":{}},{"hash":"6cffb803e1b36028b02cb8776600fb19f3e57524","isMergeCommit":false,"messageTitle":"Update add usage message","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":7,"deletions":10}}},{"hash":"f9318fcd27767ef9360c402bb6ee89f9c1546676","isMergeCommit":false,"messageTitle":"Show specific errors for empty name and context","messageBody":"An empty n/ or c/ used to fail the format regex and show the full\nconstraints message, which lists format rules instead of saying the\nvalue is missing. ParserUtil now rejects a blank name or context with\n\"Name cannot be empty.\" / \"Contexts cannot be empty.\" before the\nregex check. This also applies to edit, which shares ParserUtil.\n\nINVALID_CONTEXT_DESC was an empty c/, so it is split into\nEMPTY_CONTEXT_DESC and a truly invalid c/(orbital).\n","fileTypesAndContributionMap":{"functional-code":{"insertions":8,"deletions":0},"test-code":{"insertions":39,"deletions":6}}},{"hash":"5065b601c9eeda3e41c462f3ad76296430fd4ccc","isMergeCommit":false,"messageTitle":"Show specific errors for empty phone and email","messageBody":"An empty p/ or e/ now shows \"Phone number cannot be empty. Leave out p/\nif there is no phone number.\" (and the same for e/) instead of the\nformat constraints, matching the ADD spec. The prefixes come from\nCliSyntax so the hint stays correct if a prefix changes.\n\nEdit shares ParserUtil, so it shows the same messages. The \"leave out\"\nhint does not fit edit, but edit is outside the MVP.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":12,"deletions":0},"test-code":{"insertions":30,"deletions":0}}},{"hash":"9b3bd7defb3acb16c88289e0530dc670d1534219","isMergeCommit":false,"messageTitle":"Leave out missing phone and email in result messages","messageBody":"Messages.format printed \"Phone: ; Email: \" for a contact without them.\nA missing phone or email is now left out. Contexts are listed first,\neach in brackets (e.g. [CS2103T] [Hack\u0026Roll 2026]), followed by phone\nand email.\n\nAdd MessagesTest, since the command tests build their expected\nmessages with Messages.format and so cannot catch format changes.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":5,"deletions":5},"test-code":{"insertions":43,"deletions":0}}},{"hash":"7b2f70e2890d4d64b45942b4828761d11bd6b12a","isMergeCommit":false,"messageTitle":"Name the clashing person in duplicate add errors","messageBody":"A duplicate add showed the generic \"This person already exists in the\naddress book.\" The message now names the existing person and the\nshared value, e.g. \"This person already exists: Alex Tan has the same\nphone number (91234567).\"\n\nUniquePersonList#findDuplicate returns the first person in the list\nwith the same identity, and is passed up through AddressBook and Model\nso AddCommand can build the message. If that person matches on both\nphone and email, the message names the phone.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":61,"deletions":4},"test-code":{"insertions":13,"deletions":6}}},{"hash":"6511db57a8eed3e6eaecaeb1808046b6ba74768d","isMergeCommit":false,"messageTitle":"Test duplicate add messages and findDuplicate","messageBody":"The integration tests check the duplicate message against literal\nstrings, since building the expected message with the same helper\nwould pass whatever the helper returns. They cover a phone clash, an\nemail clash in a different case, a match on both fields (names the\nphone), and clashes with several persons (first in the list wins).\n","fileTypesAndContributionMap":{"test-code":{"insertions":53,"deletions":1}}},{"hash":"265ee89c2a5baa9e704a8ab0ce6c50c8163a3171","isMergeCommit":false,"messageTitle":"Fix edit duplicate check and name clashing person","messageBody":"The old check skipped the lookup whenever the edited person still\nshared a phone or email with the original, so an edit could keep its\nown phone but take another person\u0027s email. Check the edited person\nagainst every other person instead, and reuse the add error message.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":36,"deletions":5},"test-code":{"insertions":9,"deletions":2}}},{"hash":"8adc821cd86f960c67224a899950e4dc5a0f489b","isMergeCommit":false,"messageTitle":"Test edit duplicate check against other persons","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":56,"deletions":0}}}]},{"date":"2026-10-14T00:00:00","commitResults":[{"hash":"be978680ec342ea915a958744cced3f89e40135c","isMergeCommit":false,"messageTitle":"Keep empty phone/email hints out of edit","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":22,"deletions":6},"test-code":{"insertions":2,"deletions":2}}},{"hash":"912a074af2d908f782cff4b3026bc09814692b92","isMergeCommit":false,"messageTitle":"Limit emails to 254 characters and shorten the error message","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":7,"deletions":12}}},{"hash":"5f291cf8a31eacb6cb84c5ad6ce8a0124614c697","isMergeCommit":false,"messageTitle":"Test the 254-character email limit","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":4,"deletions":0}}},{"hash":"95feaeedd91bae0417b654f3157fa5246c4538f4","isMergeCommit":false,"messageTitle":"Collapse repeated spaces in contexts","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":13,"deletions":5}}},{"hash":"ed4f05f2feec72197456def839888a173fc4a41a","isMergeCommit":false,"messageTitle":"Test collapsing repeated spaces in contexts","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":35,"deletions":0}}},{"hash":"42c33534c933dc62424d449df636759b5ed9eaf4","isMergeCommit":true,"messageTitle":"Merge pull request #76 from ryan24chua/67-empty-errors-and-usage","messageBody":"Show empty-field errors and new usage message in add","fileTypesAndContributionMap":{}},{"hash":"df0e866e0b2aba19d5bce58fc159862e0559ba51","isMergeCommit":true,"messageTitle":"Merge pull request #77 from ryan24chua/68-missing-phone-email","messageBody":"Leave out missing phone and email in result messages and reframe contexts with brackets","fileTypesAndContributionMap":{}},{"hash":"e56279420315ac29953acc7fc01ed2173312a7f1","isMergeCommit":true,"messageTitle":"Merge pull request #78 from ryan24chua/69-duplicate-field-and-edit-check","messageBody":"Name the clashing person in duplicate errors and fix the edit duplicate check","fileTypesAndContributionMap":{}},{"hash":"3bd457c39888eba05167bb6e6edc127db53cfa59","isMergeCommit":true,"messageTitle":"Merge pull request #82 from ryan24chua/80-email-error-and-length","messageBody":"Use a shorter email error message and lim