00:00:00","commitResults":[{"hash":"cc44c51afb761c44227420723b8b66f0810326de","isMergeCommit":true,"messageTitle":"Merge pull request #92 from YUJ1N06/fix-master-student-integration","messageBody":"Fix master: reconcile student fields, atomic saves and index integration","fileTypesAndContributionMap":{}},{"hash":"1cf8406840a0456b9b30534dc39193d40fed4f97","isMergeCommit":false,"messageTitle":"Add level command for education level tagging (F05)","messageBody":"Adds `level INDEX l/LEVEL`, which sets one education level per student.\nCanonical names and the documented aliases are accepted case-insensitively\nand stored canonically, in the shared StudentFields envelope. Shows on the\nstudent card and details panel, with tests and user guide documentation.\n\nAlso fixes IndexedParameterParserUtil crashing with a\nStringIndexOutOfBoundsException when the index is missing (e.g.\n`level l/Sec4`), and makes its repeated-parameter error name the prefix\n(`l/`) as specified.\n\nCo-Authored-By: Claude Sonnet 5.5 \u003cnoreply@anthropic.com\u003e\n","fileTypesAndContributionMap":{"functional-code":{"insertions":200,"deletions":3},"docs":{"insertions":47,"deletions":0},"test-code":{"insertions":606,"deletions":0}}},{"hash":"757d3cfdbed8ceacd2d1c5ad591ba3a3df10c93f","isMergeCommit":false,"messageTitle":"Add subject command for subject tagging (F06)","messageBody":"Adds `subject INDEX s/SUBJECT`, which sets one subject per student.\nSubjects are normalized (NFKC, trimmed, spaces collapsed), must be 2-50\ncharacters with at least one letter, and may use letters, digits, spaces\nand \u0026 / - \u0027 ( ). Display case is kept and equality ignores case and\nspacing, so a case-only or spacing-only difference is a no-change.\nStored in the shared StudentFields envelope; shown on the student card\nand details panel, with tests and user guide documentation.\n\nAlso includes the same IndexedParameterParserUtil fix as the F05 branch\n(missing-index crash, repeated-parameter message names the prefix).\n\nCo-Authored-By: Claude Sonnet 5.5 \u003cnoreply@anthropic.com\u003e\n","fileTypesAndContributionMap":{"functional-code":{"insertions":201,"deletions":3},"docs":{"insertions":47,"deletions":0},"test-code":{"insertions":594,"deletions":0}}},{"hash":"d846f6dce0bd982a0350ad1c67f7dd5e4d02f068","isMergeCommit":true,"messageTitle":"Merge pull request #95 from keyfurrr67/f05-level-tagging","messageBody":"F05: Educational level tagging","fileTypesAndContributionMap":{}},{"hash":"42db64b6d3db4f7a95951a9e133145c6bc815008","isMergeCommit":true,"messageTitle":"Merge pull request #96 from keyfurrr67/f06-subject-tagging","messageBody":"F06: Subject tagging","fileTypesAndContributionMap":{}}]}]},"authorFileTypeContributionMap":{"Antz5lyfe":{"docs":204,"functional-code":447,"test-code":948,"other":1},"JimiBong":{"docs":102,"functional-code":113,"test-code":499},"ap-was-here":{"docs":27,"functional-code":577,"test-code":0},"YUJ1N06":{"docs":197,"functional-code":715,"test-code":991,"other":9},"keyfurrr67":{"docs":185,"functional-code":396,"test-code":1198}},"authorContributionVariance":{"Antz5lyfe":117845.89,"JimiBong":34402.81,"ap-was-here":23647.475,"YUJ1N06":265763.56,"keyfurrr67":131005.09},"authorDisplayNameMap":{"Antz5lyfe":"CS2103T-F08-3 ANTO.. JUN","JimiBong":"CS2103T-F08-3 BONG..JIMI","ap-was-here":"CS2103T-F08-3 AISH..KSHA","YUJ1N06":"CS2103T-F08-3 CHAN..GENE","keyfurrr67":"CS2103T-F08-3 KIEF.. LAU"}}
