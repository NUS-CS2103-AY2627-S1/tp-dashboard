2d155202b077135f2610c44b78a","isMergeCommit":false,"messageTitle":"Refine use cases and requirements in Developer Guide","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":9,"deletions":12}}}]},{"date":"2026-10-01T00:00:00","commitResults":[{"hash":"0b1d80b2a00c2afd20cc7b44252c311cc4ae2b85","isMergeCommit":true,"messageTitle":"Merge pull request #35 from engsheng/Update-Developer-Guide","messageBody":"Refine Developer Guide","fileTypesAndContributionMap":{}}]},{"date":"2026-10-07T00:00:00","commitResults":[{"hash":"7eda7490ea11168491f087e55d0caafc30548270","isMergeCommit":true,"messageTitle":"Merge pull request #49 from Zhikai-Koh/UpdateCliPrefix","messageBody":"Update CLI prefixes","fileTypesAndContributionMap":{}},{"hash":"d60db79cee62071550d529b9fd11ce811ebecb02","isMergeCommit":true,"messageTitle":"Merge pull request #51 from Zhikai-Koh/Update-Person-Model","messageBody":"Update person model","fileTypesAndContributionMap":{}},{"hash":"6b791482b69ee01bffe7b4bec81be609d70694c5","isMergeCommit":false,"messageTitle":"Improve delete argument validation","messageBody":"Delete reports a generic usage error for invalid arguments, making\nit difficult to identify the input problem.\n\nAdd distinct messages for missing, non-numeric, and zero indexes\nto match the team specification. Preserve support for surrounding\nwhitespace and leading zeroes.\n\nAdd parser and command-routing tests covering these messages,\nunexpected arguments, and integer boundaries.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":22,"deletions":2},"test-code":{"insertions":83,"deletions":8}}},{"hash":"460c3e637c59c91ddb3934b6d0b43412ccea9bef","isMergeCommit":false,"messageTitle":"Support deleting multiple players by index","messageBody":"Delete accepts only one player index at a time.\n\nAccept whitespace-separated indices and resolve every target\nbefore deletion so list changes cannot shift the requested targets.\nDelete repeated targets only once and reject invalid requests\nwithout removing any players.\n\nExtract detailed index parsing, clarify overflow errors, and\ndocument the command. Test filtered lists, target ordering,\nduplicate indices, and persistence.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":85,"deletions":35},"docs":{"insertions":12,"deletions":6},"test-code":{"insertions":171,"deletions":10}}}]},{"date":"2026-10-08T00:00:00","commitResults":[{"hash":"8fcfffbf071542da6f5a459db081f5a7e003f3a3","isMergeCommit":false,"messageTitle":"Support deleting players by name","messageBody":"Players can only be deleted using displayed indices.\n\nAccept /name followed by comma-separated full names. Match names\nwithout case sensitivity and normalize whitespace for lookup.\n\nResolve all names before deletion and reject missing or ambiguous\nmatches. Reuse the existing deletion and feedback logic.\n\nDocument the syntax and limitations, and test parsing, matching,\nfiltered views, and persistence.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":91,"deletions":10},"docs":{"insertions":23,"deletions":2},"test-code":{"insertions":225,"deletions":1}}},{"hash":"9a37231e41697ffec46733b95dbd744a00ef882a","isMergeCommit":false,"messageTitle":"Show player details for ambiguous delete names","messageBody":"Ambiguous names require users to run list and locate the matching\nplayers manually.\n\nDisplay every match with numbered player details and switch the\ndisplayed list to those matches so deletion by index works directly.\n\nPreserve all player data when ambiguity occurs. Test hidden matches,\nmultiple matches, batch failures, and subsequent index deletion.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":30,"deletions":8},"docs":{"insertions":6,"deletions":1},"test-code":{"insertions":120,"deletions":11}}},{"hash":"f53b8d8a9db4d343342d6688a63f1fc1938bfa4a","isMergeCommit":false,"messageTitle":"Restore data when command persistence fails","messageBody":"Restore the pre-command address book when storage rejects a save.\nWrite JSON through a temporary file before replacing stored data.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":43,"deletions":10},"test-code":{"insertions":8,"deletions":13}}},{"hash":"7c4ce9dd9e9ef86ba9b2f87c6b453cff74494e8a","isMergeCommit":false,"messageTitle":"Improve delete index error messages","messageBody":"Report the invalid index and displayed range when deletion fails.\nGuide users to list players when no deletion target is displayed.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":10,"deletions":1},"docs":{"insertions":1,"deletions":0},"test-code":{"insertions":12,"deletions":8}}},{"hash":"e617206e8fdcfd698820aa1d6d78bdd4482e4541","isMergeCommit":true,"messageTitle":"Merge pull request #60 from Xuenyin/feature/add-player","messageBody":"Feature: Enhance add command to support name/ alias","fileTypesAndContributionMap":{}},{"hash":"232d68a50c549e6d7c24e5f90c5f3f071f052d4e","isMergeCommit":true,"messageTitle":"Merge pull request #63 from Xuenyin/remove-legacy-fields","messageBody":"Remove legacy fields from player profile","fileTypesAndContributionMap":{}},{"hash":"c9edb09e33d3054918a738a8d059d9f9d875f88f","isMergeCommit":false,"messageTitle":"Align delete name prefixes with shared CLI syntax","messageBody":"Delete uses a custom /name selector that differs from add.\n\nAccept n/ and name/ through ArgumentTokenizer and reuse the\nCliSyntax constants. Reject duplicate selectors and update\nusage text, documentation, and tests.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":25,"deletions":12},"docs":{"insertions":9,"deletions":6},"test-code":{"insertions":49,"deletions":17}}}]}],"Zhikai-Koh":[{"date":"2026-09-30T00:00:00","commitResults":[{"hash":"317eb3a41a57b26b524249ae3e6a61e2a1d706ce","isMergeCommit":false,"messageTitle":"Update AboutUs Page","messageBody":"Updated team members\u0027 names, images, and GitHub links.","fileTypesAndContributionMap":{"d