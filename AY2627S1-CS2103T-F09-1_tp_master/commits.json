34},"docs":{"insertions":0,"deletions":235}}},{"hash":"2b3112090e04b2e07fda8e973a2d957ca247d2e7","isMergeCommit":true,"messageTitle":"Merge pull request #10 from Praneeth-Suresh/master","messageBody":"Clean up agent module and remove unused files","fileTypesAndContributionMap":{}}]},{"date":"2026-09-30T00:00:00","commitResults":[{"hash":"cd09d080368cf1405a21c6a01a652896d07adc59","isMergeCommit":false,"messageTitle":"Add Praneeth\u0027s about us section","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":4,"deletions":4}}},{"hash":"cfeeaf6c7cedc7079e71727f41b027e705c3337a","isMergeCommit":true,"messageTitle":"Merge pull request #26 from GeraldFSE/21-add-photo","messageBody":"Add Gerald\u0027s photo","fileTypesAndContributionMap":{}},{"hash":"8a420649a986261be138949d4795c2aa99cf3814","isMergeCommit":true,"messageTitle":"Merge pull request #35 from chausarahnusitems-tech/34-update-about-us","messageBody":"Update Sarah\u0027s About Us","fileTypesAndContributionMap":{}},{"hash":"c86bb2b0d95008e1b476eab39569757638a9cbd1","isMergeCommit":true,"messageTitle":"Merge pull request #36 from RogerZhang888/update-beryl-skills","messageBody":"Update beryl skills","fileTypesAndContributionMap":{}}]},{"date":"2026-10-01T00:00:00","commitResults":[{"hash":"3049167befe491821015a2706685e34de86ae6e4","isMergeCommit":false,"messageTitle":"Add NFRs into the DeveloperGuide","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":36,"deletions":41}}}]}],"GeraldFSE":[{"date":"2026-09-30T00:00:00","commitResults":[{"hash":"93fe4850e70bf96321d4388132a3d4698dee6b56","isMergeCommit":false,"messageTitle":"Update About Us with Gerald\u0027s details","messageBody":"The About Us page still shows a placeholder for one team member.\n\nReplace it with Gerald\u0027s name, photo and GitHub link. Remove the\nhomepage and portfolio links, as neither is needed yet.\n","fileTypesAndContributionMap":{"docs":{"insertions":3,"deletions":4}}},{"hash":"4cb0a55d06227cdd390ee625b789a05fc6ae15db","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into 33-update-developer-guide","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"012a9f11ff19fdef456b34ab278ccb3228bc2606","isMergeCommit":false,"messageTitle":"Update DG user stories for TutorTrack","messageBody":"The Developer Guide still lists AB3\u0027s address-book user stories,\nwhich describe managing generic contacts rather than a private\ntutor\u0027s student roster.\n\nReplace them with TutorTrack\u0027s user stories so the guide records\nthe full requirements of the product:\n\n* must-have stories for the MVP loop of adding, listing, viewing,\n  noting, and deleting students\n* nice-to-have stories for edit, find, undo, and help\n* unlikely stories for sample data, archiving, restoring, and\n  sibling linking, kept to show what was considered but excluded\n\nRemove the \"More to be added\" placeholder, as the list now covers\nall identified requirements.\n","fileTypesAndContributionMap":{"docs":{"insertions":30,"deletions":10}}}]},{"date":"2026-10-01T00:00:00","commitResults":[{"hash":"bb7ffb83fd322e5f7bc9632c8f5ca2c0d52f06dc","isMergeCommit":false,"messageTitle":"Update DG user stories for TutorTrack","messageBody":"The Developer Guide lists AB3\u0027s address-book user stories, which\ndescribe managing generic contacts rather than a private tutor\u0027s\nstudent roster.\n\nThe DG must cover the full requirements of TutorTrack, including\nstories considered but not planned, so readers can see the scope\nof the product and the priority of each feature.\n\nReplace the AB3 stories with TutorTrack\u0027s user stories:\n\n* must-have stories for adding, listing, viewing, noting, and\n  deleting students, plus duplicate checks and saving\n* nice-to-have stories for editing, finding, undo, help, and\n  sample data\n* unlikely stories for archiving, sibling linking, note editing,\n  and multi-computer access, kept to show what was considered\n\nUse one term for each concept, such as roster, student, parent\ncontact, and session note, so that no two stories describe the\nsame thing in different words.\n","fileTypesAndContributionMap":{"docs":{"insertions":43,"deletions":30}}},{"hash":"7cba1d80240d07e4b454323b4d75ebbc7d6152a5","isMergeCommit":false,"messageTitle":"Clarify two DG user stories","messageBody":"Two user stories in the Developer Guide have weak wording. One\nuses the British spelling \"misspelt\", while the rest of the guide\nuses American spelling. Another has a benefit, \"see all my\nstudents again\", that only restates its want of returning to the\nfull roster.\n\nA benefit that repeats its want, and inconsistent spelling, are\nflagged as user story and documentation bugs during grading.\n\nUse the American spelling \"misspelled\", and give the return-to-\nroster story a distinct benefit: selecting any student by their\nroster number again.\n","fileTypesAndContributionMap":{"docs":{"insertions":2,"deletions":2}}},{"hash":"705753c74a38c7a04133a6c3cf821aa9bfe77cc0","isMergeCommit":false,"messageTitle":"Fix stale references to the removed style policy","messageBody":"The Codex shim still points to .beryl/agent/style-policy.md, which\nwas replaced by coding-policy.md, and coding-policy.md is still\ntitled \"Style Policy\".\n\nAgents that follow the Codex shim read a file that does not exist,\nand the policy title does not match how every shim refers to it.\n\nRegenerate the Codex shim from the tool instruction template, and\nretitle the policy \"Coding Policy\" to match its file name.\n","fileTypesAndContributionMap":{"docs":{"insertions":12,"deletions":3}}},{"hash":"0d9be2395faa1ff351c81a59ef4047458bbafd83","isMergeCommit":false,"messageTitle":"Mark Beryl scripts and git hooks as executable","messageBody":"Every Beryl script and git hook is stored without the executable\nbit, so documented commands such as ./.beryl/scripts/check.sh fail\nwith \"Permission denied\", and agent-doctor.sh rejects the install.\n\nSet the executable bit on all Beryl scripts and hooks, so the check\ngate and doctor run as documented on every clone.\n","fileTypesAndContributionMap":{"other":{"insertions":0,"deletions":0}}},{"hash":"da648faf76dc11af9203d57b928e0be633e00e56","isMergeCommit":true,"messageTitle":"Merge pull request #43 from Praneeth-Suresh/NFRs","messageBody":"Add NFRs into the DeveloperGuide","fileTypesAndContributionMap":{}}]}]},"authorFileTypeContributionMap":{"RogerZhang888":{"docs":1351,"functional-code":0,"test-code":0},"chausarahnusitems-tech":{"docs":5,"functional-code":0,"test-code":0},"jiahw4ng":{"docs":24,"functional-code":0,"test-code":0,"other":3},"Praneeth-Suresh":{"docs":3473,"functional-code":0,"test-code":0,"other":3771},"GeraldFSE":{"docs":45,"functional-code":0,"test-code":0}},"authorContributionVariance":{"RogerZhang888":69731.836,"chausarahnusitems-tech":6.6326528,"jiahw4ng":134.31122,"Praneeth-Suresh":3915742.2,"GeraldFSE":663.78064},"authorDisplayNameMap":{"RogerZhang888":"CS2103T-F09-1 ROGE..NHAI","chausarahnusitems-tech":"CS2103T-F09-1 CHAU..ARAH","jiahw4ng":"CS2103T-F09-1 WANG..AHUA","Praneeth-Suresh":"CS2103T-F09-1 PRAN..RESH","GeraldFSE":"CS2103T-F09-1 GERA..O EN"}}
