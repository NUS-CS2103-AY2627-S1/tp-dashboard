:false,"messageTitle":"Add NFRs into the DeveloperGuide","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":36,"deletions":41}}}]},{"date":"2026-10-02T00:00:00","commitResults":[{"hash":"aa1711db10cf86adc1e0402c12593b46e46b4b3c","isMergeCommit":false,"messageTitle":"Fix markdown formatting in DeveloperGuide.md NFRs","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":6,"deletions":12}}},{"hash":"156da7c1e4dd8dddd66955026ce2083cd6bfe370","isMergeCommit":false,"messageTitle":"Simplify Beryl control plane","messageBody":"Remove obsolete bootstrap, initial-build, and lifecycle surfaces.\n\nMake coding-policy.md the agent memory anchor.\n\nRetain the check path.\n\nReconcile instruction and lock inventories.\n","fileTypesAndContributionMap":{"other":{"insertions":3,"deletions":2258},"docs":{"insertions":362,"deletions":3322}}},{"hash":"03861b862d6afdec69792ea8fe477bdb251f54ac","isMergeCommit":false,"messageTitle":"Clarify Javadoc summary conventions","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":11,"deletions":1}}},{"hash":"d1638f605ebe7983d473aeb824af69aa75f51362","isMergeCommit":false,"messageTitle":"Add input resilience guardrails","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":28,"deletions":1}}},{"hash":"5fd36a0f6ee80dbd4a721671d2280be102d87ec1","isMergeCommit":false,"messageTitle":"Add student domain types","messageBody":"Introduce validated student value types and a shared identity rule so future command and storage work apply duplicate detection consistently.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":437,"deletions":0},"docs":{"insertions":8,"deletions":2},"test-code":{"insertions":165,"deletions":0}}},{"hash":"1ea4d666b4a267ae6158ee6daf63293855c0210b","isMergeCommit":false,"messageTitle":"Improve student domain coverage","messageBody":"Cover value-object contracts and validation branches so the Student domain meets the Codecov changed-line coverage gate. Record the coverage preflight in Beryl.\n","fileTypesAndContributionMap":{"docs":{"insertions":4,"deletions":0},"test-code":{"insertions":79,"deletions":0}}},{"hash":"d47a0cb7b96b0a34a1c05cf24aaba419e56018e5","isMergeCommit":false,"messageTitle":"Persist student data","messageBody":"Add JSON adapters that rebuild validated students and apply the shared duplicate identity rule while loading stored roster data.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":176,"deletions":0},"docs":{"insertions":2,"deletions":0},"test-code":{"insertions":109,"deletions":0}}},{"hash":"5352ebdb7c894017edd3d21f9a8173e15a6a4b72","isMergeCommit":false,"messageTitle":"Add student command workflow","messageBody":"Accept tutor-focused student fields through add, preserve legacy person commands, and persist the new student records with duplicate validation.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":176,"deletions":40},"docs":{"insertions":15,"deletions":8},"test-code":{"insertions":36,"deletions":1}}}]}],"GeraldFSE":[{"date":"2026-09-30T00:00:00","commitResults":[{"hash":"93fe4850e70bf96321d4388132a3d4698dee6b56","isMergeCommit":false,"messageTitle":"Update About Us with Gerald\u0027s details","messageBody":"The About Us page still shows a placeholder for one team member.\n\nReplace it with Gerald\u0027s name, photo and GitHub link. Remove the\nhomepage and portfolio links, as neither is needed yet.\n","fileTypesAndContributionMap":{"docs":{"insertions":3,"deletions":4}}},{"hash":"4cb0a55d06227cdd390ee625b789a05fc6ae15db","isMergeCommit":true,"messageTitle":"Merge branch \u0027master\u0027 into 33-update-developer-guide","messageBody":"","fileTypesAndContributionMap":{}},{"hash":"012a9f11ff19fdef456b34ab278ccb3228bc2606","isMergeCommit":false,"messageTitle":"Update DG user stories for TutorTrack","messageBody":"The Developer Guide still lists AB3\u0027s address-book user stories,\nwhich describe managing generic contacts rather than a private\ntutor\u0027s student roster.\n\nReplace them with TutorTrack\u0027s user stories so the guide records\nthe full requirements of the product:\n\n* must-have stories for the MVP loop of adding, listing, viewing,\n  noting, and deleting students\n* nice-to-have stories for edit, find, undo, and help\n* unlikely stories for sample data, archiving, restoring, and\n  sibling linking, kept to show what was considered but excluded\n\nRemove the \"More to be added\" placeholder, as the list now covers\nall identified requirements.\n","fileTypesAndContributionMap":{"docs":{"insertions":30,"deletions":10}}}]},{"date":"2026-10-01T00:00:00","commitResults":[{"hash":"bb7ffb83fd322e5f7bc9632c8f5ca2c0d52f06dc","isMergeCommit":false,"messageTitle":"Update DG user stories for TutorTrack","messageBody":"The Developer Guide lists AB3\u0027s address-book user stories, which\ndescribe managing generic contacts rather than a private tutor\u0027s\nstudent roster.\n\nThe DG must cover the full requirements of TutorTrack, including\nstories considered but not planned, so readers can see the scope\nof the product and the priority of each feature.\n\nReplace the AB3 stories with TutorTrack\u0027s user stories:\n\n* must-have stories for adding, listing, viewing, noting, and\n  deleting students, plus duplicate checks and saving\n* nice-to-have stories for editing, finding, undo, help, and\n  sample data\n* unlikely stories for archiving, sibling linking, note editing,\n  and multi-computer access, kept to show what was considered\n\nUse one term for each concept, such as roster, student, parent\ncontact, and session note, so that no two stories describe the\nsame thing in different words.\n","fileTypesAndContributionMap":{"docs":{"insertions":43,"deletions":30}}},{"hash":"7cba1d80240d07e4b454323b4d75ebbc7d6152a5","isMergeCommit":false,"messageTitle":"Clarify two DG user stories","messageBody":"Two user stories in the Developer Guide have weak wording. One\nuses the British spelling \"misspelt\", while the rest of the guide\nuses American spelling. Another has a benefit, \"see all my\nstudents again\", that only restates its want of returning to the\nfull roster.\n\nA benefit that repeats its want, and inconsistent spelling, are\nflagged as user story and documentation bugs during grading.\n\nUse the American spelling \"misspelled\", and give the return-to-\nroster story a distinct benefit: selecting any student by their\nroster number again.\n","fileTypesAndContributionMap":{"docs":{"insertions":2,"deletions":2}}},{"hash":"705753c74a38c7a04133a6c3cf821aa9bfe77cc0","isMergeCommit":false,"messageTitle":"Fix stale references to the removed style policy","messageBody":"The Codex shim still points to .beryl/agent/style-policy.md, which\nwas replaced by coding-policy.md, and coding-policy.md is still\ntitled \"Style Policy\".\n\nAgents that follow the Codex shim read a file that does not exist,\nand the policy title does not match how every shim refers to it.\n\nRegenerate the Codex shim from the tool instruction template, and\nretitle the policy \"Coding Policy\" to match its file name.\n","fileTypesAndContributionMap":{"docs":{"insertions":12,"deletions":3}}},{"hash":"0d9be2395faa1ff351c81a59ef4047458bbafd83","isMergeCommit":false,"messageTitle":"Mark Beryl scripts and git hooks as executable","messageBody":"Every Beryl script and git hook is stored without the executable\nbit, so documented commands such as ./.beryl/scripts/check.sh fail\nwith \"Permission denied\", and agent-doctor.sh rejects the install.\n\nSet the executable bit on all Beryl scripts and hooks, so the check\ngate and doctor run as documented on every clone.\n","fileTypesAndContributionMap":{"other":{"insertions":0,"deletions":0}}},{"hash":"da648faf76dc11af9203d57b928e0be633e00e56","isMergeCommit":true,"messageTitle":"Merge pull request #43 from Praneeth-Suresh/NFRs","messageBody":"Add NFRs into the DeveloperGuide","fileTypesAndContributionMap":{}},{"hash":"b0582561d0649df030afbc84b513183b805a596f","isMergeCommit":true,"messageTitle":"Merge pull request #47 from chausarahnusitems-tech/update-glossary","messageBody":"updated glossary","fileTypesAndContributionMap":{}}]},{"date":"2026-10-03T00:00:00","commitResults":[{"hash":"7c4bd63e5971c1d2b2ece1c2b1207771af759132","isMergeCommit":true,"messageTitle":"Merge pull request #52 from Praneeth-Suresh/Beryl-cleanup","messageBody":"Beryl cleanup","fileTypesAndContributionMap":{}},{"hash":"c4358d6619c8f1a16fd28f32f159c10a83ae9bfb","isMergeCommit":true,"messageTitle":"Merge pull request #56 from Praneeth-Suresh/53-create-student-types","messageBody":"Add student domain types","fileTypesAndContributionMap":{}},{"hash":"2c1262044d3b8d4a59c18db59681bd37933eb75d","isMergeCommit":true,"messageTitle":"Merge pull request #57 from Praneeth-Suresh/54-persist-student-data","messageBody":"Persist student data","fileTypesAndContributionMap":{}},{"hash":"c4358f7c7f1fae8a40e439df6b8f8b54e5be378f","isMergeCommit":true,"messageTitle":"Merge pull request #58 from Praneeth-Suresh/55-add-student-command","messageBody":"Add student command workflow","fileTypesAndContributionMap":{}},{"hash":"c1d8dd4550b034b802d46e6e6e2d8dbcdb815021","isMergeCommit":true,"messageTitle":"Merge pull request #51 from Praneeth-Suresh/NFRs","messageBody":"Markdown Formatting Fix For NFRs","fileTypesAndContributionMap":{}}]}]},"authorFileTypeContributionMap":{"RogerZhang888":{"docs":870,"functional-code":582,"test-code":716},"chausarahnusitems-tech":{"docs":23,"functional-code":0,"test-code":0},"jiahw4ng":{"docs":24,"functional-code":0,"test-code":0,"other":3},"Praneeth-Suresh":{"docs":1124,"functional-code":784,"test-code":389,"other":1516},"GeraldFSE":{"docs":45,"functional-code":0,"test-code":0}},"authorContributionVariance":{"RogerZhang888":148293.17,"chausarahnusitems-tech":35.764706,"jiahw4ng":112.110725,"Praneeth-Suresh":5779651.5,"GeraldFSE":560.9689},"authorDisplayNameMap":{"RogerZhang888":"CS2103T-F09-1 ROGE..NHAI","chausarahnusitems-tech":"CS2103T-F09-1