ions":0},"test-code":{"insertions":588,"deletions":1}}},{"hash":"c4b9336c920ffc626e671f678f48f9aa32e662aa","isMergeCommit":false,"messageTitle":"Stop tracking anti-slop audit files","messageBody":"","fileTypesAndContributionMap":{"docs":{"insertions":0,"deletions":95}}},{"hash":"e69e657c7535233fcede98a2da59d8a085a545ae","isMergeCommit":false,"messageTitle":"Remove display-dependent EventWorkspaceTest","messageBody":"EventWorkspaceTest starts JavaFX, opens windows, and captures screenshots,\nrequiring a graphical display that the provided Linux CI workflow does\nnot configure. It also exceeded its timeout when run through WSL.\n\nRemove these UI tests to preserve the current CI workflow without adding\nXvfb setup. Existing event parser, command, model, and storage tests remain.\nDevelopers will manually verify event UI behavior when making UI changes.\n","fileTypesAndContributionMap":{"test-code":{"insertions":0,"deletions":200}}},{"hash":"69a9a3ea1e573d42949a1584bc0b6e04a5643797","isMergeCommit":false,"messageTitle":"Improve event storage coverage","messageBody":"Add tests for event storage conversion and validation, including\nmissing fields, invalid event details, duplicate names, null list\nentries, and round-trip preservation of events.\n","fileTypesAndContributionMap":{"test-code":{"insertions":94,"deletions":0}}},{"hash":"684c5223a0912332b70840fad14cd000b18e411d","isMergeCommit":false,"messageTitle":"Fix error message from \"Contact\" to \"Event\"","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":1,"deletions":1}}},{"hash":"2fed5fe5f64b5a539371968a738143f682fbdead","isMergeCommit":false,"messageTitle":"Make event duplicate detection case-insensitive","messageBody":"Treat event names that differ only by case as duplicates, while preserving\nthe capitalization entered by the user for display. This improves the\nuser experience, since a user might not intend case differences to result\nin two distinct events.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":2,"deletions":2},"test-code":{"insertions":34,"deletions":0}}},{"hash":"bab656c011f354bd37366c24f09dfacf5f7f0321","isMergeCommit":false,"messageTitle":"Improve coding standard","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":393,"deletions":211},"test-code":{"insertions":48,"deletions":40}}}]},{"date":"2026-10-06T00:00:00","commitResults":[{"hash":"a3551fef0513017a69b9a0eb2ca15e9b12ccb281","isMergeCommit":false,"messageTitle":"Fix checkstyle problems","messageBody":"","fileTypesAndContributionMap":{"test-code":{"insertions":3,"deletions":3}}},{"hash":"79f5578138837dd91b4b82e423e7e7062d3cdf79","isMergeCommit":true,"messageTitle":"Merge pull request #53 from yuanshengbronze/add-event","messageBody":"Add event management to CoordiMate","fileTypesAndContributionMap":{}},{"hash":"0c2e064d0cc57d3a9178a82197bf352077ff2773","isMergeCommit":false,"messageTitle":"Add editevent command","messageBody":"Events cannot be changed after creation, making corrections difficult.\n\nAdd editevent to update an event’s name, start time, or end time while\nretaining omitted fields. Match names without regard to case and reject\nduplicate names or invalid time ranges.\n\nSave edits through the existing persistence flow so a failed save leaves\nthe event unchanged. Document the command and cover parsing, behavior,\nand integration with tests.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":41,"deletions":4},"docs":{"insertions":39,"deletions":1},"test-code":{"insertions":5,"deletions":0}}},{"hash":"d91dd7d90a258225d26812907210f81b6e6a1d3d","isMergeCommit":false,"messageTitle":"Add unversioned files","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":173,"deletions":0},"test-code":{"insertions":281,"deletions":0}}}]},{"date":"2026-10-07T00:00:00","commitResults":[{"hash":"e31795425f31068a247e438ab142a350f5f995f4","isMergeCommit":false,"messageTitle":"Fix unknown param err