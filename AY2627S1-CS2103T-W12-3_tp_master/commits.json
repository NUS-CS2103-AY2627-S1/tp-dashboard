","isMergeCommit":false,"messageTitle":"Fix filter quote parsing and add organisation filter","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":22,"deletions":3},"test-code":{"insertions":47,"deletions":2}}}]},{"date":"2026-10-11T00:00:00","commitResults":[{"hash":"0072fc5d8c65833501952c081dbf39a384392abf","isMergeCommit":false,"messageTitle":"Reject unclosed quotation marks in filter","messageBody":"","fileTypesAndContributionMap":{"functional-code":{"insertions":4,"deletions":0},"test-code":{"insertions":10,"deletions":0}}}]},{"date":"2026-10-12T00:00:00","commitResults":[{"hash":"44ae50cc8fc8d0b177941c8522af31125663a312","isMergeCommit":false,"messageTitle":"Allow unclosed quotation marks in filter values","messageBody":"Event names may contain an unclosed quotation mark, such as \"Cali, but\nfilter rejected any command with one, so those events could not be\nfiltered.\n\nKeep an unclosed quotation mark as part of the value when no field\nfollows it. Still reject it when a field follows, since it is then\nunclear where the value ends.\n\nCo-Authored-By: Claude Opus 5.5 \u003cnoreply@anthropic.com\u003e\n","fileTypesAndContributionMap":{"functional-code":{"insertions":13,"deletions":1},"test-code":{"insertions":15,"deletions":4}}}]},{"date":"2026-10-14T00:00:00","commitResults":[{"hash":"fa0fa043ce34295ada20bbc32a621537f481d374","isMergeCommit":false,"messageTitle":"Make search match organisation","messageBody":"search matched a contact\u0027s name, phone, email and address only, so a\ncontact could not be found by its organisation.\n\nMatch the keyword against organisation as a case-insensitive substring,\nthe same way as the other fields. Update the usage message and User\nGuide to list it.\n","fileTypesAndContributionMap":{"functional-code":{"insertions":13,"deletions":9},"docs":{"insertions":3,"deletions":2},"test-code":{"insertions":21,"deletions":2}}}]}],"yuanshengbronze":[{"date":"2026-09-28T00:00:00","commitResults":[{"hash":"